---
interface Props {
  caption?: string;
  align?: 'start' | 'center';
  compact?: boolean;
  /**
   * `mockup` flags the figure as a placeholder UI rendering awaiting a real
   * screenshot. Visually adds a small "MOCKUP" eyebrow in the top-right
   * corner so contributors can spot replacement targets at a glance.
   */
  kind?: 'diagram' | 'mockup';
}

const { caption, align = 'center', compact = false, kind = 'diagram' } = Astro.props;
---

<figure class:list={["diagram-figure", `diagram-figure--${align}`, compact && "diagram-figure--compact", kind === 'mockup' && "diagram-figure--mockup", Astro.slots.has('mobile-fallback') && "diagram-figure--has-fallback"]}>
  <div
    class="diagram-figure-surface diagram-figure-surface--svg"
    data-scroll-label={caption ? `${caption} (scrollable diagram)` : 'Diagram, scrollable'}
  >
    {kind === 'mockup' && <span class="diagram-figure-mockup-tag" aria-hidden="true">Mockup</span>}
    <slot />
  </div>
  {Astro.slots.has('mobile-fallback') && (
    <div class="diagram-figure-surface diagram-figure-surface--fallback">
      <slot name="mobile-fallback" />
    </div>
  )}
  {caption && <figcaption class="diagram-figure-caption">{caption}</figcaption>}
</figure>

<script>
  // Below 640px the SVG surface scrolls horizontally (see the "Mobile
  // rescue" rule in the <style> block). A scrollable region with no
  // focusable content can't be reached from the keyboard, so we toggle a
  // tab stop on/off depending on whether the surface actually overflows —
  // CSS alone can't express "tabindex only when scrolling". `role="region"`
  // and `aria-label` are toggled in lockstep with `tabindex`: a landmark is
  // only correct while the surface is actually a scroll container, and a
  // static role/label at desktop width (where nothing scrolls) would both
  // mis-describe the element and add a needless region landmark per
  // diagram to the a11y tree. The label text itself is static (carried in
  // `data-scroll-label`, set from the `caption`/fallback in the markup
  // above) since deriving it needs the component's props, not just the DOM.
  //
  // This script is a bundled module, so Astro executes it exactly once for
  // the whole site (not once per DiagramFigure instance, not once per page
  // navigation) — see https://docs.astro.build/en/guides/view-transitions/#script-re-execution.
  // That single run is enough: it wires a resize listener and an
  // `astro:page-load` listener that both re-scan every
  // `.diagram-figure-surface--svg` currently in the document, so no extra
  // once-per-navigation guard is needed here.
  function evaluateDiagramSurfaces() {
    document.querySelectorAll<HTMLElement>('.diagram-figure-surface--svg').forEach((surface) => {
      if (surface.scrollWidth > surface.clientWidth) {
        surface.setAttribute('tabindex', '0');
        surface.setAttribute('role', 'region');
        const label = surface.dataset.scrollLabel;
        if (label) surface.setAttribute('aria-label', label);
      } else {
        surface.removeAttribute('tabindex');
        surface.removeAttribute('role');
        surface.removeAttribute('aria-label');
      }
    });
  }

  let resizeTimer: ReturnType<typeof setTimeout>;
  function scheduleEvaluate() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(evaluateDiagramSurfaces, 150);
  }

  evaluateDiagramSurfaces();
  window.addEventListener('resize', scheduleEvaluate);
  document.addEventListener('astro:page-load', evaluateDiagramSurfaces);
</script>

<style>
  .diagram-figure {
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .diagram-figure--start { align-items: flex-start; }
  .diagram-figure--center { align-items: stretch; }

  .diagram-figure-surface {
    width: 100%;
    padding: 1.5rem 1.25rem;
    background:
      radial-gradient(
        ellipse at top,
        color-mix(in srgb, var(--ui-color-primary) 6%, transparent),
        transparent 60%
      ),
      var(--ui-color-surface-raised);
    border: 1px solid var(--ui-color-border);
    border-radius: var(--ui-radius-lg);
    overflow: hidden;
    position: relative;
  }

  .diagram-figure--compact .diagram-figure-surface {
    padding: 1rem;
  }

  .diagram-figure-surface :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    max-width: 100%;
  }

  /* Visible focus ring for the scrollable SVG surface — only relevant once
   * the script above gives it a tab stop (i.e. it actually overflows).
   * `mask-image` (below, ≤640px) clips anything the element paints outside
   * its own border box — including an outer box-shadow — because the mask's
   * painting area is the border box by definition. Without lifting the mask
   * on focus, the ring would be entirely invisible exactly where it matters
   * (mobile, where the tab stop is added). The scroll-fade hint is a nicety;
   * WCAG 2.4.7 visible-focus is not, so it wins while focused. */
  .diagram-figure-surface--svg:focus-visible {
    outline: none;
    -webkit-mask-image: none;
    mask-image: none;
    box-shadow: var(--ui-focus-ring);
  }

  /* Mockup eyebrow — small italic flag in the top-right corner. */
  .diagram-figure-mockup-tag {
    position: absolute;
    top: 0.55rem;
    right: 0.7rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ui-color-text-muted);
    background: var(--ui-color-surface-sunken);
    border: 1px solid var(--ui-color-border);
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    font-style: italic;
    pointer-events: none;
  }

  /* Mobile rescue: SVG labels declared at small font-size attributes shrink
   * proportionally with the diagram width and become unreadable on phones.
   * Below 640px we let the surface scroll horizontally and force a minimum
   * SVG width that keeps the labels at human-readable sizes. The mask fades
   * the right edge to hint at scrollable content. */
  @media (max-width: 640px) {
    .diagram-figure-surface--svg {
      overflow-x: auto;
      -webkit-mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
      mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
    }
    .diagram-figure-surface--svg :global(svg) {
      min-width: 600px;
      max-width: none;
    }
  }

  /* When a `mobile-fallback` slot is provided, the SVG surface gives way
   * to the stacked HTML alternative below 640px — densely-overlapping
   * diagrams (Venns, multi-panel sequences) can't be salvaged by scroll
   * alone. The fallback is hidden on desktop so AT only sees one. */
  .diagram-figure-surface--fallback { display: none; }
  @media (max-width: 640px) {
    .diagram-figure--has-fallback .diagram-figure-surface--svg { display: none; }
    .diagram-figure--has-fallback .diagram-figure-surface--fallback { display: block; }
  }
  .diagram-figure-surface--fallback {
    padding: 1.25rem 1.1rem;
  }

  .diagram-figure-caption {
    font-size: 0.78rem;
    color: var(--ui-color-text-muted);
    line-height: 1.45;
    padding: 0 0.25rem;
    text-align: center;
  }

  .diagram-figure--start .diagram-figure-caption {
    text-align: left;
  }

  /* Shared SVG typographic defaults so all diagrams look consistent */
  .diagram-figure-surface :global(svg text) {
    font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
    fill: var(--ui-color-text);
  }

  .diagram-figure-surface :global(svg text.diagram-mono) {
    font-family: var(--font-mono), ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .diagram-figure-surface :global(svg text.diagram-muted) {
    fill: var(--ui-color-text-muted);
  }

  .diagram-figure-surface :global(svg text.diagram-eyebrow) {
    fill: var(--ui-color-text-muted);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .diagram-figure-surface :global(svg .diagram-node) {
    fill: var(--ui-color-surface);
    stroke: var(--ui-color-border);
    stroke-width: 1.25;
  }

  .diagram-figure-surface :global(svg .diagram-node--accent) {
    fill: color-mix(in srgb, var(--ui-color-primary) 10%, var(--ui-color-surface));
    stroke: var(--ui-color-primary);
    stroke-width: 1.5;
  }

  .diagram-figure-surface :global(svg .diagram-connector) {
    fill: none;
    stroke: var(--ui-color-border-hover);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .diagram-figure-surface :global(svg .diagram-connector--accent) {
    stroke: var(--ui-color-primary);
    stroke-width: 2;
  }

  /* Dashed connector is used for feedback loops — needs to read as
     "alternative path" at a glance, not fade into the background. */
  .diagram-figure-surface :global(svg .diagram-connector--dashed) {
    stroke: color-mix(in srgb, var(--ui-color-primary) 55%, var(--ui-color-border-hover));
    stroke-dasharray: 5 5;
    stroke-width: 1.75;
  }

  .diagram-figure-surface :global(svg .diagram-arrow) {
    fill: var(--ui-color-border-hover);
  }

  .diagram-figure-surface :global(svg .diagram-arrow--accent) {
    fill: var(--ui-color-primary);
  }

  .diagram-figure-surface :global(svg .diagram-arrow--muted-accent) {
    fill: color-mix(in srgb, var(--ui-color-primary) 55%, var(--ui-color-border-hover));
  }

  .diagram-figure-surface :global(svg .diagram-icon) {
    fill: none;
    stroke: var(--ui-color-primary);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
