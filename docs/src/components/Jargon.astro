---
import { GLOSSARY } from '../data/glossary';

interface Props {
  term: string;
}

const { term } = Astro.props;
const entry = GLOSSARY[term];

// If the slot is empty the visible label falls back to the term itself.
const hasSlot = Astro.slots.has('default');
---

<span class="jargon" tabindex="0" role="button" aria-describedby={entry ? `jg-${term.replace(/\s+/g, '-')}` : undefined}>
  {hasSlot ? <slot /> : term}
  {entry && (
    <span class="jargon-popup" id={`jg-${term.replace(/\s+/g, '-')}`} role="tooltip">
      <strong class="jargon-term">{term}</strong>
      <span class="jargon-def">{entry.definition}</span>
      {entry.hint && <span class="jargon-hint">{entry.hint}</span>}
    </span>
  )}
</span>

<style>
  .jargon {
    position: relative;
    /* Keep the trigger as one unbroken inline box. Without this, a
       multi-word term that lands on a line break gets fragmented into two
       boxes, and the browser anchors the absolutely positioned popup to
       whichever fragment it picks — which can sit near the column's right
       edge and push the centered popup past the viewport (only reproduces
       with specific text + column width, e.g. "design tokens" on /figma at
       1024px). Disallowing the internal wrap removes the fragmentation
       instead of chasing each width where it shows up. */
    white-space: nowrap;
    border-bottom: 1px dotted var(--ui-color-primary);
    cursor: help;
    outline: none;
    color: inherit;
    font-variant-numeric: inherit;
  }

  .jargon:focus-visible {
    outline: 2px solid var(--ui-color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .jargon-popup {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translateX(-50%) translateY(4px);
    width: max-content;
    max-width: min(320px, calc(100vw - 2rem));
    padding: 0.7rem 0.9rem;
    background: var(--ui-color-surface-raised);
    color: var(--ui-color-text);
    border: 1px solid var(--ui-color-border);
    border-radius: var(--ui-radius-md);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    white-space: normal;
    letter-spacing: 0;
    opacity: 0;
    pointer-events: none;
    /* Closed = display: none, not just opacity: 0 — an absolutely positioned
       box still occupies its calculated position (and can stick out past the
       viewport) even at opacity 0, which was inflating the scrollable
       overflow of `.docs-main-content`. `display` participates in the
       transition (allow-discrete) so browsers that support it still animate
       the open/close; browsers that don't just show/hide instantly, which is
       an acceptable degrade. */
    display: none;
    transition:
      opacity var(--ui-transition-fast),
      transform var(--ui-transition-fast),
      display var(--ui-transition-fast) allow-discrete;
    z-index: 50;
    flex-direction: column;
    gap: 0.35rem;
  }

  @starting-style {
    .jargon:hover .jargon-popup,
    .jargon:focus .jargon-popup,
    .jargon:focus-within .jargon-popup {
      opacity: 0;
      transform: translateX(-50%) translateY(4px);
    }
  }

  /* Little triangle pointer */
  .jargon-popup::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--ui-color-border);
  }

  .jargon:hover .jargon-popup,
  .jargon:focus .jargon-popup,
  .jargon:focus-within .jargon-popup {
    display: flex;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .jargon-term {
    font-weight: 700;
    color: var(--ui-color-primary);
    font-size: 0.78rem;
  }

  .jargon-def {
    display: block;
    color: var(--ui-color-text);
  }

  .jargon-hint {
    display: block;
    color: var(--ui-color-text-muted);
    font-size: 0.72rem;
    padding-top: 0.3rem;
    border-top: 1px solid var(--ui-color-border);
  }

  /* Below 520px, anchor the popup to the viewport instead of the trigger, as
     a fixed bottom sheet. Left-aligning to the trigger (the previous
     approach) still let the popup's fixed width run past the right edge for
     terms sitting in the right half of the line; anchoring to the viewport's
     own edges guarantees it fits regardless of where the term sits. */
  @media (max-width: 520px) {
    .jargon-popup {
      position: fixed;
      left: 1rem;
      right: 1rem;
      /* Clear the mobile bottom tab bar (.docs-bottom-nav, ~60px, z-index:
         90) instead of sitting behind/under it. */
      bottom: calc(60px + 1rem);
      top: auto;
      width: auto;
      max-width: none;
      transform: translateY(12px);
      z-index: 95;
    }
    .jargon:hover .jargon-popup,
    .jargon:focus .jargon-popup,
    .jargon:focus-within .jargon-popup {
      transform: translateY(0);
    }
    @starting-style {
      .jargon:hover .jargon-popup,
      .jargon:focus .jargon-popup,
      .jargon:focus-within .jargon-popup {
        transform: translateY(12px);
      }
    }
    .jargon-popup::after {
      display: none;
    }
  }
</style>
