---
/**
 * Maintainer-only content (owner decision 2026-10-10). The slot renders in
 * `astro dev` (`nx serve docs`) and is absent from the production build, so
 * the deployed site, its sitemap, search index and llms output never carry it.
 * In dev it sits in a labelled frame, so an author sees what will be hidden.
 * Whole pages use a different mechanism: see docs/integrations/maintainer-pages.mjs.
 */
interface Props {
  /** What this block is, shown in the frame label. */
  label?: string;
}

const { label = 'Maintainer · local only' } = Astro.props;
const show = import.meta.env.DEV;
---

{show && <div class="docs-maintainer-only" role="group" aria-label={label}>
  <p class="docs-maintainer-only-label">{label}</p>
  <slot />
</div>}

<style>
  .docs-maintainer-only {
    margin: 2rem 0;
    padding: 0 1.125rem 0.5rem;
    border: 1px dashed var(--ui-color-warning);
    border-radius: var(--ui-radius-md);
  }

  .docs-maintainer-only-label {
    display: inline-block;
    margin: 0 0 1rem;
    padding: 0.25rem 0.75rem;
    background: var(--ui-color-warning-bg);
    color: var(--ui-color-warning-text);
    border: 1px dashed var(--ui-color-warning);
    border-top: 0;
    border-radius: 0 0 var(--ui-radius-md) var(--ui-radius-md);
    font-size: var(--ui-font-size-sm);
    font-weight: 600;
  }
</style>
