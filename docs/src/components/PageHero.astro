---
import PageMeta from './PageMeta.astro';

interface Props {
  /** Optional time estimate, e.g. "~30 min". */
  time?: string;
  /** Short modifier shown in the meta line. Step N of 7 is derived, not passed. */
  tag?: string;
  title: string;
  /**
   * Optional keyword within `title` to render as the serif-italic signature
   * accent. Must be an exact substring of `title`; the first match is wrapped.
   * Keep it to one keyword. Omit for a plain heading.
   */
  titleAccent?: string;
  /** Plain-text lede. For rich markup, use the default slot instead. */
  lede?: string;
  /** Max-width on the lede paragraph. Defaults to a comfortable 36rem. */
  ledeMax?: string;
}

const { time, tag, title, titleAccent, lede, ledeMax = '36rem' } = Astro.props;

const hasLedeSlot = Astro.slots.has('default');
const accentAt = titleAccent ? title.indexOf(titleAccent) : -1;
---

<header class="docs-page-hero">
  <h1 class="docs-page-h1">
    {accentAt === -1 ? (
      title
    ) : (
      <Fragment
        >{title.slice(0, accentAt)}<em class="docs-accent">{titleAccent}</em
        >{title.slice(accentAt + titleAccent!.length)}</Fragment
      >
    )}
  </h1>
  {(lede || hasLedeSlot) && <p
    class="docs-page-hero-lede"
    style={`max-width: ${ledeMax}`}
  >
    {lede ?? <slot />}
  </p>}
  <PageMeta time={time} tag={tag} />
</header>

<style>
  .docs-page-hero {
    margin-bottom: 2.5rem;
  }

  .docs-page-hero-lede {
    font-size: var(--ui-font-size-md);
    color: var(--ui-color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .docs-page-hero-lede :global(strong) {
    color: var(--ui-color-text);
  }

  .docs-page-hero-lede :global(code) {
    font-family: var(
      --font-mono,
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace
    );
    font-size: 0.85em;
    color: var(--ui-color-primary);
    background: var(--ui-color-primary-light);
    padding: 0.05em 0.4em;
    border-radius: var(--ui-radius-sm);
  }
</style>
