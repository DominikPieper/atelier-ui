        <nav class="docs-bottom-nav" aria-label="Quick links">
          <a
            href="/workshop"
            class={`docs-bottom-nav-item${isOnWorkshopTrack ? ' active' : ''}`}
          >
            <Icon name="build_circle" class="docs-bottom-nav-icon" />
            <span class="docs-bottom-nav-label">Workshop</span>
          </a>
          <a
            href="/storybook"
            class={`docs-bottom-nav-item${isStorybook ? ' active' : ''}`}
          >
            <Icon name="book" class="docs-bottom-nav-icon" />
            <span class="docs-bottom-nav-label">Storybook</span>
          </a>
          <a
            href="/figma"
            class={`docs-bottom-nav-item${isFigma ? ' active' : ''}`}
          >
            <Icon name="palette" class="docs-bottom-nav-icon" />
            <span class="docs-bottom-nav-label">Figma workflow</span>
          </a>
          <a
            href="/mcp"
            class={`docs-bottom-nav-item${isMcp ? ' active' : ''}`}
          >
            <Icon name="smart_toy" class="docs-bottom-nav-icon" />
            <span class="docs-bottom-nav-label">MCP</span>
