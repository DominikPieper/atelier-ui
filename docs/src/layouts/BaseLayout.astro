    <!-- Scroll to top button -->
    <button class="docs-scroll-top" id="scroll-top" aria-label="Scroll to top">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <polyline points="18 15 12 9 6 15" />
      </svg>
    </button>

    <script is:inline>
      // ── Re-runs on every page load (initial + Astro View Transitions) ──
      function bindOnce(el, event, handler) {
        // ClientRouter swaps <body>, re-executing this inline script. Without a
        // guard, every navigation stacks another listener on the same element,
        // and on first paint initPage() runs twice (direct call + astro:page-load),
        // so each click toggles open/close → mobile nav appears dead. WHY: shared
        // doc-level listeners accumulate; per-element data-attr is the simplest dedupe.
        if (!el) return;
        const key = 'bound_' + event;
        if (el.dataset[key]) return;
        el.dataset[key] = '1';
        el.addEventListener(event, handler);
      }

      function initPage() {
        // Theme toggle
        const themeBtn = document.getElementById('theme-btn');
        const moonIcon = document.getElementById('theme-icon-moon');
        const sunIcon = document.getElementById('theme-icon-sun');

        function updateThemeIcon() {
          const theme = document.documentElement.getAttribute('data-theme');
          if (moonIcon && sunIcon) {
            moonIcon.style.display = theme === 'dark' ? 'block' : 'none';
            sunIcon.style.display = theme === 'dark' ? 'none' : 'block';
          }
          if (themeBtn) {
            themeBtn.setAttribute(
              'aria-pressed',
              theme === 'dark' ? 'true' : 'false',
            );
          }
        }

        updateThemeIcon();

        bindOnce(themeBtn, 'click', function () {
          const current = document.documentElement.getAttribute('data-theme');
          const next = current === 'dark' ? 'light' : 'dark';

          function apply() {
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('docs-theme', next);
            updateThemeIcon();
          }

          // Animate the swap as a circle expanding from the toggle button
          // using the View Transitions API. Falls back to an instant swap
          // when the browser doesn't support it (Firefox today) or when the
          // user prefers reduced motion.
          const prefersReduce = window.matchMedia(
            '(prefers-reduced-motion: reduce)',
          ).matches;
          if (!document.startViewTransition || prefersReduce) {
            apply();
            return;
          }

          const rect = themeBtn.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          // Furthest viewport corner from the click → reveal radius.
          const radius = Math.hypot(
            Math.max(cx, window.innerWidth - cx),
            Math.max(cy, window.innerHeight - cy),
          );
          const root = document.documentElement;
          root.style.setProperty('--theme-x', cx + 'px');
          root.style.setProperty('--theme-y', cy + 'px');
          root.style.setProperty('--theme-r', radius + 'px');
          // The "incoming" theme reveals over the "outgoing" theme.
          // 'dark' here is the value AFTER apply(), so the class on <html>
          // tells the keyframe whether to expand the dark or light circle.
          root.classList.add('docs-theme-transitioning');
          root.classList.toggle(
            'docs-theme-transitioning--to-dark',
            next === 'dark',
          );
          root.classList.toggle(
            'docs-theme-transitioning--to-light',
            next === 'light',
          );

          const transition = document.startViewTransition(apply);
          // Rapid double-clicks skip the in-flight transition with an
          // AbortError on `.finished`. That's expected; swallow it so the
          // browser console stays clean. `finally` still runs on rejection.
          transition.finished
            .catch(function () {
              // expected AbortError, see above
            })
            .finally(function () {
              root.classList.remove('docs-theme-transitioning');
              root.classList.remove('docs-theme-transitioning--to-dark');
              root.classList.remove('docs-theme-transitioning--to-light');
            });
        });

        // ── Mobile sidebar (drawer) ──────────────────────────────────────────
        // The sidebar is the SAME node on desktop (sticky, always visible) and
        // mobile (off-canvas drawer). So focus-trap / Escape / inert apply ONLY
        // below the 768px breakpoint — on desktop the drawer concept doesn't
        // exist and we must never make the sidebar inert or steal focus.
        const menuBtn = document.getElementById('menu-btn');
        const sidebar = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        const mainEl = document.getElementById('main');
        const footerEl = document.querySelector('.docs-footer');
        const mobileMq = window.matchMedia('(max-width: 768px)');

        // A fresh page load (initial, or a ClientRouter swap after tapping a
        // sidebar link while the drawer was open) never starts with the drawer
        // open. ClientRouter replaces <head>/<body> but NOT <html> itself, so
        // the body-scroll-lock class from a page navigated away from — via a
        // real link click, not Escape/backdrop/close-button — would otherwise
        // survive onto this page and leave scrolling locked forever. main/
        // footer/sidebar are fresh body nodes on every navigation and are
        // never inert by default, so only the <html> class needs resetting.
        document.documentElement.classList.remove('docs-drawer-open');

        function isMobile() {
          return mobileMq.matches;
        }

        // `inert` (Baseline 2023; all evergreen browsers) removes the closed
        // drawer's links from the tab order and the a11y tree in one attribute —
        // no manual tabindex bookkeeping. We only set it on mobile; on desktop
        // the attribute is always cleared so the sticky sidebar stays reachable.
        function syncInert() {
          if (!sidebar) return;
          const hidden =
            isMobile() && !sidebar.classList.contains('docs-sidebar--open');
          if (hidden) sidebar.setAttribute('inert', '');
          else sidebar.removeAttribute('inert');
        }

        function getFocusable() {
          if (!sidebar) return [];
          return Array.prototype.slice
            .call(
              sidebar.querySelectorAll(
                'a[href], button:not([disabled]), summary',
              ),
            )
            .filter(function (el) {
              // checkVisibility() also drops links inside a closed <details>
              // (content-visibility: hidden), which offsetParent does not;
              // focus() on those is a silent no-op and would stall the trap.
              return el.checkVisibility
                ? el.checkVisibility({ visibilityProperty: true })
                : el.offsetParent !== null;
            });
        }

        // Lock the page behind the open drawer: body-scroll lock (CSS class on
        // <html>) plus `inert` on main/footer, so touch scroll and
        // screen-reader browse mode can't reach content the drawer covers.
        // Mirrors the sidebar's own inert toggle in syncInert() above.
        function lockPageForDrawer() {
          document.documentElement.classList.add('docs-drawer-open');
          if (mainEl) mainEl.setAttribute('inert', '');
          if (footerEl) footerEl.setAttribute('inert', '');
        }

        function unlockPageForDrawer() {
          document.documentElement.classList.remove('docs-drawer-open');
          if (mainEl) mainEl.removeAttribute('inert');
          if (footerEl) footerEl.removeAttribute('inert');
        }

        function openSidebar() {
          if (sidebar && backdrop && menuBtn) {
            // The WIP banner sits in normal flow above the sticky topbar, so
            // the topbar's bottom edge (not just its own height) is where the
            // drawer must start. Read live and cache on the sidebar itself —
            // body scroll is locked below, so the banner can't move underneath
            // the drawer while it's open, but its own height keeps shifting
            // the topbar off-screen as the page scrolls.
            const topbar = document.querySelector('.docs-topbar');
            if (topbar) {
              sidebar.style.setProperty(
                '--docs-drawer-top',
                topbar.getBoundingClientRect().bottom + 'px',
              );
            }
            sidebar.classList.add('docs-sidebar--open');
            backdrop.classList.add('docs-sidebar-backdrop--visible');
            menuBtn.classList.add('docs-menu-btn--open');
            menuBtn.setAttribute('aria-expanded', 'true');
            syncInert();
            if (isMobile()) lockPageForDrawer();
            // Move focus into the drawer so keyboard/SR users land inside it.
            if (isMobile()) {
              const first = getFocusable()[0];
              if (first) first.focus();
            }
          }
        }

        function closeSidebar() {
          if (sidebar && backdrop && menuBtn) {
            const wasOpen = sidebar.classList.contains('docs-sidebar--open');
            sidebar.classList.remove('docs-sidebar--open');
            sidebar.style.removeProperty('--docs-drawer-top');
            backdrop.classList.remove('docs-sidebar-backdrop--visible');
            menuBtn.classList.remove('docs-menu-btn--open');
            menuBtn.setAttribute('aria-expanded', 'false');
            syncInert();
            unlockPageForDrawer();
            // Restore focus to the toggle that opened the drawer.
            if (wasOpen && isMobile()) menuBtn.focus();
          }
        }

        bindOnce(menuBtn, 'click', function () {
          if (sidebar && sidebar.classList.contains('docs-sidebar--open')) {
            closeSidebar();
          } else {
            openSidebar();
          }
        });

        bindOnce(backdrop, 'click', closeSidebar);

        // Escape closes the drawer; Tab is trapped while open (mobile). The
        // hamburger (now an X) is the only close control, so it is part of the
        // focus cycle: [menu button, ...drawer focusables]. Bound on both the
        // sidebar and the button, since the button sits outside the sidebar.
        function onDrawerKeydown(e) {
          if (!isMobile() || !sidebar.classList.contains('docs-sidebar--open'))
            return;
          if (e.key === 'Escape') {
            e.preventDefault();
            closeSidebar();
            return;
          }
          if (e.key !== 'Tab') return;
          // Explicit next/prev with wrap: the DOM between the button and the
          // sidebar holds other topbar controls that must not leak into the
          // cycle, so native tab order is not relied on.
          const cycle = [menuBtn].concat(getFocusable());
          const i = cycle.indexOf(document.activeElement);
          if (i === -1) return;
          e.preventDefault();
          const step = e.shiftKey ? -1 : 1;
          // Skip any target that refuses focus, so the trap can never stall.
          for (let n = 1; n < cycle.length; n++) {
            cycle[(i + step * n + cycle.length * n) % cycle.length].focus();
            if (document.activeElement !== cycle[i]) break;
          }
        }
        bindOnce(sidebar, 'keydown', onDrawerKeydown);
        bindOnce(menuBtn, 'keydown', onDrawerKeydown);

        // Keep inert correct across rotation / resize across the breakpoint
        // (e.g. desktop→mobile must hide a non-open drawer; mobile→desktop must
        // un-hide it). Listener is registered once per window.
        if (!window.__atelierDrawerMqBound) {
          window.__atelierDrawerMqBound = true;
          mobileMq.addEventListener('change', function () {
            const sb = document.getElementById('sidebar');
            if (!sb) return;
            const hidden =
              mobileMq.matches && !sb.classList.contains('docs-sidebar--open');
            if (hidden) sb.setAttribute('inert', '');
            else sb.removeAttribute('inert');
            // Crossing up past the breakpoint force-closes the drawer concept
            // entirely (CSS no longer positions it as an overlay) — the page
            // lock and its geometry override must not survive into desktop,
            // even if the drawer was open at the moment of the resize.
            if (!mobileMq.matches) {
              document.documentElement.classList.remove('docs-drawer-open');
              sb.style.removeProperty('--docs-drawer-top');
              const m = document.getElementById('main');
              const f = document.querySelector('.docs-footer');
              if (m) m.removeAttribute('inert');
              if (f) f.removeAttribute('inert');
            }
          });
        }

        // Set the initial inert state for the current viewport on every page load.
        syncInert();

        // Scroll to top button + top progress bar.
        //
        // The WINDOW is the scroll container, never `.docs-main`: `.docs-shell`
        // is `min-height: 100vh` with a `1fr` content row, so the row grows to
        // the content and main cannot overflow. This used to bind `scroll` on
        // `.docs-main` — an element that never scrolls — so the progress bar sat
        // at 0% and the button never appeared, and the `window` fallback below
        // was unreachable because `mainEl` always exists (ADR-0087).
        //
        // One window listener for the life of the document. It resolves its two
        // targets by id on every call rather than closing over them: ClientRouter
        // swaps <body>, and a captured node would keep being updated after the
        // navigation that detached it.
        function handleScroll() {
          const scrollTopBtn = document.getElementById('scroll-top');
          const progressBar = document.getElementById('scroll-progress');
          const scrollY = window.scrollY;
          if (scrollTopBtn) {
            scrollTopBtn.classList.toggle(
              'docs-scroll-top--visible',
              scrollY > 400,
            );
          }
          if (progressBar) {
            const max =
              document.documentElement.scrollHeight - window.innerHeight;
            const pct =
              max > 0 ? Math.min(100, Math.max(0, (scrollY / max) * 100)) : 0;
            progressBar.style.width = pct + '%';
          }
        }

        if (!window.__atelierScrollBound) {
          window.__atelierScrollBound = true;
          window.addEventListener('scroll', handleScroll, { passive: true });
        }

        // Run once on every page load so the progress bar resets to the correct
        // width for the new page (ClientRouter keeps the body around).
        handleScroll();

        bindOnce(document.getElementById('scroll-top'), 'click', function () {
          const prefersReduce = window.matchMedia(
            '(prefers-reduced-motion: reduce)',
          ).matches;
          window.scrollTo({
            top: 0,
            behavior: prefersReduce ? 'auto' : 'smooth',
          });
        });

        // Mark every nav link with `.active` as the current page so screen
        // readers announce "current page" instead of just "link". The .active
        // class is set per-link via SSR; we mirror it to aria-current here so
        // every nav surface (topbar, sidebar, bottom-nav) stays consistent.
        Array.prototype.forEach.call(
          document.querySelectorAll(
            '.docs-topbar-link.active, .docs-nav-link.active, .docs-bottom-nav-item.active',
          ),
          function (el) {
            el.setAttribute('aria-current', 'page');
          },
        );
        Array.prototype.forEach.call(
          document.querySelectorAll(
            '.docs-topbar-link, .docs-nav-link, .docs-bottom-nav-item',
          ),
          function (el) {
            if (!el.classList.contains('active'))
              el.removeAttribute('aria-current');
          },
        );

        // A client-side navigation lands on a freshly rendered sidebar whose
        // groups are already open where they hold the active page; this keeps
        // that true if the sidebar DOM was ever reused (and for the initial load).
        Array.prototype.forEach.call(
          document.querySelectorAll('.docs-nav-link.active'),
          function (el) {
            const group = el.closest('details.docs-nav-group');
            if (group) group.open = true;
          },
        );

        // axe-core flags scrollable <pre> blocks as not keyboard-focusable.
        // Add tabindex=0 so keyboard users can scroll horizontally through long
        // code lines. WCAG 2.1.1. Catches astro-expressive-code, the preflight
        // mockup, and any inline-styled <pre overflow:auto> in React islands
        // (e.g. McpExplorer renders pre blocks for tool responses).
        Array.prototype.forEach.call(
          document.querySelectorAll('pre'),
          function (pre) {
            if (pre.hasAttribute('tabindex')) return;
            const overflow =
              (pre.style.overflow || pre.style.overflowX || '') +
              ' ' +
              (getComputedStyle(pre).overflow || '') +
              ' ' +
              (getComputedStyle(pre).overflowX || '');
            if (
              overflow.indexOf('auto') !== -1 ||
              overflow.indexOf('scroll') !== -1
            ) {
              pre.setAttribute('tabindex', '0');
            }
          },
        );

        // TOC active state via IntersectionObserver
        const toc = document.querySelector('.docs-toc');
        if (toc) {
          const links = Array.from(toc.querySelectorAll('.docs-toc-link'));
          const headings = links
            .map(function (l) {
              const href = l.getAttribute('href');
              return href ? document.getElementById(href.slice(1)) : null;
            })
            .filter(Boolean);
          if (headings.length) {
            const observer = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting) {
                    const id = entry.target.id;
                    links.forEach(function (l) {
                      l.classList.toggle(
                        'active',
                        l.getAttribute('href') === '#' + id,
                      );
                    });
                  }
                });
              },
              { rootMargin: '-68px 0px -70% 0px', threshold: 0 },
            );
            headings.forEach(function (h) {
              observer.observe(h);
            });
          }
        }
      }

      // Run on initial load and after every Astro page transition.
      // Register doc-level listener once per window — ClientRouter re-executes
      // this inline script on swap, which would otherwise stack listeners.
      if (!window.__atelierPageLoadBound) {
        window.__atelierPageLoadBound = true;
        document.addEventListener('astro:page-load', initPage);
      }
      initPage();
    </script>
    <script>
      import '../scripts/framework-pref-init';
    </script>
    <style>
      /* Logo: two <img>s, one shown per theme (same box, so no layout shift).
       * The init script always sets data-theme before first paint; the
       * prefers-color-scheme rules cover the no-JS / unset case. */
      .docs-logo-img--dark {
        display: none;
      }
      [data-theme='dark'] .docs-logo-img--light {
        display: none;
      }
      [data-theme='dark'] .docs-logo-img--dark {
        display: block;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) .docs-logo-img--light {
          display: none;
        }
        :root:not([data-theme]) .docs-logo-img--dark {
          display: block;
        }
      }
      /* Touch-target floor (≥44px, WCAG 2.5.5 / 2.5.8) for the two header/drawer
       * controls that were under-sized. Scoped to BaseLayout so global.css stays
       * untouched. min-width/height grows the hit area without shifting the
       * hamburger bars (they stay centered, same visual size). The hamburger
       * morphs into the X while the drawer is open and is the only close
       * control: the drawer starts below the topbar, so it is never covered. */
      .docs-menu-btn {
        min-width: 44px;
        min-height: 44px;
        align-items: center;
        justify-content: center;
      }
      .docs-theme-btn {
        min-width: 44px;
        min-height: 44px;
        align-items: center;
        justify-content: center;
      }
      /* Touch-target floor for the scroll-to-top button (was 40px). */
      .docs-scroll-top {
        width: 44px;
        height: 44px;
      }

      /* Scroll-progress indicator: a thin fixed bar at the very top of the
       * viewport whose width tracks scroll position (set inline by handleScroll).
       * Sits above the WIP banner / topbar (--ui-z-toast > --ui-z-modal) so
       * it's never occluded. Positional, not animated — fine under
       * reduced-motion. */
      .docs-scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        width: 0;
        height: 3px;
        background: var(--ui-color-primary);
        z-index: var(--ui-z-toast);
        pointer-events: none;
      }

      /* "Edit this page" — a subtle, muted link at the foot of the content
       * column. Sits above the global Footer; separated by a hairline rule so it
       * reads as page meta, not body content. */
      .docs-edit-page {
        margin-top: 3rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--ui-color-border);
      }
      .docs-edit-page-link {
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        gap: 0.4rem;
