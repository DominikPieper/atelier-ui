      <Footer />

      <!-- Bottom Nav (mobile). Labelled apart from the topbar's "Primary". -->
      {trackStep ? (
        <nav
          class="docs-bottom-nav docs-bottom-nav--track"
          aria-label="Workshop steps"
        >
          {trackPrev ? (
            <a
              href={trackPrev.href}
              class="docs-bottom-nav-item"
              rel="prev"
              aria-label={`Previous: ${trackPrev.label}`}
            >
              <Icon name="arrow_left" class="docs-bottom-nav-icon" />
              <span class="docs-bottom-nav-label">{trackPrev.label}</span>
            </a>
          ) : (
            <span
              class="docs-bottom-nav-item docs-bottom-nav-item--empty"
              aria-hidden="true"
            ></span>
          )}
          <span class="docs-bottom-nav-item docs-bottom-nav-step">
            Step {trackStep.step} of {TRACK_LENGTH}
          </span>
          {trackNext ? (
            <a
              href={trackNext.href}
              class="docs-bottom-nav-item docs-bottom-nav-item--next"
              rel="next"
              aria-label={`Next: ${trackNext.label}`}
            >
              <Icon name="arrow_right" class="docs-bottom-nav-icon" />
              <span class="docs-bottom-nav-label">{trackNext.label}</span>
            </a>
          ) : (
