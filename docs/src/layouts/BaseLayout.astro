---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import logo from '../assets/logo.png';
import logoDark from '../assets/logo-dark.png';
import '../styles/tokens.css';
import '../styles/docs-theme.css';
import '../styles/global.css';
import Search from '../components/Search';
import WipBanner from '../components/WipBanner.astro';
import Icon from '../components/Icon.astro';
import Footer from '../components/Footer.astro';
import {
  COMPONENT_CATEGORIES,
  CATEGORY_ICONS,
  SECTION_ICONS,
} from '../data/components';
import {
  WORKSHOP_TRACK,
  TRACK_LENGTH,
  getTrackStep,
  getPrevNext,
} from '../data/workshop-track';
import { isOgSlug, slugFromPath } from '../data/og-pages';
import { sourceUrlFor } from '../lib/source-path';
import libPkg from '../../../libs/angular/package.json';

const LIB_VERSION = libPkg.version;

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogImage?: string;
  currentPath: string;
  /**
   * Data-driven "On this page" table of contents. When provided (length > 0)
   * it renders BOTH the desktop `.docs-toc` aside and the mobile in-flow
   * `.docs-toc-mobile` disclosure from one source. Prefer this over the
   * `slot="toc"` idiom — the slot only feeds the desktop aside (slot content
   * can't be duplicated into the mobile disclosure) and is kept solely for
   * backward compatibility with pages not yet migrated.
   */
  tocItems?: { id: string; label: string }[];
  /**
   * Width of the reading column. The shell owns this, not the page — a page
   * that caps its own wrapper drifts off the site-wide reading axis (ADR-0086).
   *
   * - `default` (800px) — prose pages. The overwhelming majority.
   * - `wide` (1000px) — pages whose body is a tool or a wide table.
   * - `full` — uncapped and rail-less, for pages that lay out their own grid
   *   (landing, component gallery, component detail). Cannot carry a desktop
   *   TOC: there is no rail to put one in.
   */
  width?: 'default' | 'wide' | 'full';
}

const SITE_URL = 'https://atelier.pieper.io';
const SITE_NAME = 'Atelier';
const DEFAULT_DESCRIPTION =
  'Build UIs with AI, Storybook, and Figma — the Atelier workshop. Framework-agnostic component library with Angular, React, and Vue adapters.';

const ogSlug = slugFromPath(Astro.props.currentPath);
const defaultOgImage = isOgSlug(ogSlug)
  ? `${SITE_URL}/og/${ogSlug}.png`
  : `${SITE_URL}/logo.png`;

const {
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  ogTitle,
  ogImage = defaultOgImage,
  currentPath,
  tocItems,
  width = 'default',
} = Astro.props;

// The TOC renders from EITHER the legacy `slot="toc"` markup OR the
// data-driven `tocItems` prop. `hasToc` drives the two-column layout; the
// mobile disclosure renders only from `tocItems` (slot content can't be
// duplicated across both surfaces).
const hasTocItems = (tocItems?.length ?? 0) > 0;
const hasToc = Astro.slots.has('toc') || hasTocItems;
const pageTitle = title !== SITE_NAME ? `${title} — ${SITE_NAME}` : SITE_NAME;
const canonicalUrl = `${SITE_URL}${currentPath}`;
const shareTitle = ogTitle ?? pageTitle;

// "Edit this page" → GitHub source for the route. null on 404 / unknown routes
// (the link simply isn't rendered then).
const editSourceUrl = sourceUrlFor(currentPath);

const isComponents = currentPath.startsWith('/components');
const isMcp = currentPath === '/mcp';
// Any numbered-track page counts as "in the workshop" for the topbar link; the
// home page is the track's first step but is not a workshop page.
const isOnWorkshopTrack =
  currentPath !== '/' && getTrackStep(currentPath) !== undefined;
const isStorybook = currentPath === '/storybook';
const isFigma = currentPath === '/figma';

function isActive(path: string): boolean {
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(path + '/');
}

function isTopActive(path: string): boolean {
  if (path === '/workshop') return isOnWorkshopTrack;
  if (path === '/storybook') return isStorybook;
  if (path === '/figma') return isFigma;
  if (path === '/mcp') return isMcp;
  return false;
}

// Non-workshop sidebar groups are native <details> disclosures, open only when
// they hold the active page. Hrefs live here so the open state and the links
// below cannot drift apart.
const GROUP_HREFS = {
  instructors: ['/schulung'],
  howto: [
    '/install',
    '/figma',
    '/readiness',
    '/prompts',
    '/a11y-workflow',
    '/troubleshooting',
    // Maintainer-only page: exists in `astro dev` only (docs/integrations).
    ...(import.meta.env.DEV ? ['/runbook'] : []),
  ],
  reference: [
    '/components',
    '/patterns',
    '/storybook',
    '/tokens',
    '/mcp',
    '/llms',
    '/claude-md',
    '/agent-skills',
  ],
  explanation: ['/design-principles', '/claude-design', '/accessibility'],
} as const;
const groupOpen = (key: keyof typeof GROUP_HREFS) =>
  GROUP_HREFS[key].some((h) => isActive(h));

// Mobile bottom nav: on a workshop-track page it moves the learner along the
// path (Previous / Step N of M / Next); elsewhere it keeps the quick links.
const trackStep = getTrackStep(currentPath);
const { prev: trackPrev, next: trackNext } = getPrevNext(currentPath);

// Breadcrumb labels mirror the sidebar nav so JSON-LD crumbs match UI.
const BREADCRUMB_LABELS: Record<string, string> = {
  workshop: 'Workshop setup',
  schulung: '2-Tages-Schulung',
  'figma-token': 'Figma access',
  troubleshooting: 'Troubleshooting',
  figma: 'Figma workflow',
  readiness: 'Readiness checklist',
  tutorial: 'Figma to code',
  'design-to-code': 'Design to code',
  storybook: 'Storybook',
  mcp: 'AI tools',
  components: 'Components',
  install: 'Installation',
  tokens: 'Design tokens',
  patterns: 'Patterns',
  llms: 'llms.txt',
  'agent-skills': 'Agent skills',
  'claude-md': 'CLAUDE.md',
  prompts: 'Prompt templates',
  'design-principles': 'Design principles',
  'claude-design': 'Claude Design',
  accessibility: 'Accessibility',
};

function titleCase(slug: string): string {
  return (
    BREADCRUMB_LABELS[slug] ??
    slug
      .split('-')
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ')
  );
}

// A path segment that groups routes without having a page of its own. The
// skill pages are rendered from `pages/skills/`, so the trail derived from the
// URL wants to link `/skills` — which 404s. Their real landing page is
// `/agent-skills`, which is also where the pages themselves point back to.
// Mapped here so the visible crumb and the JSON-LD `item` URL agree.
const SEGMENT_LANDING: Record<string, { name: string; path: string }> = {
  skills: { name: 'Agent skills', path: '/agent-skills' },
};

const pathSegments = currentPath.split('/').filter(Boolean);
const breadcrumbItems = [
  { name: 'Home', url: SITE_URL + '/' },
  ...pathSegments.map((segment, i) => {
    const landing = SEGMENT_LANDING[segment];
    return landing && i < pathSegments.length - 1
      ? { name: landing.name, url: SITE_URL + landing.path }
      : {
          name: titleCase(segment),
          url: SITE_URL + '/' + pathSegments.slice(0, i + 1).join('/'),
        };
  }),
];

// Show the visible trail only when there's a real intermediate crumb
// (Home / Section / Page, i.e. length > 2). On home (length 1) and on
// depth-1 pages (length 2, e.g. "Home / Workshop") the topbar + sidebar
// already mark the active top-level item, so a two-crumb trail would just
// restate it. The URLs above are absolute (for JSON-LD); strip SITE_URL for
// in-app links so the client router handles them.
const showBreadcrumb = breadcrumbItems.length > 2;
const breadcrumbTrail = breadcrumbItems.map((item) => ({
  name: item.name,
  href: item.url.slice(SITE_URL.length) || '/',
}));

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  description: DEFAULT_DESCRIPTION,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="theme-color"
      content="#f8fafc"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0b1220"
      media="(prefers-color-scheme: dark)"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/logo.ico" sizes="any" />
    <link rel="icon" href="/logo.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-accent" />
    <ClientRouter />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <!-- Prevent flash of wrong theme & preserve across View Transitions -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('docs-theme');
        const theme =
          stored ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        // Sync aria-pressed on the theme toggle as soon as the button mounts so
        // assistive tech reads the correct state on first paint, not after JS init.
        document.addEventListener('DOMContentLoaded', function () {
          const btn = document.getElementById('theme-btn');
          if (btn)
            btn.setAttribute(
              'aria-pressed',
              theme === 'dark' ? 'true' : 'false',
            );
        });
      })();

      // Before Astro swaps in the new document, copy data-theme to it so there's no flash
      document.addEventListener('astro:before-swap', function (e) {
        const theme = document.documentElement.getAttribute('data-theme');
        if (theme)
          e.newDocument.documentElement.setAttribute('data-theme', theme);
      });
    </script>
  </head>
  <body>
    <a href="#main" class="docs-skip-link">Skip to content</a>
    <!-- Scroll progress bar — fixed at the very top of the viewport; width is
       driven by the scroll handler below (initPage). -->
    <div
      class="docs-scroll-progress"
      id="scroll-progress"
      aria-hidden="true"
    ></div>
    <WipBanner />
    <div class="docs-shell" id="docs-shell">
      <!-- Top Bar -->
      <header class="docs-topbar">
        <button
          class="docs-menu-btn"
          id="menu-btn"
          aria-label="Toggle navigation"
          aria-controls="sidebar"
          aria-expanded="false"
        >
          <span></span><span></span><span></span>
        </button>

        <a href="/" class="docs-logo">
          {/* alt="" — decorative; the adjacent .docs-logo-text already names the link. */}
          <img
            src={logo.src}
            alt=""
            class="docs-logo-img docs-logo-img--light"
            width={224}
            height={214}
          />
          {/* Light-slate glyph variant: the black pen-nib vanishes on the dark topbar. */}
          <img
            src={logoDark.src}
            alt=""
            class="docs-logo-img docs-logo-img--dark"
            width={224}
            height={214}
          />
          <span class="docs-logo-stack">
            <span class="docs-logo-text">Atelier</span>
            <span class="docs-logo-attribution">workshop</span>
          </span>
        </a>

        <div class="docs-topbar-sep"></div>

        <nav class="docs-topbar-links" aria-label="Primary">
          <a
            href="/workshop"
            class={`docs-topbar-link${isTopActive('/workshop') ? ' active' : ''}`}
            aria-current={isTopActive('/workshop') ? 'page' : undefined}
            >Workshop</a
          >
          <a
            href="/storybook"
            class={`docs-topbar-link${isTopActive('/storybook') ? ' active' : ''}`}
            aria-current={isTopActive('/storybook') ? 'page' : undefined}
            >Storybook</a
          >
          <a
            href="/figma"
            class={`docs-topbar-link${isTopActive('/figma') ? ' active' : ''}`}
            aria-current={isTopActive('/figma') ? 'page' : undefined}
            >Figma workflow</a
          >
          <a
            href="/mcp"
            class={`docs-topbar-link${isTopActive('/mcp') ? ' active' : ''}`}
            aria-current={isTopActive('/mcp') ? 'page' : undefined}
            >MCP playground</a
          >
        </nav>

        <Search client:idle />

        <button
          class="docs-theme-btn"
          id="theme-btn"
          aria-label="Toggle dark theme"
          aria-pressed="false"
        >
          <svg
            id="theme-icon-moon"
            class="docs-theme-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg
            id="theme-icon-sun"
            class="docs-theme-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
            style="display: none"
          >
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </svg>
        </button>
      </header>

      <!-- Sidebar backdrop (mobile) -->
      <div class="docs-sidebar-backdrop" id="sidebar-backdrop"></div>

      <!-- Sidebar -->
      <nav class="docs-sidebar" id="sidebar" aria-label="Section navigation">
        <div class="docs-sidebar-header">
          <div class="docs-sidebar-header-top">
            <div>
              <div class="docs-sidebar-title">Atelier Workshop</div>
              <a
                href="https://github.com/DominikPieper/atelier-ui/blob/main/CHANGELOG.md"
                target="_blank"
                rel="noopener noreferrer"
                class="docs-sidebar-version"
                title="View changelog"
                >v{LIB_VERSION}</a
              >
            </div>
          </div>
        </div>

        {!isComponents ? (
          <>
            {/* Workshop track — sequential, follow in order. Numbered to set the
              expectation that this is a path, not a menu. */}
            <div class="docs-nav-section docs-nav-section--workshop">
              <div class="docs-nav-heading">
                <Icon
                  name={SECTION_ICONS['Workshop']}
                  class="docs-nav-heading-icon"
                />
                <span>Workshop</span>
              </div>
              {WORKSHOP_TRACK.map((s) => <a
                href={s.href}
                class={`docs-nav-link${isActive(s.href) ? ' active' : ''}`}
              >
                <Icon name={s.icon} class="docs-nav-link-icon" />
                <span class="docs-nav-link-num">{s.step}</span>
                {s.label}
              </a>)}
            </div>

            {/* For instructors — off the numbered learner path. The 2-day
              Schulung outline lives here so it doesn't read as a workshop step
              (see workshop-track.ts: Schulung is intentionally not on the track). */}
            <details
              class="docs-nav-section docs-nav-group"
              open={groupOpen('instructors')}
            >
              <summary class="docs-nav-heading">
                <Icon name="school" class="docs-nav-heading-icon" />
                For instructors
              </summary>
              <a
                href="/schulung"
                class={`docs-nav-link${isActive('/schulung') ? ' active' : ''}`}
              >
                <Icon name="schedule" class="docs-nav-link-icon" />
                Schulung (2 Tage)
              </a>
            </details>

            {/* How-To — problem-oriented recipes. Look here when stuck or when
              you have a specific task in mind. */}
            <details
              class="docs-nav-section docs-nav-group"
              open={groupOpen('howto')}
            >
              <summary class="docs-nav-heading">
                <Icon
                  name={SECTION_ICONS['How-To']}
                  class="docs-nav-heading-icon"
                />
                How-To
              </summary>
              <a
                href="/install"
                class={`docs-nav-link${isActive('/install') ? ' active' : ''}`}
              >
                <Icon name="download" class="docs-nav-link-icon" />
                Installation
              </a>
              <a
                href="/figma"
                class={`docs-nav-link${isActive('/figma') ? ' active' : ''}`}
              >
                <Icon name="palette" class="docs-nav-link-icon" />
                Figma workflow
              </a>
              <a
                href="/readiness"
                class={`docs-nav-link${isActive('/readiness') ? ' active' : ''}`}
              >
                <Icon name="check_circle" class="docs-nav-link-icon" />
                Readiness checklist
              </a>
              <a
                href="/prompts"
                class={`docs-nav-link${isActive('/prompts') ? ' active' : ''}`}
              >
                <Icon name="chat" class="docs-nav-link-icon" />
                Prompt templates
              </a>
              <a
                href="/a11y-workflow"
                class={`docs-nav-link${isActive('/a11y-workflow') ? ' active' : ''}`}
              >
                <Icon name="accessibility_new" class="docs-nav-link-icon" />
                A11y workflow
              </a>
              <a
                href="/troubleshooting"
                class={`docs-nav-link${isActive('/troubleshooting') ? ' active' : ''}`}
              >
                <Icon name="help" class="docs-nav-link-icon" />
                Troubleshooting
              </a>
              {import.meta.env.DEV && <a
                href="/runbook"
                class={`docs-nav-link${isActive('/runbook') ? ' active' : ''}`}
              >
                <Icon name="cable" class="docs-nav-link-icon" />
                Runbook
              </a>}
            </details>

            {/* Reference — random-access lookups. */}
            <details
              class="docs-nav-section docs-nav-group"
              open={groupOpen('reference')}
            >
              <summary class="docs-nav-heading">
                <Icon
                  name={SECTION_ICONS['Reference']}
                  class="docs-nav-heading-icon"
                />
                Reference
              </summary>
              <a
                href="/components"
                class={`docs-nav-link${isActive('/components') ? ' active' : ''}`}
              >
                <Icon name="widgets" class="docs-nav-link-icon" />
                Components
              </a>
              <a
                href="/patterns"
                class={`docs-nav-link${isActive('/patterns') ? ' active' : ''}`}
              >
                <Icon name="menu_book" class="docs-nav-link-icon" />
                Patterns
              </a>
              <a
                href="/storybook"
                class={`docs-nav-link${isActive('/storybook') ? ' active' : ''}`}
              >
                <Icon name="book" class="docs-nav-link-icon" />
                Storybook
              </a>
              <a
                href="/tokens"
                class={`docs-nav-link${isActive('/tokens') ? ' active' : ''}`}
              >
                <Icon name="palette" class="docs-nav-link-icon" />
                Design tokens
              </a>
              <a
                href="/mcp"
                class={`docs-nav-link${isActive('/mcp') ? ' active' : ''}`}
              >
                <Icon name="smart_toy" class="docs-nav-link-icon" />
                MCP playground
              </a>
              <a
                href="/llms"
                class={`docs-nav-link${isActive('/llms') ? ' active' : ''}`}
              >
                <Icon name="description" class="docs-nav-link-icon" />
                llms.txt
              </a>
              <a
                href="/claude-md"
                class={`docs-nav-link${isActive('/claude-md') ? ' active' : ''}`}
              >
                <Icon name="article" class="docs-nav-link-icon" />
                CLAUDE.md
              </a>
              <a
                href="/agent-skills"
                class={`docs-nav-link${isActive('/agent-skills') ? ' active' : ''}`}
              >
                <Icon name="robot_2" class="docs-nav-link-icon" />
                Agent skills
              </a>
            </details>

            {/* Explanation — the why behind the design. Consult to understand,
              not to do. */}
            <details
              class="docs-nav-section docs-nav-group"
              open={groupOpen('explanation')}
            >
              <summary class="docs-nav-heading">
                <Icon
                  name={SECTION_ICONS['Explanation']}
                  class="docs-nav-heading-icon"
                />
                Explanation
              </summary>
              <a
                href="/design-principles"
                class={`docs-nav-link${isActive('/design-principles') ? ' active' : ''}`}
              >
                <Icon name="schema" class="docs-nav-link-icon" />
                Design principles
              </a>
              <a
                href="/claude-design"
                class={`docs-nav-link${isActive('/claude-design') ? ' active' : ''}`}
              >
                <Icon name="grid_view" class="docs-nav-link-icon" />
                Claude Design
              </a>
              <a
                href="/accessibility"
                class={`docs-nav-link${isActive('/accessibility') ? ' active' : ''}`}
              >
                <Icon name="accessibility_new" class="docs-nav-link-icon" />
                Accessibility
              </a>
            </details>
          </>
        ) : (
          <>
            {/* Persistent escape hatch back to the workshop track. The components
              sidebar replaces the whole workshop nav, so without this a learner
              who clicked into Components has no obvious way back to the path. */}
            <a href="/workshop" class="docs-nav-link docs-nav-link--return">
              <Icon name="arrow_back" class="docs-nav-link-icon" />
              Return to workshop
            </a>

            <div class="docs-nav-section">
              <div class="docs-nav-heading">
                <Icon
                  name={SECTION_ICONS['Overview']}
                  class="docs-nav-heading-icon"
                />
                Docs
              </div>
              <a href="/workshop" class="docs-nav-link">
                <Icon name="build_circle" class="docs-nav-link-icon" />
                Workshop setup
              </a>
              <a href="/install" class="docs-nav-link">
                <Icon name="download" class="docs-nav-link-icon" />
                Installation
              </a>
              <a href="/troubleshooting" class="docs-nav-link">
                <Icon name="help" class="docs-nav-link-icon" />
                Troubleshooting
              </a>
              <a
                href="/components"
                class={`docs-nav-link${currentPath === '/components' ? ' active' : ''}`}
              >
                <Icon name="grid_view" class="docs-nav-link-icon" />
                All components
              </a>
            </div>

            {Object.entries(COMPONENT_CATEGORIES).map(
              ([category, components]) => <div class="docs-nav-section">
                <div class="docs-nav-heading">
                  <Icon
                    name={CATEGORY_ICONS[category]}
                    class="docs-nav-heading-icon"
                  />
                  {category}
                </div>
                {components.map((name) => {
                  const label = name
                    .split('-')
                    .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
                    .join(' ');
                  return <a
                    href={`/components/${name}`}
                    class={`docs-nav-link${currentPath === `/components/${name}` ? ' active' : ''}`}
