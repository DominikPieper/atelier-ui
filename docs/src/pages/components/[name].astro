---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComponentDetail from '../../components/ComponentDetail';
import { ALL_COMPONENTS, componentDocs } from '../../data/components';
import { manifestApiFor } from '../../data/manifest-props';
import { a11yFor } from '../../data/accessibility';
import { descriptionFor } from '../../data/component-metadata';

export function getStaticPaths() {
  return ALL_COMPONENTS.map((name) => ({ params: { name } }));
}

const { name } = Astro.params;
const doc = componentDocs[name as string];
// Throws (fails the build) when a manifest or a component's entry is missing.
const api = manifestApiFor(name as string);
const a11y = a11yFor(name as string) ?? doc?.a11y ?? null;
const title = doc?.name ?? name;
const docDescription = descriptionFor(name as string);
const description = docDescription
  ? `${docDescription} Framework-agnostic component with Angular, React, and Vue adapters.`
  : `${title} — framework-agnostic UI component with Angular, React, and Vue adapters.`;
---

<BaseLayout
  title={title}
  description={description}
  currentPath={`/components/${name}`}
  width="full"
>
  <ComponentDetail
    name={name as string}
    api={api}
    a11y={a11y}
    description={docDescription}
    client:load
  />
</BaseLayout>
