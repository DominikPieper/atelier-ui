---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Code } from 'astro-expressive-code/components';
import LoopDiagram from '../components/LoopDiagram.astro';
import Callout from '../components/Callout.astro';
import HelpFooter from '../components/HelpFooter.astro';
import PageHero from '../components/PageHero.astro';
import TrackNav from '../components/TrackNav.astro';
import FwSwitcher from '../components/FwSwitcher.astro';

const FRAMEWORKS = ['Angular', 'React', 'Vue'] as const;

// Step 3 — a representative "generate" prompt per framework. The only
// difference between them is the framework name and which Storybook MCP
// surface (or contract) Claude reads for component docs.
const GENERATE_PROMPT: Record<string, string> = {
  React: `Build the Settings / Card Figma frame as a React Atelier UI component.

1. figma-console MCP (figma_get_component_for_development) on the node —
   read boundVariables, the component tree, and the rendered preview.
2. storybook-react MCP (docs-list, then docs-show)
   to look up AtlCard, AtlInput, AtlToggle, and AtlButton props.
3. Generate the component with the exact Atelier UI props and the exact
   --ui-* token names from boundVariables. No hardcoded colors or paddings.`,

  Angular: `Build the Settings / Card Figma frame as an Angular Atelier UI component.

1. figma-console MCP (figma_get_component_for_development) on the node —
   read boundVariables, the component tree, and the rendered preview.
2. storybook-angular MCP (docs-list, then docs-show)
   to look up AtlCard, AtlInput, AtlToggle, and AtlButton props. The reply
   is Angular-native — two-way model() bindings and ng-content already
   spelled out, not React syntax to translate.
3. Generate the component with the exact Atelier UI props and the exact
   --ui-* token names from boundVariables. No hardcoded colors or paddings.`,

  Vue: `Build the Settings / Card Figma frame as a Vue Atelier UI component.

1. figma-console MCP (figma_get_component_for_development) on the node —
   read boundVariables, the component tree, and the rendered preview.
2. storybook-vue MCP (docs-list, then docs-show)
   to look up AtlCard, AtlInput, AtlToggle, and AtlButton props. The reply
   is Vue-native — update:* emits and <slot /> already spelled out, not
   React syntax to translate.
3. Generate the component with the exact Atelier UI props and the exact
   --ui-* token names from boundVariables. No hardcoded colors or paddings.`,
};

// Per-framework note for the Generate step: where component docs come from.
const GENERATE_NOTE: Record<string, string> = {
  React:
    'React exposes component metadata over the hosted Storybook MCP — docs-list gives Claude every prop and variant before it writes a line.',
  Angular:
    "storybook-angular serves its own component docs — real names, variants and defaults, already in Angular's own shape: two-way model() bindings, split Inputs/Outputs, ng-content instead of children.",
  Vue: "storybook-vue serves its own component docs — real names, variants and defaults, already in Vue's own shape: update:* emits, typed slots instead of children.",
};

const PARITY_PROMPT = `Run figma_check_design_parity on the settings card node against
the component I just generated. For each discrepancy, say whether the code,
the Figma master or the contract should change, and why. Fix only the code ones.`;

// Step 4 — the self-healing loop, as one copyable brief.
const LOOP_PROMPT = `Verify the component I just generated, in at most 3 rounds:

1. Run storybook-test for this component's stories
   (nx storybook-test <fw>, or test-run on the local Storybook MCP).
2. Run figma_check_design_parity against the master node.
3. Run figma_scan_code_accessibility on the rendered story HTML.

Fix what fails in the component code, with --ui-* tokens and never
literal values, then run the three checks again.

Do not change any assertion, threshold, axe setting or baseline
without asking me first.

After round 3, stop. Give me a list of what still fails and what
you tried.`;

// Step 4 — the judge half of an eval: a rubric for what no gate checks.
const JUDGE_PROMPT = `Review the component <Name> as a design-system reviewer. The gates
already pass; do not repeat what they check. What a gate exempts on
purpose (a lint rule's allowance, a recorded contract entry) is not a
finding.

Read these sources yourself:
- the Figma master: figma_get_component_for_development on node <id>
- the contract: libs/spec/src/contracts/<name>.contract.ts
- the metadata: libs/spec/src/metadata/<name>.metadata.ts
- the component source, its styles and its stories
- the design principles: docs/src/pages/design-principles.astro

Check each line of this rubric:
1. States: every state the master shows (hover, focus, disabled,
   error, loading) exists in code and has a story. A visible focus
   style counts; axe does not check it.
2. Naming: props and values use the words the rest of the library
   uses (sm/md/lg, not small/large; variant, not type).
3. Contract: each figmaOnly and codeOnly entry has a reason that
   still holds.
4. Behaviour: the play functions test what the component does
   (keyboard, Escape, focus return), not only that parts exist.
5. Tokens: each --ui-* token fits its meaning (a danger colour for
   errors, not for decoration).
6. Accessibility: the accessible name, role and focus order are the
   right choices for this component, not only valid ones.

For each finding give: rubric line, evidence (file:line or Figma
node id), the change you suggest, and how sure you are (high,
medium, low). Order the findings by their effect on users, worst
first. If a line has no finding, write "no finding". Do not invent
one. No score, no fixes.`;

// Step 4 — the same judge, fed the handoff document instead of the component.
const TICKET_PROMPT = `Here is the handoff document for this task, and the diff
(git diff main). Do not read my summary of the work.

Answer:
1. Which line of the handoff does the diff not meet?
2. What does the diff do that the handoff does not ask for
   (new variants, props, states, refactors)?
3. Which line of the handoff cannot be judged from the diff alone?

Quote the handoff line and the diff hunk for each answer.
No score, no fixes.`;
---

<BaseLayout
  title="Design to code"
  description="From a Figma component to a verified, framework-native component — the Atelier loop. Inspect, contract, generate, verify in one signposted walkthrough."
  currentPath="/design-to-code"
  tocItems={[
    { id: 'ready', label: 'Before you start' },
    { id: 'loop', label: 'The loop at a glance' },
    { id: 'step-inspect', label: '1. Inspect' },
    { id: 'step-contract', label: '2. Contract' },
    { id: 'step-generate', label: '3. Generate' },
    { id: 'step-verify', label: '4. Verify' },
    { id: 'next', label: 'Where to go next' },
  ]}
>
  <div class="docs-inline-page">
    <PageHero title="Design to Code" titleAccent="Code" ledeMax="560px">
      From a Figma component to a verified, framework-native component — the
      Atelier loop. This is the map; the
      <a href="/tutorial" class="docs-link-primary">tutorial</a> and the
      <a href="/first-component" class="docs-link-primary">kata</a> are the
      territory.
    </PageHero>

    <!-- Framing: one framework per session -->
    <Callout tone="note" title="Pick one framework per session">
      <p style="margin: 0; line-height: 1.6; color: var(--ui-color-text-muted)">
        Every workshop runs in a
        <strong style="color: var(--ui-color-text)">single framework</strong> —
        pick Angular, React, or Vue with the switcher in the
        <a href="#step-generate" class="docs-link-primary">Generate step</a>
        below. The other two adapters are reference infrastructure that keeps
        the API consistent; you don't touch them in a session.
      </p>
    </Callout>

    <!-- Before you start: is your design system ready? -->
    <div class="docs-section">
      <h2 id="ready" class="docs-section-title">
        Before you start: is your design system ready?
      </h2>
      <p class="docs-step-desc">
        A design system can look fine and still hide faults, like a car with the
        check engine light on. Spend ten minutes on your own system with the
        questions below. Answer each yes or no; the note after each question
        says how Atelier checks the same thing. There is no score, only a list
        of faults to sort.
      </p>
      <ul class="docs-step-desc">
        <li>
          <strong style="color: var(--ui-color-text)">Complete</strong> —
          everything your teams need to build a product actually exists.
          <ul>
            <li>
              Does every component you ship exist as a Figma master with all its
              variants and states? Atelier: <code>check:figma</code> (variant
              matrix) and <code>check:contracts</code> (one story per variant
              value).
            </li>
            <li>
              Are colour, spacing and type defined as named tokens, in Figma and
              in code? Atelier: <code>check:figma-token-names</code>.
            </li>
          </ul>
        </li>
        <li>
          <strong style="color: var(--ui-color-text)">Sound</strong> — what is
          in the system is good: accessible, consistent, tested.
          <ul>
            <li>
              Do your colour pairs meet contrast requirements, and does every
              component pass an automated accessibility check? Atelier:
              <code>check:contrast</code> and <code>storybook-test</code> (axe
              on every story); in Figma,
              <code>figma_audit_component_accessibility</code>.
            </li>
            <li>
              Do components use tokens instead of raw colour, spacing or radius
              values, and Auto Layout instead of absolute positions? Atelier:
              <code>check:figma</code> (token-link coverage, Auto Layout) and
              <code>check:stylelint</code> (no raw colour literals).
            </li>
          </ul>
        </li>
        <li>
          <strong style="color: var(--ui-color-text)">Synchronized</strong> —
          design, code and docs describe the same components.
          <ul>
            <li>
              Does each Figma master map to a code component with the same name
              and the same variant values? Atelier: <code>check:figma</code>
              (name alignment) and <code>check:contracts</code>.
            </li>
            <li>
              Does a rendered component look like its master? Atelier:
              <code>check:paint</code> and <code>figma_check_design_parity</code
              >.
            </li>
            <li>
              Is your generated component documentation rebuilt from the code,
              not typed by hand? Atelier: <code>check:llms</code> fails when the
              generated reference is stale.
            </li>
          </ul>
        </li>
        <li>
          <strong style="color: var(--ui-color-text)">Extensible</strong> — you
          can keep improving the system on purpose.
          <ul>
            <li>
              Is there a written way to propose, review and record a change to
              the system? Atelier: no gate — judgement (decisions are recorded
              as ADRs; <code>check:adr-refs</code> only checks their
              cross-references).
            </li>
            <li>
              Do you know which products use which components, and does product
              feedback reach the system team? Atelier: no gate — judgement.
            </li>
          </ul>
        </li>
        <li>
          <strong style="color: var(--ui-color-text)">AI-ready</strong> — an
          agent can read the system and use it correctly.
          <ul>
            <li>
              Does each component carry a machine-readable purpose, when-to-use
              guidance and an accessibility note? Atelier:
              <code>check:metadata</code>.
            </li>
            <li>
              Does each token say what it is for, not only what value it has?
              Atelier: <code>check:token-annotations</code>.
            </li>
            <li>
              Can an agent look up exact props and variants without reading
              source? Atelier: the Storybook MCP (<code>docs-list</code>,
              <code>docs-show</code>), with
              <code>check:storybook-manifests</code> checking that each
              framework emits its manifest.
            </li>
          </ul>
        </li>
      </ul>
      <p class="docs-step-desc">
        <strong style="color: var(--ui-color-text)"
          >Sort what you find by how much it hurts.</strong
        >
        Cosmetic faults (inconsistent layer names, an off token colour) are
        annoying and can wait. Degrading faults (detached instances, hardcoded
        values, missing component properties) slowly erode the structure. The
        ones to fix first make AI output garbage: no semantic structure, no
        metadata, no connection to code. Several "no" answers under
        <em>AI-ready</em> are that kind. Fix those before you generate anything.
      </p>
    </div>

    <!-- The loop at a glance -->
    <div class="docs-section">
      <h2 id="loop" class="docs-section-title">The loop at a glance</h2>
      <p
        style="
          color: var(--ui-color-text-muted);
          line-height: 1.6;
          margin-bottom: 1.25rem;
        "
      >
        Four steps turn a design into shipped code. Each one hands concrete data
        to the next — no screenshots, no copy-paste guessing.
      </p>

      <LoopDiagram />
      <p class="docs-step-desc" style="margin-top: 1.25rem">
        <strong style="color: var(--ui-color-text)"
          >Run the checks in this order.</strong
        >
      </p>
      <ol class="docs-step-desc">
        <li>
          <strong style="color: var(--ui-color-text)">Readiness</strong> — the
          <a href="#ready" class="docs-link-primary">questions above</a>, before
          anything is generated.
        </li>
        <li>
          <strong style="color: var(--ui-color-text)">Generate</strong> — step
          3.
        </li>
        <li>
          <strong style="color: var(--ui-color-text)">Offline gates</strong> —
          <code>check:contracts</code> and <code>storybook-test</code>. They are
          cheap and deterministic and need no Figma connection.
        </li>
        <li>
          <strong style="color: var(--ui-color-text)">Parity</strong> —
          <code>figma_check_design_parity</code>.
        </li>
        <li>
          <strong style="color: var(--ui-color-text)">Judge</strong> — optional,
          last, and advisory: a model reviews what no gate checks (see
          <a href="#evals" class="docs-link-primary">Evals</a>).
        </li>
      </ol>
      <p class="docs-step-desc">
        Parity is the slowest check and needs the Figma Desktop Bridge running.
        Its result also only means something once the code passes its own gates,
        because the codeSpec it compares is assembled from
        <code>check:contracts --emit</code>. A component that fails a gate would
        waste a parity run on a result you will throw away.
      </p>
    </div>

    <!-- Step 1 — Inspect -->
    <div class="docs-section">
      <div class="docs-step-row" data-step="1">
        <span class="docs-step-badge">1</span>
        <div style="flex: 1">
          <h2 id="step-inspect" class="docs-section-title">
            Inspect — read the Figma component
          </h2>
          <p class="docs-step-desc">
            Run <code>figma_get_component_for_development</code> (figma-console
            MCP) on the node, or open the master on the
            <strong style="color: var(--ui-color-text)">Components page</strong>
            of the
            <a
              href="https://www.figma.com/design/QMnDD8uZQPldPrlCwZZ58T/Atelier-UI"
              target="_blank"
              rel="noopener noreferrer"
              class="docs-link-primary"
              >Atelier UI Figma file</a
            >. Note the
            <strong style="color: var(--ui-color-text)">variants</strong>, the
            <code>--ui-*</code> tokens bound to each property
            (<code>boundVariables</code>), and any accessibility annotations.
            These map one-to-one to CSS custom properties — no conversion
            needed.
          </p>
          <Callout tone="note" title="Write it down before you generate">
            <p
              style="
                margin: 0;
                line-height: 1.6;
                color: var(--ui-color-text-muted);
              "
            >
              A screenshot cannot carry behaviour, scope, or whether to reuse an
              existing component. So before any code exists, fill in a short
              <strong style="color: var(--ui-color-text)"
                >handoff document</strong
              >: copy the template
              <code>skills/design-to-code/references/handoff-document.md</code>
              and fill in what you just inspected (file, node id, variants,
              token bindings). Leave behaviour, exclusions, and reuse-vs-new as
              blanks for you to decide and write. The
              <code>design-to-code</code> skill will not start building without
              this document.
            </p>
          </Callout>
          <details class="d2c-why">
            <summary>Why (for maintainers)</summary>
            <div class="d2c-why-body">
              <p>
                Prompting straight from a screenshot is the failure mode this
                checkpoint exists to prevent. The skill gates its Build mode on
                the handoff document, and the provenance block carries the
                snapshot stamp so a stale Figma read is visible. Decision
                record:
                <a
                  href="https://github.com/DominikPieper/atelier-ui/blob/main/plan/adr/0096-the-handoff-a-picture-cannot-carry.md"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="docs-link-primary"
                  >ADR-0096</a
                >.
              </p>
            </div>
          </details>
        </div>
      </div>
    </div>

    <!-- Step 2 — Contract -->
    <div class="docs-section">
      <div class="docs-step-row" data-step="2">
        <span class="docs-step-badge">2</span>
        <div style="flex: 1">
          <h2 id="step-contract" class="docs-section-title">
            Contract — what the picture cannot carry
          </h2>
          <p class="docs-step-desc">
            The one file you write by hand is the
            <strong style="color: var(--ui-color-text)">contract</strong>
            (<code>libs/spec/src/contracts/&lt;name&gt;.contract.ts</code>): a
            short file that holds the Figma master's node id, plus a note for
            each place where the design and the code deliberately differ. You do
            not list props, defaults or descriptions in it. Those live in the
            component's own types and doc comments, and your framework's
            generated prop table reads them from there, so there is nothing to
            keep in sync by hand. For each difference you write down, say in the
            entry's <code>reason</code> why it is there.
          </p>
          <p class="docs-step-desc">
            <strong style="color: var(--ui-color-text)"
              >The stories are the claims.</strong
            >
            Write one story per variant value and per Boolean state, with a
            <code>play</code> function for every behaviour line from the handoff
            document you wrote in step 1. That is where behaviour, not just
            appearance, gets checked. <code>check:contracts</code> compares the
            contract, the generated prop table and the stories'
            <code>args</code> against the Figma snapshot and reports drift;
            <code>storybook-test</code> renders every story in a real browser
            with axe (an automated accessibility checker). Together they replace
            what a hand-typed spec used to promise but never checked.
          </p>
          <p class="docs-step-desc">
            A scaffolded workspace writes the same contract, at
            <code
              >workshop-&lt;fw&gt;/src/contracts/&lt;name&gt;.contract.ts</code
            >, checked by the same <code>check:contracts</code> (see "Building
            for one framework?" below). What it does not carry is this library's
            own <code>Atl*</code> component set. For those, read the framework
            docs through the hosted <code>storybook-*</code> MCP
            (<code>docs-list</code> → <code>docs-show</code>), or from
            <a href="/llms-full.txt" class="docs-link-primary">llms-full.txt</a
            >. The prop tables the MCP returns are exact, and so are the code
            snippets alongside them: each endpoint answers in its own
            framework's syntax, generated from that adapter's source, so what
            you read there is what the adapter actually does.
          </p>
          <p class="docs-step-desc">
            <strong style="color: var(--ui-color-text)"
              >Building for one framework?</strong
            >
            That is the normal case for a team taking this home, and the pieces
            that transfer are the contract file, the stories, and the two checks
            that read them: <code>check:contracts</code> and
            <code>check:stories</code>. The <code>create-workspace</code>
            scaffold ships all four, so a one-framework repo starts with the
            same loop this monorepo runs, nothing translated. What does
            <em>not</em> transfer is <code>libs/spec/src/index.ts</code>, a file
            specific to this repo that a few cross-framework consistency checks
            read. A one-framework repo has nothing to keep in sync, so skip it.
          </p>
          <details class="d2c-why">
            <summary>Why (for maintainers)</summary>
            <div class="d2c-why-body">
              <p>
                The contract is deliberately a "micro-contract": the prop table
                comes from the docgen manifest, so a hand-written spec would
                only duplicate it. See
                <a
                  href="https://github.com/DominikPieper/atelier-ui/blob/main/plan/adr/0121-the-stories-are-the-spec.md"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="docs-link-primary"
                  >ADR-0121</a
                >
                (S4 covers the scaffold). <code>libs/spec/src/index.ts</code>
                stays the join key that <code>check:props</code>,
                <code>check:variants</code> and <code>check:metadata</code> read
                until ADR-0121's S6 retires them. The review behind this shape
                and the retirement order:
                <code>tasks/spec-format-review-2026-09-10.md</code>.
              </p>
              <p>
                <strong style="color: var(--ui-color-text)"
                  >"Chose on purpose" has a test: is it drawn?</strong
                >
                A mismatch is <em>settled</em> when the thing the two sides
                disagree about changes nothing the master draws: behaviour,
                element or form semantics, data, keys. <code>headingLevel</code>
                picks <code>h2..h6</code> and changes nothing drawn;
                <code>multi</code> guards how many accordion items <em>may</em>
                be open and looks identical either way; <code>id</code> is data.
                Those entries are finished, and a master that grew an axis for
                one would be worse, not better. A mismatch is <em>owed</em> when
                it <em>is</em> drawn: a CSS-backed paint axis with no Figma axis
                means Figma owes an axis, and a Figma axis with no CSS rule
                means either the code owes an implementation or the master owes
                a deletion. An owed entry's <code>reason</code> has to say which
                side is expected to change, and where that is tracked.
              </p>
              <p>
                <strong style="color: var(--ui-color-text)"
                  >Drawn makes it owed; it does not decide it.</strong
                >
                When a feature needs, say, a red button, you choose between a
                library variant, a local exception, or a semantic token. A
                code-side axis earns a place on the master when it is drawn,
                when the checks already enforce it in every framework, when
                accessibility holds, and when someone owns the follow-up.
                Otherwise the better move is often the opposite: delete the axis
                from the master and let the state be a CSS pseudo-class, which
                is already the convention for interaction states here.
              </p>
              <p>
                The settled-versus-owed rule, the promotion argument (promote
                every one-off and the shared library becomes unreadable; bury
                every decision locally and the system stops describing the
                product), and the nine entries currently owed rather than
                settled:
                <code
                  >plan/adr/0145-the-contract-records-the-difference-not-who-owes-it.md</code
                >.
              </p>
              <p>
                Each hosted <code>storybook-*</code> endpoint emits its own
                framework-native manifest, so its snippets come from docgen over
                the adapter's source:
                <a
                  href="https://github.com/DominikPieper/atelier-ui/blob/main/plan/adr/0097-the-manifest-the-framework-can-emit-now.md"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="docs-link-primary"
                  >ADR-0097</a
                >.
              </p>
            </div>
          </details>
        </div>
      </div>
    </div>

    <!-- Step 3 — Generate -->
    <div class="docs-section" id="step-generate">
      <div class="docs-step-row" data-step="3">
        <span class="docs-step-badge">3</span>
        <div style="flex: 1">
          <h2 class="docs-section-title">
            Generate — prompt Claude in your framework
          </h2>
          <p class="docs-step-desc">
            Prompt Claude Code to build or edit the component in your chosen
            framework, using the Storybook MCP for exact component docs. Pick a
            framework — the prompt and the source-of-docs note update to match:
          </p>

          <FwSwitcher
            variant="tabs"
            label="Choose a framework for the generate step"
          />
          {FRAMEWORKS.map((fw, i) => <div data-fw-panel={fw} hidden={i !== 0}>
            <Callout tone="note">
              <p
                style="
                  margin: 0;
                  line-height: 1.6;
                  color: var(--ui-color-text-muted);
                "
              >
                {GENERATE_NOTE[fw]}
              </p>
            </Callout>
            <Code
              code={GENERATE_PROMPT[fw]}
              lang="text"
              wrap
              title={`generate prompt — ${fw}`}
            />
          </div>)}
          <details class="d2c-why">
            <summary>Why (for maintainers)</summary>
            <div class="d2c-why-body">
              <p>
                On Angular, the hosted <code>storybook-angular</code> manifest
                comes from <code>angular-component-meta</code>; on Vue,
                <code>storybook-vue</code> uses <code>vue-component-meta</code>.
                Each endpoint serves its own manifest rather than a React one to
                translate:
                <a
                  href="https://github.com/DominikPieper/atelier-ui/blob/main/plan/adr/0097-the-manifest-the-framework-can-emit-now.md"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="docs-link-primary"
                  >ADR-0097</a
                >.
              </p>
            </div>
          </details>
        </div>
      </div>
    </div>

    <!-- Step 4 — Verify -->
    <div class="docs-section">
      <div class="docs-step-row" data-step="4">
        <span class="docs-step-badge">4</span>
        <div style="flex: 1">
          <h2 id="step-verify" class="docs-section-title">
            Verify — prove design parity
          </h2>
          <p class="docs-step-desc">
            See the component rendered, then run
            <code>figma_check_design_parity</code> to catch padding, colour, and
            variant drift against the Figma design. In the atelier monorepo that
            means the story in Storybook (<code>nx storybook &lt;fw&gt;</code>);
            in a scaffolded workspace it means the app
            (<code>npx nx serve workshop-&lt;fw&gt;</code>) — or, once you've
            written a story for it, the workspace's own Storybook
            (<code>npx nx storybook workshop-&lt;fw&gt;</code>, port
            <code>6006</code>).
            <strong style="color: var(--ui-color-text)"
              >This step is required</strong
            >
            — it's what turns "looks about right" into a verified component.
          </p>
          <Code
            code={PARITY_PROMPT}
            lang="text"
            wrap
            title="parity check prompt"
          />
          <p class="docs-step-desc">
            If your component matches a master component in the Figma library
            and you are working
            <strong style="color: var(--ui-color-text)"
              >in the atelier monorepo</strong
            >, save the result so later drift is caught:
            <code>npm run parity:record -- --component &lt;AtlFoo&gt;</code>.
            The offline <code>npm run check:parity</code> check then flags that
            component if its code changes after this verify. Both are repo
            scripts — a scaffolded workspace stops at the parity prompt above.
          </p>
          <p class="docs-step-desc">
            <strong style="color: var(--ui-color-text)"
              >The failure this step exists for: the dead prop.</strong
            >
            A dead prop is documented — in the types, the JSDoc, the manifest, a
            story — and does nothing at runtime. <code>variant="danger"</code>
            is in the union, so it compiles and an agent reading the manifest
            will use it; but no token or style is wired to it, so the button
            renders like the default. It costs more trust than a missing prop,
            because the docs said it worked, and one dead prop makes every other
            documented prop suspect. Which check sees it depends on where the
            wire is cut:
          </p>
          <ul class="docs-step-desc">
            <li>
              <strong style="color: var(--ui-color-text)">No style rule</strong>
              — <code>check:variants</code> fails when a spec union member has
              no <code>.variant-&lt;member&gt;</code> class in a framework's
              stylesheet, and <code>check:dead-selectors</code> fails the
              reverse: a rule that no template can ever emit.
            </li>
            <li>
              <strong style="color: var(--ui-color-text)"
                >A rule exists, but paints like the default</strong
              >
              — only <code>check:paint</code> and the parity prompt above. They
              compare what a story <em>renders</em> (fill, stroke, geometry,
              type) against the Figma master's row for that variant. That needs
              a master with a row for it: a code-only variant is not compared,
              and <code>check:paint</code> only covers components with both a
              contract and a snapshot master.
            </li>
            <li>
              <strong style="color: var(--ui-color-text)"
                >What does not catch it</strong
              >
              — <code>check:props</code>, <code>check:contracts</code> and
              <code>check:defaults</code> read declared surfaces, they do not
              look at pixels. <code>check:stories</code> renders one story per
              variant value, but a story that renders and passes axe is not a
              story that looks different; only a <code>play</code> that asserts
              the difference (a computed colour, say) makes it a test for this.
            </li>
          </ul>
          <h3 id="parity-report" class="docs-h3 docs-h3--spaced">
            Reading a parity result
          </h3>
          <p class="docs-step-desc">
            The tool returns a report, not a verdict. This is a real run on
            <code>AtlBadge</code> (Angular, default variant, size <code>md</code
            >): a score of
            <strong style="color: var(--ui-color-text)">96/100</strong>, two
            discrepancies.
          </p>
          <ul class="docs-step-desc">
            <li>
              <strong style="color: var(--ui-color-text)">Score</strong> — 0 to
              100, weighted by severity:
              <code>100 − critical×15 − major×8 − minor×3 − info×1</code>. Here
              one minor and one info give 100 − 3 − 1 = 96. The score belongs to
              what you declared and which variant was sampled, so do not store
              it or compare it between components (ADR-0024 recorded three runs
              on one component scoring 70, 52 and 83).
            </li>
            <li>
              <strong style="color: var(--ui-color-text)">Severity</strong> —
              <code>critical</code> and <code>major</code> are real gaps to fix.
              <code>minor</code> is a real gap when it is a colour, spacing,
              radius, type or token value. <code>info</code> is a note, here a
              missing annotation. Differences of about 2 px or 0.01 opacity are
              absorbed as rounding.
            </li>
            <li>
              <strong style="color: var(--ui-color-text)">Category</strong> —
              which section of the codeSpec the entry belongs to. Here
              <code>typography</code> (1) and <code>accessibility</code> (1). An
              empty category means aligned or not declared; the summary cannot
              tell you which.
            </li>
            <li>
              <strong style="color: var(--ui-color-text)"
                >The two entries</strong
              >
              — <code>typography / fontWeight</code>, minor: Figma 500, code 600
              (confirmed in the master's text style). And
              <code>accessibility / role</code>, info: the code sets
              <code>role="status"</code>, the design carries no accessibility
              annotation.
            </li>
          </ul>
          <p class="docs-step-desc">
            <strong style="color: var(--ui-color-text)"
              >What this report did not tell you.</strong
            >
            A quiet report is not a clean component. Checking the same run by
            hand found four things the 96 never showed: vertical padding (the
            design has none and the code declares 5px, which the tool skips
            because the design side is empty), letter-spacing
            (<code>0.01em</code> in code, 0 in Figma, not reported), a missing
            component description in the emitted metadata, and the other nine
            variants, which were never compared because the tool sampled only
            <code>variant=default, size=md</code>. Run the check once per
            variant you care about.
          </p>
          <p class="docs-step-desc">
            <strong style="color: var(--ui-color-text)"
              >Three follow-ups per discrepancy.</strong
            >
            Decide per entry, then fix or record it. "Understood" is not a
            record.
          </p>
          <ol class="docs-step-desc">
            <li>
              <strong style="color: var(--ui-color-text)">Fix the code.</strong>
              The weight finding is this case if 500 is the intended weight: one
              edit in the shared stylesheet.
            </li>
            <li>
              <strong style="color: var(--ui-color-text)">Fix Figma.</strong> If
              600 is intended (badges are labels), change the master's text
              style instead.
            </li>
            <li>
              <strong style="color: var(--ui-color-text)"
                >Record a deliberate mismatch.</strong
              >
              For differences in API shape, the contract has three entries:
              <code>figmaOnly</code> (a Figma property with no code prop),
              <code>codeOnly</code> (a code prop with no Figma property) and
              <code>axisMap</code> (a Figma axis under another name or value
              set), each with a <code>reason</code>; see
              <code>libs/spec/src/contracts/types.ts</code>. The contract cannot
              hold a painted value such as a weight. Those are fixed on one
              side, or kept as a <code>FIGMA_CONFORMANCE_EXCEPTIONS</code> entry
              with a reason, or an open decision item in
              <code>tasks/todo.md</code>.
            </li>
          </ol>
          <Callout tone="warning" title="The suggested action can be wrong">
            <p
              style="
                margin: 0;
                line-height: 1.6;
                color: var(--ui-color-text-muted);
              "
            >
              For the <code>role</code> entry the tool's <code>suggestion</code>
              says to add an annotation in Figma, but its
              <code>actionItems</code> entry targets the code with
              <code>targetValue: null</code>, which means removing the role.
              Neither is the right first move. The real issue is a
              contradiction: the master's description says badges are decorative
              by default and should be wrapped in <code>role="status"</code>
              when they convey a change, while the code puts the role on every
              badge. A person decides which one is the truth. Read
              <code>side</code> in each action item before you apply anything,
              and never apply them blindly. The tool's
              <code>canonicalSource</code> parameter defaults to
              <code>design</code>, which is why the other side, the code, is the
              one told to change.
            </p>
          </Callout>

          <h3 id="self-healing-loop" class="docs-h3 docs-h3--spaced">
            The self-healing loop
          </h3>
          <p class="docs-step-desc">
            You can hand the verify step to the agent as a loop: run the checks,
            fix what fails, run them again. In Atelier the loop is
            <code>storybook-test</code> (every story in a browser, with axe),
            then <code>figma_check_design_parity</code>, then
            <code>figma_scan_code_accessibility</code>. The agent fixes and
            reruns. The loop needs a stop condition, so cap it at about three
            rounds, then hand back to a human with a summary of what still
            fails.
          </p>
          <Code
            code={LOOP_PROMPT}
            lang="text"
            wrap
            title="self-healing loop prompt"
          />
          <p class="docs-step-desc">Four ways this goes wrong:</p>
          <ul class="docs-step-desc">
            <li>
              <strong style="color: var(--ui-color-text)"
                >Goalpost shifting</strong
              >
              — the agent weakens an assertion, lowers a threshold or switches
              off an axe rule to get green. This is why the prompt forbids
              changing assertions, thresholds, axe settings or baselines without
              asking.
            </li>
            <li>
              <strong style="color: var(--ui-color-text)">Oscillation</strong> —
              fixing the padding breaks the wrapping, fixing the wrapping breaks
              the padding. The round cap ends it; a human picks which constraint
              wins.
            </li>
            <li>
              <strong style="color: var(--ui-color-text)"
                >False confidence</strong
              >
              — axe checks only part of what accessibility needs, and parity
              checks only what you declared. Green means the checks pass, not
              that the component is right. Look at the rendered story yourself.
            </li>
            <li>
              <strong style="color: var(--ui-color-text)"
                >Token detachment</strong
              >
              — to close a parity gap the agent writes a literal value instead
              of the token. The prompt requires <code>--ui-*</code> tokens, and
              <code>check:stylelint</code> flags raw colour literals.
            </li>
          </ul>
          <details class="d2c-why">
            <summary>Why (for maintainers)</summary>
            <div class="d2c-why-body">
              <p>
                The recorded parity result and the drift gate are described in
                <a
                  href="https://github.com/DominikPieper/atelier-ui/blob/main/plan/adr/0024-design-parity-persistence-gate.md"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="docs-link-primary"
                  >ADR-0024</a
                >.
              </p>
            </div>
          </details>

          <h3 id="evals" class="docs-h3 docs-h3--spaced">
            Evals: where the judge comes in
          </h3>
          <p class="docs-step-desc">
            An eval is any repeatable check that grades a result. There are two
            kinds. A
            <strong style="color: var(--ui-color-text)">deterministic</strong>
            check is a script: it compares values and gives the same answer
            every time. Everything above is this kind —
            <code>check:contracts</code>, <code>storybook-test</code> with axe,
            parity, the accessibility scan. A
            <strong style="color: var(--ui-color-text)">judge</strong> is a
            model that reads the component and answers what a script cannot: is
            the focus state missing, does this prop name fit the rest of the
            library, does the <code>play</code> function test behaviour or only
            that the parts exist.
          </p>
          <p class="docs-step-desc">
            If something can be scripted, script it. Use the judge only for what
            is left. Three rules keep it useful:
          </p>
          <ul class="docs-step-desc">
            <li>
              <strong style="color: var(--ui-color-text)"
                >Give it the sources, not your conclusion.</strong
              >
              Hand it the master, the contract, the code and the stories, and
              let it read them itself. A judge told "I think this is done" tends
              to agree. A different model from the one that wrote the code is
              better still, because it does not share the same blind spots.
            </li>
            <li>
              <strong style="color: var(--ui-color-text)"
                >Findings with evidence, no score.</strong
              >
              Each finding names the rubric line, the file and line or Figma
              node, and how sure the judge is. A grade like 81 out of 100 does
              not say what failed, and it gives the agent a number to push up.
            </li>
            <li>
              <strong style="color: var(--ui-color-text)"
                >It advises, it does not block.</strong
              >
              The same model on the same input can answer differently, so a
              judge cannot be a gate: a gate's result is its exit code. A human
              reads the findings. A finding that keeps coming back is a
              candidate for a new scripted check.
            </li>
          </ul>
          <p class="docs-step-desc">
            The rubric below covers only what Atelier's gates do not. Rewrite
            its six lines for your own design system, and keep a tally of which
            findings turned out to be real. That tally tells you which lines to
            keep.
          </p>
          <p class="docs-step-desc">
            Run it with two models if you can. In a dry run on Atelier's own
            button, two judges agreed on three findings. The more precise one
            missed the most serious defect, a variant with no visible focus
            ring, which only the other one found.
          </p>
          <Code
            code={JUDGE_PROMPT}
            lang="text"
            wrap
            title="component judge prompt"
          />
          <p class="docs-step-desc">
            The same judge can review the task instead of the component. Give it
            the
            <a href="#step-inspect" class="docs-link-primary"
              >handoff document</a
            >
            and the diff, and ask what the diff misses and what it adds that
            nobody asked for. The second question catches the variants and
            states an agent invents, which is what the
            <a href="/prompts" class="docs-link-primary">prompt guard</a> tries
            to prevent up front.
          </p>
          <Code
            code={TICKET_PROMPT}
            lang="text"
            wrap
            title="ticket review prompt"
          />
          <p class="docs-step-desc">
            Not to be confused with the <code>evals/</code> folders under
            <code>skills/</code>: those test whether an agent follows a skill.
            They do not grade a component.
          </p>
          <details class="d2c-why">
            <summary>Why (for maintainers)</summary>
            <div class="d2c-why-body">
              <p>
                Why the judge has no score and never gates, and why Atelier
                teaches a prompt instead of shipping an eval skill:
                <a
                  href="https://github.com/DominikPieper/atelier-ui/blob/main/plan/adr/0164-the-judge-advises-it-does-not-gate.md"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="docs-link-primary"
                  >ADR-0164</a
                >.
              </p>
            </div>
          </details>
        </div>
      </div>
    </div>

    <!-- Where to go next -->
    <div class="docs-section">
      <h2 id="next" class="docs-section-title">Where to go next</h2>
      <p style="color: var(--ui-color-text-muted); line-height: 1.6">
