---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import CodeCard from '../components/CodeCard.astro';
import LoopDiagram from '../components/LoopDiagram.astro';

const MCP_CONFIG = `{
  "mcpServers": {
    "storybook-angular": {
      "type": "http",
      "url": "https://atelier.pieper.io/storybook-angular/mcp"
    }
  }
}`;

const SCAFFOLD_CMD = 'npx create-atelier-ui-workspace';
---

<BaseLayout
  description="Atelier — build UIs with AI, Storybook, and Figma. A framework-agnostic component library with Angular, React, and Vue adapters, designed for LLM-assisted development."
  currentPath="/"
  width="full"
>
  <!-- Hero -->
  <section class="docs-home-hero" aria-labelledby="hero-title">
    <div class="docs-home-hero-copy">
      <h1 class="docs-page-h1 docs-home-h1" id="hero-title">
        Design to <span class="docs-accent">code</span>, verified.
      </h1>
      <p class="docs-home-lede">
        A Figma design becomes a working, verified component — in Angular, React
        or Vue.
      </p>
      <div class="docs-home-actions">
        <a href="/workshop" class="docs-btn docs-btn-primary">
          Start the workshop
        </a>
        <a href="/components" class="docs-link-primary">Browse components</a>
      </div>
    </div>

    <LoopDiagram />

    <p class="docs-home-note">Teaching artifact · not a production library</p>
  </section>

  <!-- MCP setup -->
  <section class="docs-mcp-section" aria-labelledby="mcp-setup-title">
    <div class="docs-mcp-grid">
      <div>
        <SectionHead
          title="One endpoint. One config."
          sub="Drop this into your Claude Code MCP config — or let the scaffolder below write it for you. Angular is the default; React and Vue use storybook-react and storybook-vue at the same path pattern. Each Storybook endpoint exposes the same three docs tools — docs-list, docs-show, docs-show-story; dev and test tools (stories-preview, test-run) require a locally running Storybook with @storybook/addon-mcp."
          id="mcp-setup-title"
        />
        <ul class="docs-mcp-checklist">
          <li>HTTP transport — no local processes to babysit.</li>
          <li>Hosted alongside the Storybook itself, no extra deploy.</li>
          <li>
            Manifest-aware — Claude reads each framework's component manifest
            before suggesting code.
          </li>
        </ul>
      </div>
      <CodeCard lang=".mcp.json" code={MCP_CONFIG} id="home-mcp-config" />
    </div>
  </section>

  <!-- Scaffolder CTA -->
  <section class="docs-cta-section" aria-labelledby="cta-title">
    <div class="docs-cta">
      <h2 class="docs-cta-title" id="cta-title">Scaffold a workspace.</h2>
      <p class="docs-cta-sub">
        An Nx workspace with your framework choice, the component library wired
        up, and the MCP config pre-seeded.
      </p>
      <div class="docs-cta-cmd">
        <Icon name="terminal" class="docs-cta-cmd-icon" />
        <span class="docs-cta-cmd-prompt" aria-hidden="true">$</span>
        <code class="docs-cta-cmd-text">{SCAFFOLD_CMD}</code>
        <button
          type="button"
          class="docs-cta-cmd-copy"
          data-cta-copy={SCAFFOLD_CMD}
          aria-label="Copy scaffold command to clipboard"
        >
          Copy
        </button>
        <span
          class="docs-visually-hidden"
          data-cta-copy-status
          aria-live="polite"
          role="status"
        ></span>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function bindCtaCopy() {
    const btns =
      document.querySelectorAll<HTMLButtonElement>('[data-cta-copy]');
    btns.forEach((btn) => {
      if (btn.dataset.ctaCopyBound === '1') return;
      btn.dataset.ctaCopyBound = '1';
      btn.addEventListener('click', async () => {
        const payload = btn.getAttribute('data-cta-copy') ?? '';
        const status = btn.parentElement?.querySelector<HTMLElement>(
          '[data-cta-copy-status]',
        );
        try {
          await navigator.clipboard.writeText(payload);
          const original = btn.textContent;
          btn.textContent = 'Copied';
          btn.classList.add('is-copied');
          if (status) status.textContent = 'Command copied to clipboard.';
          window.setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove('is-copied');
            if (status) status.textContent = '';
          }, 1400);
        } catch (err) {
          console.error('Clipboard write failed', err);
          if (status)
            status.textContent = 'Copy failed. Select and copy manually.';
        }
      });
    });
  }

  document.addEventListener('astro:page-load', bindCtaCopy);
  bindCtaCopy();
</script>

<style>
  .docs-home-hero {
    display: flex;
    flex-direction: column;
    gap: var(--ui-spacing-6);
    padding: var(--ui-spacing-2) 0 var(--ui-spacing-12);
  }

  .docs-home-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ui-spacing-3);
  }

  .docs-home-h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin: 0;
  }

  .docs-home-lede {
    margin: 0;
    max-width: 38rem;
    font-size: var(--ui-font-size-lg);
    line-height: 1.5;
    color: var(--ui-color-text-muted);
  }

  .docs-home-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ui-spacing-6);
    margin-top: var(--ui-spacing-2);
  }

  .docs-home-note {
    margin: 0;
    font-size: var(--ui-font-size-sm);
    color: var(--ui-color-text-muted);
  }

  .docs-mcp-section,
  .docs-cta-section {
    margin-bottom: 0;
  }

  .docs-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
