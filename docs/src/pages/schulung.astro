// Trainer appendix: the Claude Design demo. Not a core block (participants cannot
// reproduce it: claude.ai/design needs a different login than the cohort API key).
const APPENDIX_BULLETS: string[] = [
  'Trainer-only demo, "Three directions" (~12 min, trainer machine only — claude.ai/design needs a different login than the cohort API key): three direction artboards for the Toast brief in Claude Design, seeded from the generated palette `tools/design/artboard-palette.css` — not from the atelier-design skill, because that file carries the short names the artboards themselves use (`--success`, `--border-hover`), and because exactly that file is about to be turned red',
  "Before the fence, name the four gate identities in one sentence (the Figma COMPONENT_SET with variant axes, the component's literal union, the `--ui-*` token, the Figma node id). Node ids only appear in Day 1 Block 05 and literal unions only on Day 2, so name them here instead of assuming them. Then the fence: hard-code a colour in the artboard and run `npm run check:artboard-palette` — green, because the gate reads only the shared sheet against `tokens.css` and no artboard. Change the same colour in the generated sheet: the same command turns red",
  'Checkpoint question to the room: which of the four gate identities does this artboard have? Expected answer: none. Only then the classification — in the repo the rule "never inline hex" still holds, and it holds where a gate can enforce it; Claude Design is not a fifth pillar but step 0 (divergence) and step 5 (handoff), never steps 1–4',
  'Step 5 (handoff) stays without a live demonstration, but is no longer just an idea. Unlike step 0 there is no demo in the room: its tooling has existed since 2026-09-08 as a skill (artboard-bridge, Publish mode) and has already run once, against a scratch project, and correctly refused (the component stood at DRIFT), while a skill-less approach would have published unverified code — exactly the refusal the fence argues for. The write path itself (P1–P7) is still untried, because currently every parity record in the repo stands at DRIFT (blocked repo-wide, not on this one component), and access for individual participant seats remains a separate open question (ADR-0106 so far proves only the owner seat). The room must not leave with the impression of having seen a live demonstration',
  'Mitigation for the live demo: generate the artboards in the coffee break 14:30–14:45 beforehand; the fallback is the 31 artboards of the redesign phase (`tools/design/artboards.json`); after the red demo run `git checkout tools/design/artboard-palette.css`. Background for the trainer: /claude-design',
  'Skills in this appendix: `design-to-code`, `atelier-design` and `artboard-bridge` are repo/trainer-only skills and are not part of the participant scaffold.',
];

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Plain strings with `backticks` become <code>; everything else is escaped.
const md = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>');

const dayId = (d: Day) => `day-${d.day.replace(' ', '-').toLowerCase()}`;
---

<BaseLayout
  title="2-Day Training"
  description="Curriculum for the Atelier 2-day training — an AI-assisted design-to-code workflow with Figma, Storybook, MCP and Claude Code. Angular by default, other frameworks on request, one framework per cohort."
  currentPath="/schulung"
  tocItems={[
    { id: 'audience', label: 'Audience' },
    { id: 'main-goal', label: 'Main goal' },
    { id: 'format', label: 'Format per day' },
    { id: 'day-day-1', label: 'Day 1' },
    { id: 'day-day-2', label: 'Day 2' },
    { id: 'verify-title', label: 'Success verification' },
    { id: 'appendix-claude-design', label: 'Trainer appendix' },
  ]}
>
  <div class="docs-inline-page">
    <PageHero
      time="2 days · 09:00–17:30 each (6 h 50 min net)"
      title="2-Day Training"
      ledeMax="640px"
    >
      An AI-assisted design-to-code workflow for developers with a solid
      frontend background. The default framework is Angular; other frameworks
      are possible on request, with one framework per cohort. At the end there
      is a <strong>self-designed and implemented component</strong> in Figma,
      Storybook and code.
    </PageHero>

    <Callout tone="note" title="For instructors">
      <p>
        This page is the two-day training curriculum, aimed at instructors
        planning a cohort. Workshop participants can skip straight to
        <a href="/workshop" class="docs-link-primary">Setup</a>.
      </p>
    </Callout>

    <div class="objective-box">
      <div class="objective-col">
        <h2 id="audience" class="objective-heading objective-heading--accent">
          Audience
        </h2>
        <ul class="objective-list">
          <li>Developers with a frontend background</li>
          <li>Little experience with Figma, Storybook, MCP or AI codegen</li>
          <li>Up to 8 participants per cohort</li>
          <li>
            Cohort language: German. The material (docs, Storybook, briefs,
            prompts) is in English throughout — reading comprehension is assumed
          </li>
          <li>
            Angular by default; another framework on request, one framework per
            cohort — the code is secondary
          </li>
        </ul>
      </div>
      <div class="objective-col">
        <h2 id="main-goal" class="objective-heading">Main goal</h2>
        <ul class="objective-list objective-list--muted">
          <li>
            Understand the four pillars: Figma · Storybook · MCP · Claude Code
          </li>
          <li>Master the end-to-end design-to-code workflow</li>
          <li>Prompt a component from Figma spec to production code</li>
          <li>Apply the a11y and dark-mode loop with confidence</li>
          <li>Carry the loop over to your own design system</li>
        </ul>
      </div>
    </div>

    <div id="format">
      <Callout tone="tip" title="Format per day">
        <p>
          6 h 50 min net, 09:00–17:30 · 60 min lunch · 2× 15 min coffee breaks ·
          10 min buffer. The pre-workshop setup (Node ≥ 22.12 LTS, Claude Code
          CLI, Figma account with draft rights + imported Desktop Bridge plugin,
          <code>npm run preflight</code> green) is mandatory homework — see
          <a href="/workshop" class="docs-link-primary">Workshop Setup</a>.
        </p>
        <p>
          Every block has the same shape: why it exists, the docs pages it uses,
          what everyone has when it is done, what to do, a stretch task for fast
          finishers, and a 2-minute recap. Trainer notes are marked as such.
        </p>
        <p>
          The canonical environment for the cohort since 2026-09-13 is the
          <code>create-atelier-ui-workspace</code> scaffold (ADR-0137) — the
          same route as on
          <a href="/workshop" class="docs-link-primary">Workshop Setup</a>, no
          special path for the training. The scaffold brings Storybook, the
          contract loop, the gates, a unit runner and a ready-made
          <code>.claude/</code> setup, and above all its gates belong to the
          participant's own work. In the clone, part of them turned red
          <em>by design</em> as soon as someone added their own component; that
          had to be explained rather than fixed. The clone remains canonical for
          work on Atelier itself.
        </p>
      </Callout>
    </div>

    {DAYS.map((day) => <section
      class="schulung-day"
      aria-labelledby={dayId(day)}
    >
      <header class="schulung-day-header">
        <span class="schulung-day-eyebrow">{day.day}</span>
        <h2 class="schulung-day-title" id={dayId(day)}>
          {day.title}
        </h2>
        <p class="schulung-day-goal"><strong>Day goal:</strong> {day.goal}</p>
      </header>

      <ol class="docs-step-list schulung-blocks">
        {day.blocks.map((block) => <li
          class={`docs-step-row schulung-block${block.risk ? ' schulung-block--risk' : ''}`}
        >
          <span class="docs-step-badge">{block.num}</span>
          <div>
            <div class="schulung-block-meta">
              <span class="schulung-block-time">{block.time}</span>
              <span class="schulung-block-format">{block.format}</span>
              {block.risk && <span class="schulung-block-risk">High-risk</span>}
            </div>
            <h3 class="docs-h3">{block.title}</h3>
            <dl class="schulung-fields">
              <div>
                <dt>Why</dt>
                <dd>{block.why}</dd>
              </div>
              <div>
                <dt>Pages</dt>
                <dd>
                  {block.pages.map((p, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={p.href} class="docs-link-primary">{p.label}</a>
                    </>
                  ))}
                </dd>
              </div>
              <div>
                <dt>Done when</dt>
                <dd set:html={md(block.done)} />
              </div>
            </dl>
            <ul class="schulung-bullets">
              {block.bullets.map((b) => (
                <li set:html={md(b)} />
              ))}
            </ul>
            <dl class="schulung-fields schulung-fields--after">
              <div>
                <dt>Stretch</dt>
                <dd set:html={md(block.stretch)} />
              </div>
              <div>
                <dt>2-min recap</dt>
                <dd set:html={md(block.recap)} />
              </div>
              {block.trainer &&
                block.trainer.map((t) => <div class="schulung-trainer">
                  <dt>Trainer note</dt>
                  <dd set:html={md(t)} />
                </div>)}
            </dl>
          </div>
        </li>)}
      </ol>

      <div class="schulung-result">
        <h3 class="schulung-result-heading">Deliverable per participant</h3>
        <ul class="objective-list">
          {day.result.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>)}

    <section class="docs-section" aria-labelledby="verify-title">
      <h2 class="docs-section-title" id="verify-title">Success verification</h2>
      <p
        style="
          color: var(--ui-color-text-muted);
          line-height: 1.6;
          margin-bottom: 1rem;
        "
      >
        End-to-end check per participant at the end of Day 2. Since ADR-0137
        everyone works in their own generated workspace, so the gates there
        belong to their own work: red means red, not "red by design". The
        earlier note about three expectedly red gates (<code>check:sync</code>,
        <code>check:a11y-parity</code>, <code>check:design-status</code>)
        applied to the clone and no longer holds — it was a side effect of
        participants working in <em>our</em> repo.
      </p>
      <ol class="schulung-verify">
        <li>
          The component is a component set in your own Figma draft (a duplicate
          of the Atelier file) — with variants, properties and a dark-mode
          variant
        </li>
        <li>
          <code>/verify</code> in Claude Code (or the five checks one by one:
          <code>check:format</code>, <code>check:stylelint</code>,
          <code>check:contracts</code>, <code>check:unit</code>,
          <code>check:stories</code>) — each with exit code 0.
          <code>check:contracts</code> is the one that really checks your own
          work: it joins the contract, the docgen and the Figma snapshot and
          reports <code>[COVERAGE]</code> when a variant value is rendered by no
          story
        </li>
        <li>
          <code>npm run storybook</code> is running and shows the component as a
          story (canvas + Docs tab)
        </li>
        <li>
          Test loop green: the <code>test-run</code> MCP call passes, or the
          equivalent <code>npm run check:stories</code> passes (every story in
          Chromium, play assertions, axe) — <code>npm run check:unit</code>
          covers only the jsdom half and is no substitute
        </li>
        <li>
          <code>figma_audit_component_accessibility</code> without critical
          findings <strong>and</strong> the Storybook a11y tab without axe-core
          findings
        </li>
        <li>Dark mode switches correctly through the token override</li>
        <li>
          <code>figma_check_design_parity</code> (needs the connected Desktop
          Bridge) on your own Figma node against the generated component: the
          report comes back without deviations — that proves something for
          exactly the sections that were passed (see Day 2 Block 04):
          <code>componentAPI</code>, <code>metadata</code>, <code>tokens</code>
          from <code>check:contracts --emit</code> plus
          <code>accessibility</code> from
          <code>figma_scan_code_accessibility</code>; fields that were not
          passed are not compared — a thinly filled <code>codeSpec</code> with
          just these four sections is the normal case, not a special case, as
          long as the report names which sections they were. Hand findings back
          to Claude and check again. This means the MCP call, not
          <code>npm run check:parity</code>: the repo gate checks the Atelier
          masters from <code>tools/figma/snapshot.json</code>, and your own
          component is not in there
        </li>
        <li>
          <code>check:contracts</code> with your own flags (<code>--fw</code>,
          <code>--contracts</code>, <code>--stories</code>,
          <code>--snapshot</code>) exits 0, and
          <code>nx storybook-test &lt;fw&gt;</code> is green — every story
          renders in Chromium and passes axe
        </li>
      </ol>
    </section>

    <section class="docs-section" aria-labelledby="appendix-claude-design">
      <h2 class="docs-section-title" id="appendix-claude-design">
        Trainer appendix: Claude Design demo (optional)
      </h2>
      <Callout tone="note" title="Not a core block">
        <p>
          This demo is optional and runs on the trainer machine only:
          participants cannot reproduce it, because claude.ai/design needs a
          different login than the cohort API key. Slot it into Day 1 Block 04
          if time allows, or skip it. Background:
          <a href="/claude-design" class="docs-link-primary">Claude Design</a>.
        </p>
      </Callout>
      <ul class="schulung-bullets">
        {APPENDIX_BULLETS.map((b) => (
          <li set:html={md(b)} />
        ))}
      </ul>
    </section>

    <HelpFooter page="schulung" />

    <BottomNav
      items={[
        { to: '/', label: 'Prev', title: 'Overview', icon: 'dashboard' },
        {
          to: '/workshop',
          label: 'Next',
          title: 'Setup',
          icon: 'build_circle',
        },
      ]}
    />
  </div>
</BaseLayout>

<style>
  .schulung-fields {
    margin: 0.4rem 0 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: var(--ui-font-size-sm);
    line-height: 1.5;
  }
  .schulung-fields--after {
    margin-top: 0.8rem;
  }
  .schulung-fields > div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.75rem;
  }
  .schulung-fields dt {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--ui-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ui-color-text-muted);
    padding-top: 0.1rem;
  }
  .schulung-fields dd {
    margin: 0;
    color: var(--ui-color-text);
    overflow-wrap: anywhere;
  }
  .schulung-trainer dt {
    color: var(--ui-color-danger);
  }
  .schulung-fields code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    color: var(--ui-color-primary);
    background: var(--ui-color-primary-light);
    padding: 0.05em 0.35em;
    border-radius: var(--ui-radius-sm);
  }
  @media (max-width: 640px) {
    .schulung-fields > div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
  .schulung-day {
    margin-bottom: 3rem;
    padding-top: 1rem;
  }
  .schulung-day + .schulung-day {
    border-top: 1px solid var(--ui-color-border);
    padding-top: 2.5rem;
  }
  .schulung-day-header {
    margin-bottom: 1.75rem;
  }
  .schulung-day-eyebrow {
    display: inline-block;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--ui-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ui-color-primary);
    background: color-mix(in srgb, var(--ui-color-primary) 12%, transparent);
    padding: 0.2rem 0.55rem;
    border-radius: 3px;
    margin-bottom: 0.65rem;
  }
  .schulung-day-title {
    font-size: var(--ui-font-size-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.65rem;
    color: var(--ui-color-text);
    line-height: 1.2;
  }
  .schulung-day-goal {
    margin: 0;
    color: var(--ui-color-text-muted);
    font-size: var(--ui-font-size-sm);
    line-height: 1.6;
    max-width: 60rem;
  }
  .schulung-day-goal strong {
    color: var(--ui-color-text);
  }

  .schulung-blocks {
    margin-bottom: 2rem;
  }

  .schulung-block-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.45rem;
    font-size: var(--ui-font-size-sm);
    font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--ui-color-text-muted);
  }
  .schulung-block-time {
    color: var(--ui-color-text);
    font-weight: 600;
  }
  .schulung-block-format {
    color: var(--ui-color-text-muted);
  }
  .schulung-block-format::before {
    content: '·';
    margin-right: 0.5rem;
    opacity: 0.5;
  }
  .schulung-block-risk {
    color: var(--ui-color-danger);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .schulung-block-risk::before {
    content: '·';
    margin-right: 0.5rem;
    opacity: 0.5;
    color: var(--ui-color-text-muted);
    font-weight: 400;
  }

  .schulung-block--risk .docs-step-badge {
    color: var(--ui-color-danger);
    background: color-mix(in srgb, var(--ui-color-danger) 12%, transparent);
  }

  .schulung-bullets {
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: var(--ui-font-size-md);
    line-height: 1.55;
    color: var(--ui-color-text);
  }
  .schulung-bullets li {
    position: relative;
    padding-left: 1rem;
    overflow-wrap: anywhere;
  }
  .schulung-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ui-color-primary);
    opacity: 0.7;
  }
  .schulung-bullets code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    color: var(--ui-color-primary);
    background: var(--ui-color-primary-light);
    padding: 0.05em 0.35em;
    border-radius: var(--ui-radius-sm);
  }

  .schulung-result {
    margin-top: 1.5rem;
    padding: 1.1rem 1.3rem;
    background: var(--ui-color-surface-raised);
    border: 1px solid var(--ui-color-border);
    border-radius: var(--ui-radius-md);
  }
  .schulung-result-heading {
    margin: 0 0 0.65rem;
    font-size: var(--ui-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ui-color-success);
  }

  .schulung-verify {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: var(--ui-font-size-md);
    line-height: 1.55;
    color: var(--ui-color-text);
  }
  .schulung-verify code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    color: var(--ui-color-primary);
    background: var(--ui-color-primary-light);
    padding: 0.05em 0.35em;
    border-radius: var(--ui-radius-sm);
  }
</style>
