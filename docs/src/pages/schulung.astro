        pages: [L.briefs],
        done: 'A brief is chosen. Homework: duplicate the Figma file and sketch the component.',
        bullets: [
          'What was surprising? Where did the AI work cleanly, where not?',
          'Preview of Day 2 and the optional homework: sketch a small component (Toast / TagChip / StatCard / Avatar — the same four as the starter frames and the briefs)',
          'Catch-up homework for everyone who did not finish the kata: play /first-component through alone — the same loop at your own pace, with the parity check at the end',
        ],
        stretch:
          'Read your chosen brief tonight and write down the three behaviours you would test first.',
        recap:
          'Exit ticket: one sentence on what you will check first next time before trusting AI output.',
      },
    ],
  },
  {
    day: 'Day 2',
    title: 'Build your own component (Figma → Storybook → code)',
    goal: 'Every participant has produced a self-designed component end to end: a Figma spec with variants and tokens, a generated story, generated code in the cohort framework, a passing a11y check, and working dark mode.',
    result: [
      'Own component in your own Figma draft (component set with variants + properties + dark mode)',
      'Contract + component + stories in your own workspace',
      'Working implementation in the cohort framework',
      'A11y audit passed',
    ],
    blocks: [
      {
        num: '00',
        time: '09:00–09:30 · 30 min',
        title: 'Recap (active recall), brief, skills',
        format: 'Talk',
        why: 'Reactivate Day 1.',
