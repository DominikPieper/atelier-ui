---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HelpFooter from '../components/HelpFooter.astro';
import BottomNav from '../components/BottomNav.astro';
import Callout from '../components/Callout.astro';

type PageLink = { label: string; href: string };

type Block = {
  num: string;
  time: string;
  title: string;
  format: string;
  risk?: boolean;
  /** One sentence: why this block exists. */
  why: string;
  /** Docs pages (and anchors) this block uses. */
  pages: PageLink[];
  /** "Done when ..." — what every participant has at the end of the block. */
  done: string;
  /** What to do in the block. Backticks render as <code>. */
  bullets: string[];
  /** For fast finishers. */
  stretch: string;
  /** The 2-minute recap question(s) that close the block. */
  recap: string;
  /** Notes for the trainer, not for participants. */
  trainer?: string[];
};

type Day = {
  day: string;
  title: string;
  goal: string;
  result: string[];
  blocks: Block[];
};

// The exercise target. The kata and the tutorial both build this one frame, and
// the agenda names it in several places. Keep every Atelier-specific name for it
// HERE so that swapping the kata target (ADR-0165, CDS) is a one-place edit.
const TARGET = {
  name: 'Settings Card',
  parts: 'AtlCard / AtlInput / AtlToggle / AtlButton',
  node: '936-2954',
};

const SITE_REPO = 'https://github.com/DominikPieper/atelier-ui/blob/main';

const L = {
  overview: { label: 'Overview', href: '/' },
  workshop: { label: 'Workshop setup', href: '/workshop' },
  figmaToken: { label: 'Figma token', href: '/figma-token' },
  troubleshooting: { label: 'Troubleshooting', href: '/troubleshooting' },
  tutorial: { label: 'Tutorial', href: '/tutorial' },
  firstComponent: { label: 'First-component kata', href: '/first-component' },
  readiness: { label: 'Readiness checklist', href: '/readiness' },
  pinkTest: { label: 'Pink test', href: '/tokens#pink-test' },
  tokenNaming: { label: 'Token naming', href: '/tokens#naming' },
  mcpServers: { label: 'Your MCP servers', href: '/mcp#your-servers' },
  storybook: { label: 'Storybook', href: '/storybook' },
  contractExample: {
    label: 'Worked contract example',
    href: '/design-to-code#contract-example',
  },
  findingCodes: {
    label: 'Finding codes',
    href: '/design-to-code#finding-codes',
  },
  handoffExample: {
    label: 'Filled handoff document',
    href: '/design-to-code#handoff-example',
  },
  parityReport: {
    label: 'Reading a parity report',
    href: '/design-to-code#parity-report',
  },
  selfHealing: {
    label: 'Self-healing loop',
    href: '/design-to-code#self-healing-loop',
  },
  a11yLoop: {
    label: 'A11y in the loop',
    href: '/a11y-workflow#a11y-in-the-loop',
  },
  accessibility: { label: 'Accessibility', href: '/accessibility' },
  checkYourOwn: {
    label: 'Check your own system',
    href: '/design-principles#check-your-own',
  },
  briefs: {
    label: 'Component briefs',
    href: `${SITE_REPO}/workshop/briefs/README.md`,
  },
  skills: { label: 'Agent skills', href: '/agent-skills' },
};

const DAYS: Day[] = [
  {
    day: 'Day 1',
    title: 'Understand the tools & run the workflow end to end',
    goal: `Every participant has a working setup, knows all four pillars (Figma · Storybook · MCP · Claude Code) and has run the loop once end to end: a ${TARGET.name} composed by prompt from existing Atelier components (${TARGET.parts}) — no change to an existing component API.`,
    result: [
      'A running workspace with a green preflight',
      'At least one successful prompt-to-code round trip',
      'Understanding: Figma = source, Storybook = manifest (the API), MCP = connection, Claude = execution',
    ],
    blocks: [
      {
        num: '00',
        time: '09:00–09:30 · 30 min',
        title: 'Kickoff and thesis',
        format: 'Talk + live demo',
        why: 'AI scales what you already have, so the guardrails come first.',
        pages: [L.overview],
        done: 'Everyone can name the loop: Inspect → Contract → Code → Verify.',
        bullets: [
          'Why component-driven? Why AI?',
          'Live demo: change an Atelier component by prompt in 5 minutes',
          'What participants learn in two days, and what they do not',
        ],
        stretch:
          'Write down one component in your own design system that you would trust an AI to change, and one you would not. Keep the note for Day 2.',
        recap:
          'Name the four steps of the loop and the tool that carries each one.',
      },
      {
        num: '01',
        time: '09:30–10:45 · 75 min',
        title: 'Verify the setup (installed as homework)',
        format: 'Hands-on · High-risk block',
        risk: true,
        why: 'Without a green setup, Day 2 is blind.',
        pages: [L.workshop, L.figmaToken, L.troubleshooting],
        done: 'preflight is green, `/mcp` lists every server, Storybook runs, Playwright Chromium is installed, and anyone still red has a rescue path.',
        bullets: [
          'The pre-workshop setup is mandatory homework — this block only verifies, it does not install from zero',
          'Node ≥ 22.12 LTS is active (preflight checks for exactly 22.12), npm version from `package.json#packageManager`',
          'Own workspace created (`npx create-atelier-ui-workspace`, one framework chosen), Claude Code CLI logged in with your own API key',
          'Figma account with draft rights (File → Duplicate to your drafts must work) plus the figma-console Desktop Bridge plugin imported in the Figma desktop app (Figma → Plugins → Development → Import plugin from manifest…). The bridge gates Day 2; the access token is technically optional (REST reads only) and a cohort-policy decision',
          '`npm run preflight` green locally. It checks Node/npm, that the CLI exists (`which claude` + `claude --version`), the Figma bridge, MCP reachability and ports. It does not check that the API key is valid: preflight sends no model request',
          'Confirm model access separately: `claude auth login --console` (or `ANTHROPIC_API_KEY` set), then `claude -p "Reply with exactly: PREFLIGHT-OK"`. A reply instead of an auth error means access is real. An installed CLI, a connected MCP and usable model access are three different things',
