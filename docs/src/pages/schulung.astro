  buildYourOwn: { label: 'Build your own (Day 2)', href: '/build-your-own' },
  skills: { label: 'Agent skills', href: '/agent-skills' },
};

const DAYS: Day[] = [
  {
    day: 'Day 1',
    title: 'Understand the tools & practise the workflow step by step',
    goal: `Every participant has a working setup, knows all four pillars (Figma · Storybook · MCP · Claude Code) and has practised the loop step by step (step 2, the handoff document, follows in Day 2 Block 01) on a ${TARGET.name} composed by prompt from existing Atelier components (${TARGET.parts}) — no change to an existing component API. They have also built a screen out of existing components with Storybook as the only source.`,
    result: [
      'A running workspace with a green preflight',
      'At least one successful prompt-to-code round trip',
      'A screen built from library components, every prop traced to `docs-show` on `atelier`',
      'Understanding: Figma = source, Storybook = manifest (the API), MCP = connection, Claude = execution',
    ],
    blocks: [
      {
        num: '00',
        time: '09:00–09:25 · 25 min',
        title: 'Kickoff and thesis',
        format: 'Talk + live demo',
        why: 'AI scales what you already have, so the guardrails come first.',
        pages: [L.overview, L.glossary, L.guardrailDemo, L.cheatSheet],
        done: 'Everyone has seen the loop as the map of both days (Read the design → Record deliberate differences → Generate → Verify) and the seven scorecard rows as the map of what a design system has to bring.',
        bullets: [
          'Why component-driven? Why AI? (10 min together with the glossary pass)',
          'Glossary pass (inside those 10 min, on the slides; trainer source: /workshop#glossary): LLM, agent, subagent, MCP — the four words the rest of the training assumes. Loop step 2, "Record deliberate differences", means the differences between design and code, written down in the handoff document before generating',
          "Guardrail demo (5 minutes, trainer source: /prompts#guardrails): the same prompt twice, once in a plain chat and once with the Storybook MCP connected — the context is the only variable — then the plain chat's CSS goes into a scaffolded workspace and `npm run check:stylelint` fails on it: context steers, a lint rule (stylelint) catches what slips through, and what it does not see is named, not hidden",
          'Five tools the agent checks itself with (ladder, scorecard and what participants learn, together 10 min, 09:15–09:25; the ladder card is a printed handout: `workshop/handouts/ladder-card.md`): stage, tool and where in the two days, each taught in three beats: break it on purpose, the tool says so, the agent gets the output and repairs. The demo just showed stage 3',
          'What a design system has to bring (the scorecard, handout `workshop/handouts/ds-scorecard.md`, handed out here): walk the seven rows one by one, each with the block where the room meets it. A map of the two days; there is no exercise on it here, Day 2 Block 05 does the marking',
          'What participants learn in two days, and what they do not (talk, inside the same 10 min)',
        ],
      },
      {
        num: '01',
        time: '09:25–09:50 · 25 min',
        title: 'Verify the setup',
        format: 'Hands-on · High-risk block',
        risk: true,
        why: 'Without a green setup, Day 2 is blind.',
        pages: [L.workshop, L.troubleshooting, L.stillRed],
        done: '`preflight` is green, `/mcp` lists every server, Storybook runs, the Figma bridge is connected, the first commit exists, and anyone still red has a rescue path.',
        bullets: [
          'The machines are provisioned by Conciso, so this block verifies and teaches the basics, it installs nothing. Timing (25 min): 10 min frame and one verification pass (preflight, Storybook, Figma duplicate and bridge, `/mcp`; 09:25–09:35), 15 min basics and first commit (09:35–09:50)',
          'Model access is not a step in this block: the seats are logged in during provisioning, before the course',
          'Node ≥ 22.12 LTS is active (preflight accepts 22.12 or newer), npm version from `package.json#packageManager`',
          '`npm run preflight` green, then Storybook with `npm run storybook` and open it. Preflight sends no model request, so it does not check whether the login works',
          'Figma: every machine has Figma Desktop logged in with a Conciso account, the Atelier file already duplicated once and the figma-console Desktop Bridge plugin imported, so nobody duplicates in the room. Open the prepared duplicate (the one copy used on both days), run the bridge plugin and ask Claude to check that the bridge is connected. The duplicate carries three planted findings for the Block 03 linter run. The bridge gates Block 02 and Block 03 (the generation and parity prompts and the Figma linter call it), so a red bridge is fixed now; fallback: pair with a green neighbour',
          'Read and understand the MCP config in `.mcp.json` together, then compare `/mcp` with the file: five servers in an Angular workspace (`atelier`, `storybook-local`, `nx-mcp`, `angular-cli`, `figma-console`; a React or Vue workspace keeps its hosted `storybook-<framework>` entry and also has `storybook-local`). `storybook-local` is connected only while Storybook runs; if its tools are missing, check that Storybook runs first, `/mcp` → reconnect when they still do not appear',
