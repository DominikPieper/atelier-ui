---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HelpFooter from '../components/HelpFooter.astro';
import BottomNav from '../components/BottomNav.astro';
import Callout from '../components/Callout.astro';

type Block = {
  num: string;
  time: string;
  title: string;
  format: string;
  risk?: boolean;
  bullets: string[];
};

type Day = {
  day: string;
  title: string;
  goal: string;
  result: string[];
  blocks: Block[];
};

const DAYS: Day[] = [
  {
    day: 'Tag 1',
    title: 'Werkzeuge verstehen & Workflow end-to-end',
    goal: 'Jeder Teilnehmer hat ein laufendes Setup, kennt alle vier Pillars (Figma · Storybook · MCP · Claude Code) und hat einmal end-to-end eine Settings Card aus vorhandenen Atelier-Komponenten (AtlCard / AtlInput / AtlToggle / AtlButton) per Prompt komponiert — keine Änderung an einer bestehenden Komponenten-API.',
    result: [
      'Laufendes Atelier-Workspace mit grünem preflight',
      'Mindestens ein erfolgreicher Prompt-zu-Code-Roundtrip',
      'Verständnis: Figma = Quelle, Storybook = Spec, MCP = Verbindung, Claude = Ausführung',
    ],
    blocks: [
      {
        num: '00',
        time: '09:00–09:30 · 30 min',
        title: 'Kickoff',
        format: 'Vortrag + Live-Demo',
        bullets: [
          'Warum component-driven? Warum AI?',
          'Live-Demo: in 5 min eine Atelier-Komponente per Prompt cross-framework abändern',
          'Was lernen Teilnehmer in 2 Tagen, was nicht',
        ],
      },
      {
        num: '01',
        time: '09:30–10:45 · 75 min',
        title: 'Setup-Verifikation & Preflight',
        format: 'Hands-on · High-Risk Block',
        risk: true,
        bullets: [
          'Pre-Workshop-Setup ist Pflicht-Hausaufgabe — Block prüft nur, installiert nicht von Null',
          'Node ≥ 22.12 LTS aktiv (preflight prüft hart auf 22.12), npm-Version aus package.json#packageManager',
          'Atelier-Repo geklont (kanonische Schulungsumgebung), Claude Code CLI eingeloggt mit eigenem API-Key',
          'Figma-Account mit Draft-Rechten (File → Duplicate to your drafts muss möglich sein) + figma-console Desktop-Bridge-Plugin in der Figma-Desktop-App importiert (Figma → Plugins → Development → Import plugin from manifest…) — die Bridge gated Tag 2, der Access-Token ist technisch optional (nur REST-Reads) und Kohorten-Policy',
          'npm run preflight lokal grün — prüft aber nur Node/npm, dass die CLI vorhanden ist (which claude + claude --version), die Figma-Bridge, MCP-Erreichbarkeit und Ports. Nicht, ob der API-Key gültig ist: preflight schickt keine Modell-Anfrage',
          'Modellzugriff getrennt bestätigen: claude auth login --console (oder ANTHROPIC_API_KEY gesetzt), dann claude -p "Antworte mit: PREFLIGHT-OK" — kommt eine Antwort statt eines Auth-Fehlers, ist der Zugriff echt. Installierte CLI, verbundene MCP und nutzbarer Modellzugriff sind drei verschiedene Dinge',
          'MCP-Konfig in .mcp.json gemeinsam lesen und verstehen',
          'Bei Problemen: /troubleshooting (Bridge nicht verbunden, Node-Id löst nicht auf, Port-Konflikte, Node-Version zu alt)',
        ],
      },
      {
        num: '02',
        time: '11:00–12:15 · 75 min',
        title: 'Figma für Entwickler',
        format: 'Geführte Tour',
        bullets: [
          'Wie Designer denken — Atelier-File öffnen',
          'Variables / Tokens: Primitives → Semantic → Component',
          'Component-Sets, Variants, Component Properties, Auto Layout',
          'Modes (light/dark), Inventory- vs Components-Page',
        ],
      },
      {
        num: '03',
        time: '13:15–14:30 · 75 min',
        title: 'Storybook als API-Wahrheit',
        format: 'Hands-on Vergleich',
        bullets: [
          'Was ist Storybook, was sind Stories, Prop-Tables',
          'Hosted Storybooks öffnen — selbe Komponente (Button) in Angular/React/Vue vergleichen',
          'Die Komponente ist die Quelle der Form, der Contract die Quelle der Absicht — Parität mit check:contracts sichtbar machen',
          'Was Storybook 10.4 gebracht hat und im gepinnten 10.6.0 weiterhin aktiv ist: Agentic Setup, experimentalReactComponentMeta (Atelier lässt den Docgen aus — Reacts Prop-Tabellen kommen weiter aus react-docgen) — seit 10.6 mit eigenen Geschwistern für Angular und Vue (experimentalDocgenServer, in beiden explizit gesetzt statt sich auf den Default zu verlassen), Change Review Sidebar, Subcomponent-Docs',
        ],
      },
      {
        num: '04',
        time: '14:45–16:00 · 75 min',
        title: 'MCP & Claude Code Grundlagen',
        format: 'Hands-on Demo',
        bullets: [
          'Was ist MCP? Welche Server sind aktiv (storybook-{angular,react,vue}, nx-mcp, figma-console, uianatomy)?',
          'Toolset-Modell (seit 10.4, im Repo läuft 10.6.0): docs / dev / test — hosted vs. lokale Surface, inklusive Toolset-Gating (wann test für Read-Only-Agents deaktiviert wird)',
          'Live-Übung: Claude per Prompt nach Button-Props fragen, Token-Werte ausgeben, Preview im Chat',
          '~5 min Angular/Vue: dieselbe Live-Übung an einer Komponente mit Change-Handler — die gehosteten Angular/Vue-Endpunkte antworten seit Storybook 10.6 nativ (ADR-0097): checked / model() für Angular, v-model / update:checked für Vue, ohne Umweg über libs/spec/src/index.ts. Kurz danebenlegen genügt als Bestätigung, nicht als Übersetzungsschritt',
          'Negativ-Demo: dieselbe Frage im Browser-Chat ohne MCP → Halluzination. Mit MCP → korrekte Antwort',
          'Trainer-Demo Drei Richtungen (~12 min, nur Trainer-Maschine — claude.ai/design braucht ein anderes Login als der Kohorten-API-Key): drei Direction-Artboards für den Toast-Brief in Claude Design, geseedet aus der generierten Palette tools/design/artboard-palette.css — nicht aus dem atelier-design Skill, weil dieses File die Kurznamen trägt, die die Artboards selbst verwenden (--success, --border-hover), und weil genau dieses File gleich rot gemacht wird',
          'Vor dem Zaun die vier Gate-Identitäten in einem Satz benennen (Figma-COMPONENT_SET mit Variant-Achsen, Spec-String-Literal-Union, --ui-*-Token, Figma-Node-Id) — Node-Ids kommen erst in Block 05, Literal-Unions erst an Tag 2, hier also benennen statt voraussetzen. Dann der Zaun: eine Farbe im Artboard hart eintragen und npm run check:artboard-palette laufen lassen — grün, das Gate liest nur das gemeinsame Sheet gegen tokens.css und kein Artboard. Dieselbe Farbe im generierten Sheet ändern: derselbe Befehl wird rot',
          'Checkpoint-Frage an den Raum: welche der vier Gate-Identitäten hat dieses Artboard? Erwartete Antwort: keine. Erst danach die Einordnung — im Repo gilt die Regel „nie Inline-Hex" weiter, sie gilt dort, wo ein Gate sie durchsetzen kann; Claude Design ist kein fünfter Pillar, sondern Schritt 0 (Divergenz) und Schritt 5 (Handoff), nie Schritt 1–4',
          'Schritt 5 (Handoff) bleibt an diesem Punkt ohne Live-Vorführung, aber nicht mehr Idee: anders als Schritt 0 gibt es dafür keine Demo im Raum — sein Tooling existiert seit 2026-09-08 als Skill (artboard-bridge, Publish-Modus) und ist bereits einmal gelaufen, gegen ein Scratch-Projekt, und hat korrekt verweigert (die Komponente stand auf DRIFT), während ein skill-loser Ansatz ungeprüften Code veröffentlicht hätte — genau die Verweigerung, für die der Zaun weiter oben zwei Abschnitte lang argumentiert. Der Schreibpfad selbst (P1–P7) ist noch unerprobt, weil aktuell jeder Parity-Record im Repo auf DRIFT steht (repo-weit blockiert, nicht an dieser einen Komponente), und Zugriff für einzelne Teilnehmer-Seats bleibt eine eigene, offene Frage (ADR-0106 beweist bislang nur den Owner-Seat). Der Raum darf hier nicht den Eindruck mitnehmen, eine Live-Vorführung gesehen zu haben',
          'Gegenmittel für die Live-Demo: Artboards in der Kaffeepause 14:30–14:45 vorab erzeugen; Fallback sind die 31 Artboards der Redesign-Phase (tools/design/artboards.json); nach der Rot-Demo git checkout tools/design/artboard-palette.css. Hintergrund für den Trainer: /claude-design',
        ],
      },
      {
        num: '05',
        time: '16:10–17:15 · 65 min',
        title: 'Geführter End-to-End-Walkthrough',
        format: 'Hands-on, alle synchron',
        bullets: [
          'Das offizielle /tutorial: Figma → MCP → Token-genauer Code in 5 Schritten',
          'Teilnehmer prompten Claude im gewählten Framework entlang genau dieser Anleitung: eine Settings Card aus AtlCard / AtlInput / AtlToggle / AtlButton komponieren — keine Änderung an einer bestehenden Komponenten-API, sondern Komposition aus vorhandenen Bausteinen',
          'Wichtig: nicht selbst tippen, sondern prompten',
          'Puffer für Schnelle: die 15-min-Kata /first-component — dieselbe Settings / Card-Frame (Node 936-2954) als zweite Runde auf Zeit, sechs Copy-Paste-Schritte mit demselben figma_check_design_parity am Schluss. Im Klon liegt die Komponente unter libs/<fw>/… und wird über nx storybook <fw> angesehen, nicht über nx serve workshop-<fw> — Schritt 4 der Kata-Seite sagt das',
        ],
      },
      {
        num: '06',
        time: '17:15–17:30 · 15 min',
        title: 'Wrap-up Tag 1',
        format: 'Diskussion',
        bullets: [
          'Was war überraschend? Wo hat AI sauber funktioniert, wo nicht?',
          'Vorschau Tag 2 + optionale Hausaufgabe: kleine Komponente skizzieren (Toast / TagChip / StatCard / Avatar — dieselben vier wie die Starter-Frames und die Briefs)',
          'Nachhol-Hausaufgabe für alle, die Block 05 nicht zu Ende gebracht haben: /first-component allein durchspielen — derselbe Loop im eigenen Tempo, mit Parity-Check am Schluss',
        ],
      },
    ],
  },
  {
    day: 'Tag 2',
    title: 'Eigene Komponente bauen (Figma → Storybook → Code)',
    goal: 'Jeder Teilnehmer hat eine selbst gestaltete Komponente durchgängig produziert: Figma-Spec mit Variants & Tokens, generierte Story, generierter Code im gewählten Framework, A11y-Check bestanden, Dark Mode funktioniert.',
    result: [
      'Eigene Komponente im eigenen Figma-Draft (Component-Set mit Variants + Properties + Dark-Mode)',
      'Contract + Stories im eigenen Workspace',
      'Funktionierende Implementierung im gewählten Framework',
      'A11y-Audit bestanden',
    ],
    blocks: [
      {
        num: '00',
        time: '09:00–09:30 · 30 min',
        title: 'Recap & Brief',
        format: 'Vortrag',
        bullets: [
          'Tag-1-Recap',
          'Komponenten-Brief vorstellen — Anatomie, Axes, States, A11y-Anforderungen. Ein Brief je Komponente liegt im Repo unter workshop/briefs/{toast,tagchip,statcard,avatar}.md',
          'uianatomy MCP als Hilfsmittel zeigen — und daran das Skills-Konzept: ein Skill ist eine Anleitung, die Claude lädt, wenn die Aufgabe passt. Fünf sind für diese Schulung relevant, nicht drei: uianatomy-mcp triggert hier automatisch; figma-workspace-architect und atelier-design begleiten gleich Block 01; design-to-code trägt ab Block 02 den ganzen Rest des Tages — das Routing zwischen eigenem Contract und geteiltem Master läuft bereits durch ihn (siehe Block 02 unten); artboard-bridge bindet die Schritt-0/Schritt-5-Artefakte aus /claude-design ein, mit Publish bislang trainer-only',
        ],
      },
      {
        num: '01',
        time: '09:30–11:00 · 90 min',
        title: 'Design in Figma',
        format: 'Hands-on · High-Risk Block',
        risk: true,
        bullets: [
          'Pflicht-Vorabschritt: Atelier-File in eigene Drafts duplizieren — niemals im Original-File mutieren',
          'Startpunkt ist ein Starter-Frame von der Workshop-Templates-Page, der beim Duplizieren mitkommt: Toast / Starter, StatCard / Starter, TagChip / Starter oder Avatar / Starter, dazu Variant Matrix / Scaffold. Fills und — wo die Komponente sie hat — Paddings und Radien sind dort bereits an UI-Tokens-Variablen gebunden — erster Schritt ist kopieren und umbenennen, nicht leere Leinwand',
          '~45 min manuelles Design im Figma-UI (Layout, Variants, Token-Zuweisung)',
          '~45 min MCP-Strukturierung (Component Properties, A11y-Audits)',
          'Eigenes Component-Set: ≥2 Variants × 2 States, Properties, korrekte Tokens (--ui-*), Dark-Mode-Variante — die genaue Matrix steht im Komponenten-Brief',
          'Skills als Co-Pilot, hier zum ersten Mal im Einsatz: figma-workspace-architect für Architekturentscheidungen, atelier-design für Brand-Konsistenz',
          'Bei Problemen: /troubleshooting (Bridge nicht verbunden, Node-Id löst nicht auf, Port-Konflikte, Node-Version zu alt)',
          'Block endet mit einem kurzen Handoff-Dokument, bevor irgendwer prompted: Draft-URL + Node-Id, gewählte Variants/States, Token-Bindings, Wiederverwendung vs. Neubau, die Behaviour aus dem Brief, explizite Ausschlüsse, Zieldateien, Abnahmekriterien — eine Checkliste, kein Template',
        ],
      },
      {
        num: '02',
        time: '11:15–12:30 · 75 min',
        title: 'Contract & Stories per Prompt',
        format: 'Prompt-Übung',
        bullets: [
          'Alle Teilnehmer, unabhängig vom Framework: nx storybook <fw> parallel starten (Port aus dem Terminal — Angular 4400, React 4401, Vue 4402), dann per claude mcp add --transport http storybook-local http://localhost:<port>/mcp verbinden — bewusst lokaler Scope (Default von --scope, nicht project): das gemeinsame .mcp.json bleibt unangetastet, der Working Tree sauber. Client neu verbinden und prüfen, dass die dev/test-Tools (get-storybook-story-instructions, stories-preview, test-run) jetzt gelistet sind — seit 10.6.0 identisch für alle drei Frameworks. Ohne diesen Schritt ist das gleich folgende Pflicht-Tool schlicht nicht vorhanden: „nicht verfügbar" heißt hier „nicht konfiguriert", nicht „Server down". get-storybook-story-instructions ist Pflicht vor jedem *.stories.* Edit',
          'Der Prompt entsteht aus dem Handoff-Dokument aus Block 01, nicht aus dem Bild allein — Behaviour und Ausschlüsse aus dem Dokument, nicht nur die Optik → von Claude einen Contract (getypt über das ComponentContract-Schema aus libs/spec/src/contracts/types.ts, importiert via @atelier-ui/spec/contracts/*) und Stories generieren lassen: eine Story je Variantenwert und Boolean-State, mit play für jede Behaviour-Zeile des Dokuments',
          'LLM-optimierte API-Regeln: predictable naming, literal unions, composition über config, keine versteckten Defaults',
          'Der eigene Contract bleibt automatisch außerhalb des geteilten Masters: der design-to-code-Skill liest im Handoff-Dokument aus Block 01, ob die Quelle das Original-File oder ein Duplikat ist, und legt den Contract im zweiten Fall als eigene Datei neben der Komponente an statt als Block in libs/spec/src/index.ts — die Komponente selbst deklariert ihre Prop-Typen direkt, keine separate Atl*Spec-Interface-Datei mehr',
          'Der eigene Figma-Node landet nie in tools/figma/snapshot.json — stattdessen ein eigenes Snapshot-Fragment, mit verbundener Bridge: node tools/scripts/figma-snapshot-contracts.mjs --file <eigener Duplikat-Key> --contracts libs/<fw>/src/lib/<name> --out libs/<fw>/src/lib/<name>/figma.snapshot.json — immer mit explizitem --out, sonst überschreibt der Default Ateliers eigenen Snapshot',
          'Geprüft wird mit node tools/scripts/check-contracts.mjs --fw <fw> --contracts libs/<fw>/src/lib/<name> --stories libs/<fw>/src/lib/<name> --snapshot libs/<fw>/src/lib/<name>/figma.snapshot.json — ohne verbundene Bridge dasselbe ohne --snapshot: der Check fällt dann auf den geteilten Master-Snapshot zurück, in dem die eigene Komponente nicht steht, und meldet [NO-MASTER] statt zu scheitern',
          'Drei Gates werden dabei erwartungsgemäß rot (kein Fehler an der eigenen Arbeit): check:sync mit [DRIFT] (Komponente fehlt in den anderen Frameworks), check:a11y-parity mit [BLOCKER] [ROSTER], check:design-status. check:contracts bleibt in der Standardausführung (npm run check:contracts) grün — für die eigene Komponente meldet es nur eine Warnung, [NO-MASTER], weil sie keinen Atelier-Master hat; rot wird der Check nur, wenn ihr ihn mit euren eigenen Flags gegen euren eigenen Contract und Snapshot laufen lasst und dabei einen echten Mismatch findet — check:all bricht aber beim ersten Fehler ab, die drei also einzeln laufen lassen, um das volle Bild zu sehen',
          'Iterieren bis Prop-Table passt',
          'Wer zusätzlich eine Vorlage sehen will: docs-show-story über die hosted MCP liefert dieselbe Story framework-nativ (storybookId setzen, wenn mehrere Sources konfiguriert sind)',
        ],
      },
      {
        num: '03',
        time: '13:30–15:00 · 90 min',
        title: 'Codegen im Wunsch-Framework',
        format: 'Prompt-Übung',
        bullets: [
          'Fokus: Prompts schreiben, Output bewerten, korrigieren — nicht selbst tippen',
          'Token-Treue erzwingen: Golden-Prompts verlangen --ui-* Custom Properties',
          'Golden-Prompts für diesen und Block 04 (plus Tag 1 Block 5): tasks/schulung-golden-prompts.md',
          'plan/big-picture.md (API-Regeln) + plan/design-principles.md (Surface/Motion/Dark Mode) im Prompt-Kontext',
          'Test-Loop, alle Frameworks: dev + test Toolset über die lokale addon-MCP (localhost:<port>/mcp — Angular 4400, React 4401, Vue 4402), stories-preview + test-run mit a11y — seit 10.6.0 identisch für Angular, React und Vue',
          'Alternative, weiterhin vollwertig: nx test <lib> --watch + parallel laufende Storybook im Browser für visuelles Feedback',
          'AI-gestütztes Debugging: Fehlermeldungen per Copy-Paste an Claude zurückgeben statt selbst debuggen',
        ],
      },
      {
        num: '04',
        time: '15:15–16:30 · 75 min',
        title: 'A11y + Dark Mode + States',
        format: 'Hands-on',
        bullets: [
          'Dreischritt-A11y-Check: (1) figma_audit_component_accessibility, (2) Storybook A11y-Panel (axe-core), (3) Keyboard-Walkthrough',
          'Befunde von Claude beheben lassen',
          'ARIA-Anforderungen, Fokus-Ring via Tokens, Hover/Active/Disabled-States',
          'Dark-Mode-Toggle via Storybook backgrounds-/theme-Addon — Token-Override-Drift sichtbar machen',
          'figma_check_design_parity einmal bewusst gegen ein unvollständiges codeSpec testen: Node, Variant/State und die übergebenen codeSpec-Felder (visual, spacing, typography, tokens, componentAPI, accessibility, metadata) genau nachsehen, dann einen Spacing-Wert bewusst verfälschen — nur mit vollständigen Feldern muss der Report die Abweichung melden, nicht übergebene Felder werden nicht verglichen',
        ],
      },
      {
        num: '05',
        time: '16:40–17:30 · 50 min',
        title: 'Show & Tell + Best Practices',
        format: 'Präsentation + Diskussion',
        bullets: [
          'Jeder Teilnehmer zeigt 3–5 min seine Komponente',
          'Trainer-Synthese: Prompt-Patterns die geklappt haben, Anti-Patterns, wann Claude scheitert, wie mit Drift umgehen',
          'Ausblick: produktiver Einsatz im eigenen Repo, eigene CLAUDE.md, eigene Skills',
        ],
      },
    ],
  },
];
---

<BaseLayout
  title="2-Tages-Schulung"
  description="Curriculum für die Atelier 2-Tages-Schulung — KI-gestützter Design-to-Code-Workflow mit Figma, Storybook, MCP und Claude Code. Jeder Teilnehmer im Wunsch-Framework (Angular / React / Vue)."
  currentPath="/schulung"
  tocItems={[
    { id: 'zielgruppe',    label: 'Zielgruppe' },
    { id: 'hauptlernziel', label: 'Hauptlernziel' },
    { id: 'format',        label: 'Format pro Tag' },
    { id: 'day-tag-1',     label: 'Tag 1' },
    { id: 'day-tag-2',     label: 'Tag 2' },
    { id: 'verify-title',  label: 'Erfolgs-Verifizierung' },
  ]}
>
  <div class="docs-inline-page">

    <PageHero
      kind="tutorial"
      time="2 Tage · je 09:00–17:30 (6 h 50 min netto)"
      title="2-Tages-Schulung"
      ledeMax="640px"
    >
      KI-gestützter Design-to-Code-Workflow für Entwickler mit solider Frontend-Basis. Jeder Teilnehmer wählt sein eigenes Framework (Angular / React / Vue) — am Ende steht eine <strong>selbst designte und implementierte Komponente</strong> in Figma, Storybook und Code.
    </PageHero>

    <!--
      Deliberately English on an otherwise German page: this callout exists for a reader who
      landed here without German and needs to be told where to go instead — a German sentence
      would be useless to the only audience it has. The shared HelpFooter below is English for
      the same reason. Everything addressed to the cohort and its trainer stays German.
    -->
    <Callout tone="note" title="For instructors">
      <p>
        This page is the German two-day training curriculum, aimed at instructors planning a
        cohort. Workshop participants can skip straight to <a href="/workshop" class="docs-link-primary">Setup</a>.
      </p>
    </Callout>

    <div class="objective-box">
      <div class="objective-col">
        <h2 id="zielgruppe" class="objective-heading objective-heading--accent">Zielgruppe</h2>
        <ul class="objective-list">
          <li>Entwickler mit Frontend-Basis (Angular, React oder Vue)</li>
          <li>Wenig Erfahrung mit Figma, Storybook, MCP oder AI-Codegen</li>
          <li>Sprache: Deutsch</li>
          <li>Material (Docs, Storybook, Briefs, Prompts) ist durchgängig Englisch — Leseverständnis vorausgesetzt</li>
          <li>Eigenes Framework wählbar — Code ist zweitrangig</li>
        </ul>
      </div>
      <div class="objective-col">
        <h2 id="hauptlernziel" class="objective-heading">Hauptlernziel</h2>
        <ul class="objective-list objective-list--muted">
          <li>Die vier Pillars verstehen: Figma · Storybook · MCP · Claude Code</li>
          <li>End-to-End Design-to-Code-Workflow beherrschen</li>
          <li>Komponente von Figma-Spec bis Production-Code prompten</li>
          <li>A11y- und Dark-Mode-Loop sicher anwenden</li>
        </ul>
      </div>
    </div>

    <div id="format">
    <Callout tone="tip" title="Format pro Tag">
      <p>
        6 h 50 min netto, 09:00–17:30 · 60 min Mittagspause · 2× 15 min Kaffeepausen · 10 min Puffer. Pre-Workshop-Setup
        (Node ≥ 22.12 LTS, Claude Code CLI, Figma-Account mit Draft-Rechten + importiertes Desktop-Bridge-Plugin, <code>npm run preflight</code> grün)
        ist Pflicht-Hausaufgabe — siehe <a href="/workshop" class="docs-link-primary">Workshop Setup</a>.
      </p>
      <p>
        Kanonische Umgebung für die Kohorte ist das <strong>geklonte atelier-Repo</strong>, nicht der
        <code>create-atelier-ui-workspace</code>-Scaffold: Tag 2 arbeitet direkt mit <code>plan/</code>,
        <code>libs/spec</code> und <code>nx storybook &lt;fw&gt;</code>, die es nur im Klon gibt.
      </p>
    </Callout>
    </div>

    {DAYS.map((day) => (
      <section class="schulung-day" aria-labelledby={`day-${day.day.replace(' ', '-').toLowerCase()}`}>
        <header class="schulung-day-header">
          <span class="schulung-day-eyebrow">{day.day}</span>
          <h2 class="schulung-day-title" id={`day-${day.day.replace(' ', '-').toLowerCase()}`}>
            {day.title}
          </h2>
          <p class="schulung-day-goal"><strong>Tagesziel:</strong> {day.goal}</p>
        </header>

        <ol class="docs-step-list schulung-blocks">
          {day.blocks.map((block) => (
            <li class={`docs-step-row schulung-block${block.risk ? ' schulung-block--risk' : ''}`}>
              <span class="docs-step-badge">{block.num}</span>
              <div>
                <div class="schulung-block-meta">
                  <span class="schulung-block-time">{block.time}</span>
                  <span class="schulung-block-format">{block.format}</span>
                  {block.risk && <span class="schulung-block-risk">High-Risk</span>}
                </div>
                <h3 class="docs-h3">{block.title}</h3>
                <ul class="schulung-bullets">
                  {block.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            </li>
          ))}
        </ol>

        <div class="schulung-result">
          <h3 class="schulung-result-heading">Lieferergebnis pro Teilnehmer</h3>
          <ul class="objective-list">
            {day.result.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </section>
    ))}

    <section class="docs-section" aria-labelledby="verify-title">
      <h2 class="docs-section-title" id="verify-title">Erfolgs-Verifizierung</h2>
      <p style="color: var(--ui-color-text-muted); line-height: 1.6; margin-bottom: 1rem; font-size: 0.85rem">
        End-to-End-Check am Ende von Tag 2 pro Teilnehmer:
      </p>
      <ol class="schulung-verify">
        <li>Komponente liegt als Component-Set im eigenen Figma-Draft (Duplikat des Atelier-Files) — mit Variants, Properties und Dark-Mode-Variante</li>
        <li><code>npm run sync:generated</code> läuft ohne Diff durch (<code>git status --short</code> danach leer) — der Befehl prüft nur, ob die generierten Kopien (Spec, Behaviors, <code>llms.txt</code>) mit dem geteilten Master synchron sind. Liegt der eigene Contract korrekt neben der Komponente (Tag 2, Block 02), hat der Befehl nichts von der eigenen Arbeit zu sehen und läuft trivial durch — die eigene Komponente selbst prüfen die Punkte 3–8</li>
        <li><code>nx storybook &lt;fw&gt;</code> läuft und zeigt die Komponente als Story (Canvas + Docs-Tab)</li>
        <li>Test-Loop grün, für alle drei Frameworks identisch: <code>test-run</code> MCP-Call passes — <code>nx test &lt;lib&gt;</code> passes ist die gleichwertige Alternative</li>
        <li><code>figma_audit_component_accessibility</code> ohne kritische Findings <strong>und</strong> Storybook A11y-Tab ohne axe-core-Findings</li>
        <li>Dark Mode wird durch Token-Override korrekt umgeschaltet</li>
        <li><code>figma_check_design_parity</code> auf den eigenen Figma-Node gegen die generierte Komponente: der Report kommt ohne Abweichungen zurück — das beweist nur etwas, wenn dabei Node, Variant/State und ein vollständiges <code>codeSpec</code> übergeben wurden (siehe Block 04), zusammengesetzt aus dem <code>codeSpec</code>-Fragment von <code>check:contracts --emit</code> (componentAPI, metadata, tokens) plus der Accessibility-Sektion aus <code>figma_scan_code_accessibility</code>; nicht übergebene Felder werden nicht verglichen, ein knapp befülltes <code>codeSpec</code> kommt ebenso sauber zurück. Findings an Claude zurückgeben und erneut prüfen. Gemeint ist der MCP-Call, nicht <code>npm run check:parity</code>: das Repo-Gate prüft die Atelier-Master aus <code>tools/figma/snapshot.json</code>, in denen die eigene Komponente nicht steht</li>
        <li><code>check:contracts</code> mit den eigenen Flags (<code>--fw</code>, <code>--contracts</code>, <code>--stories</code>, <code>--snapshot</code>) exit 0, und <code>nx storybook-test &lt;fw&gt;</code> grün — jede Story rendert in Chromium und besteht axe</li>
      </ol>
    </section>

