---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageEyebrow from '../../components/PageEyebrow.astro';
import { Code } from 'astro-expressive-code/components';
import BottomNav from '../../components/BottomNav.astro';
import Callout from '../../components/Callout.astro';
import {
  designPreviewCount,
  designReferenceFiles,
  designSkillVersion,
  designTokenCount,
  designTypeRoleCount,
  designTypefaces,
} from '../../lib/atelier-design-meta';

const SKILL_NAME = 'atelier-design';
const REPO_URL = 'https://github.com/DominikPieper/atelier-ui/tree/main/skills/atelier-design';

const INSTALL_FROM_REPO = `# The skill ships in the repo only — there is no published zip
git clone https://github.com/DominikPieper/atelier-ui.git
cp -r atelier-ui/skills/${SKILL_NAME} ~/.claude/skills/`;

const TRIGGER_EXAMPLES = `# Triggering examples — any of these will load the skill

"build me a slide deck for the Atelier workshop"
"mock up a docs chapter in the Atelier brand"
"make this prototype look like Atelier"
"which token do I use for a muted caption?"
"design a component preview card"`;

const TOKEN_USAGE = `/* Reference a composed role, not the individual axes. */
.caption {
  font: var(--ui-type-label);
  color: var(--ui-color-text-muted);
}

/* Theming is a token override — never a second hex. */
[data-theme='dark'] {
  --ui-color-primary: #34d8d8;
}`;

const surfaces = [
  {
    file: 'references/brand-guide.md',
    summary:
      'The source of truth the skill reads first: brand context, voice rules, visual foundations, iconography, UI-kit index, and the standalone-use caveats.',
  },
  {
    file: 'assets/colors_and_type.css',
    summary: `The complete token sheet — ${designTokenCount} --ui-* custom properties across light and dark, including the ${designTypeRoleCount} composed --ui-type-* roles. Generated byte-identical to the library's tokens.css and gated by check:tokens, so the skill cannot paint a retired brand.`,
  },
  {
    file: 'assets/logo.png',
    summary: 'The Atelier mark (pen + brush + capital A). PNG only — there is no SVG version.',
  },
  {
    file: 'preview/',
    summary: `${designPreviewCount} standalone design-system preview cards (type, colour, spacing, radii, shadows, components, brand). Auxiliary — not bundled in the distribution.`,
  },
  {
    file: 'ui_kits/docs-site/',
    summary:
      'A high-fidelity React/JSX recreation of this docs site’s landing page, with every value pulled from --ui-* tokens. Auxiliary — not bundled in the distribution.',
  },
];

// Drift gate: the table above is hand-curated, but it must cover every reference
// the skill ships. designReferenceFiles is read from the skill's references/
// directory at build time, so adding one without listing it fails the docs build.
const listedReferences = surfaces.filter((s) => s.file.startsWith('references/')).length;
if (listedReferences !== designReferenceFiles.length) {
  throw new Error(
    `atelier-design docs drift: this page lists ${listedReferences} references, ` +
      `but the skill ships ${designReferenceFiles.length} (see skills/atelier-design/references/).`,
  );
}
---

<BaseLayout
  title="atelier-design"
  description={`A Claude Code skill for generating well-branded Atelier interfaces, slides, and assets — voice rules, the ${designTokenCount}-token sheet, and the docs-site UI kit.`}
  currentPath="/skills/atelier-design"
>
  <div class="docs-inline-page">

    <div style="margin-bottom: 2.5rem">
      <PageEyebrow kind="reference" />
      <h1 class="docs-page-h1">
        atelier-design
      </h1>
      <p style="font-size: 0.9rem; color: var(--ui-color-text-muted); margin: 0 0 0.85rem; max-width: 640px; line-height: 1.65">
        A Claude Code skill that makes Claude an expert in the Atelier brand — for production
        handoffs and for throwaway mocks alike. It carries the voice rules, the full
        <code>--ui-*</code> token sheet, the logo, and a docs-site UI kit, so a generated slide,
        prototype, or docs chapter comes out in the shipped brand instead of a plausible-looking
        invention.
      </p>
      <div style="display: inline-flex; gap: 0.65rem; align-items: center; flex-wrap: wrap">
        <span style="font-family: monospace; font-size: 0.75rem; padding: 0.2rem 0.55rem; background: color-mix(in srgb, var(--ui-color-primary) 12%, transparent); border-radius: 999px; color: var(--ui-color-primary); font-weight: 600">v{designSkillVersion}</span>
        <span style="font-size: 0.75rem; color: var(--ui-color-text-muted)">{designTokenCount} tokens · {designTypeRoleCount} type roles · {designPreviewCount} preview cards · 1 UI kit</span>
      </div>
    </div>

    <!-- What it does -->
    <div class="docs-section">
      <h2 class="docs-section-title">What it does</h2>
      <p style="color: var(--ui-color-text-muted); line-height: 1.65; margin: 0 0 1.25rem; font-size: 0.85rem; max-width: 660px">
        The skill activates when someone asks for an Atelier-branded interface, asset, or mock. It
        reads <code>references/brand-guide.md</code> first, then loads only what the surface needs.
        Its rules are deliberately narrow, because the failure it exists to prevent is an agent
        inventing a colour that looks right: use <code>--ui-*</code> tokens, never hardcode hex;
        theming is a token override; component names carry the <code>Atl</code> prefix; no emoji,
        no exclamation marks.
      </p>

      <table class="docs-props-table">
        <thead>
          <tr><th>Typeface role</th><th>Family</th><th>Used for</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><code>--ui-font-family</code></td>
            <td>{designTypefaces.ui}</td>
            <td style="font-size: 0.82rem; color: var(--ui-color-text-muted); line-height: 1.55">Everything UI. Variable 400–700 — there is no 800 or 900 to reach for.</td>
          </tr>
          <tr>
            <td><code>--ui-font-display</code></td>
            <td>{designTypefaces.display}</td>
            <td style="font-size: 0.82rem; color: var(--ui-color-text-muted); line-height: 1.55">Display lines only, italic at weight 400. Never bolded — that rule is what <code>--ui-type-display</code> encodes.</td>
          </tr>
          <tr>
            <td><code>--ui-font-mono</code></td>
            <td>{designTypefaces.mono}</td>
            <td style="font-size: 0.82rem; color: var(--ui-color-text-muted); line-height: 1.55">Tokens, code samples, prop names, terminal mocks, kbd chips.</td>
          </tr>
        </tbody>
      </table>
      <p style="color: var(--ui-color-text-muted); line-height: 1.6; margin: 0.9rem 0 0; font-size: 0.78rem">
        The three families above are read out of the skill's own token sheet at build time, not
        typed into this page — so the page cannot describe a brand the skill no longer ships.
      </p>
    </div>

    <!-- Anchor colour + token usage -->
    <div class="docs-section">
      <h2 class="docs-section-title">The one rule that matters</h2>
      <p style="color: var(--ui-color-text-muted); line-height: 1.65; margin: 0 0 1rem; font-size: 0.85rem; max-width: 660px">
        The anchor colour is Conciso deep teal <code>#006470</code> in light, bright teal
        <code>#34d8d8</code> in dark. The broader <code>--ui-color-brand-*</code> palette exists for
        diagrams that need a third or fourth category — never for chrome. Everything else follows
        from referencing a token instead of a value.
      </p>
      <Code code={TOKEN_USAGE} lang="css" />
    </div>

    <!-- What ships -->
    <div class="docs-section">
      <h2 class="docs-section-title">What ships</h2>
      <table class="docs-props-table">
        <thead>
          <tr><th>File</th><th>Summary</th></tr>
        </thead>
        <tbody>
          {surfaces.map(({ file, summary }) => (
            <tr>
              <td><code style="font-size: 0.78rem; color: var(--ui-color-primary)">{file}</code></td>
              <td style="font-size: 0.82rem; color: var(--ui-color-text-muted); line-height: 1.55">{summary}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Install -->
    <div class="docs-section">
      <h2 class="docs-section-title">Install</h2>
      <Callout tone="note" title="Repo-only skill.">
        Unlike <a href="/skills/figma-workspace-architect" class="docs-link-primary">figma-workspace-architect</a>,
        this skill is not published to <code>/.well-known/agent-skills/</code> — there is no hosted
        <code>SKILL.md</code> and no zip. Install it from a clone.
      </Callout>
      <Code code={INSTALL_FROM_REPO} lang="shell" />
      <p style="color: var(--ui-color-text-muted); line-height: 1.65; margin: 1rem 0 0; font-size: 0.8rem">
        The skill needs no MCP server. If you are working in the Atelier repo itself it is already
        wired at <code>.claude/skills/atelier-design</code> (a symlink to
        <code>skills/atelier-design</code>), so Claude Code discovers it with no setup.
      </p>
    </div>

    <!-- Triggers -->
    <div class="docs-section">
      <h2 class="docs-section-title">When the skill loads</h2>
      <p style="color: var(--ui-color-text-muted); line-height: 1.65; margin: 0 0 1rem; font-size: 0.85rem; max-width: 640px">
        The skill is also <code>user-invocable</code>: called with no other guidance, it asks what
        you are building and for which surface (landing page / docs chapter / component preview /
        diagram) before designing anything.
      </p>
      <Code code={TRIGGER_EXAMPLES} lang="text" />
    </div>

    <!-- In the workshop -->
    <div class="docs-section">
      <h2 class="docs-section-title">In the workshop</h2>
      <p style="color: var(--ui-color-text-muted); line-height: 1.65; margin: 0; font-size: 0.85rem; max-width: 660px">
        On the two-day training this skill is the brand-consistency co-pilot for the day-two Figma
        block — the counterpart to <a href="/skills/figma-workspace-architect" class="docs-link-primary">figma-workspace-architect</a>,
        which handles the architecture. Architect decides whether something is a Variant or a
        Component Property; atelier-design decides whether it is the right teal.
      </p>
    </div>

    <!-- Source -->
    <div class="docs-section">
      <h2 class="docs-section-title">Source</h2>
      <dl class="docs-source-dl">
        <dt>Repository</dt>
        <dd><a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="docs-mono-link">{REPO_URL}</a></dd>
        <dt>Token sheet</dt>
        <dd>Generated from <code>libs/create-workspace/…/files/styles/tokens.css</code> by <code>tools/scripts/sync-tokens.mjs</code>; drift fails <code>npm run check:tokens</code>.</dd>
        <dt>License</dt>
        <dd>Same as the repository (MIT). The skill is <code>private: true</code> on npm and has no discovery URL — distribution is via the repo only.</dd>
      </dl>
    </div>

    <!-- Bottom nav -->
    <BottomNav items={[
      { to: '/agent-skills', label: 'Index',  title: 'All skills',       icon: 'robot_2' },
      { to: '/tokens',       label: 'Read',   title: 'Design tokens',    icon: 'palette' },
      { to: '/design-principles', label: 'Why', title: 'Design principles', icon: 'menu_book' },
    ]} />

  </div>
</BaseLayout>
