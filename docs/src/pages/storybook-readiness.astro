---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Code } from 'astro-expressive-code/components';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
import BottomNav from '../components/BottomNav.astro';

// Same severity vocabulary as /readiness.
type Severity = 'Cosmetic' | 'Degrading' | 'Blocks the agent';

interface Check {
  id: string;
  title: string;
  severity: Severity;
  what: string;
  why: string;
  how: string;
  fix: string[];
}

// Every check below was read against the output of Storybook 10.6.0 (the
// version this repo pins) for the Angular library: the markdown `docs-show`
// returns, the manifest behind it, and the formatter in
// node_modules/storybook/dist/shared/open-service/toolsets/docs/public.js.
// React (react-docgen) and Vue (vue-component-meta) fill the same slots from
// their own docgen; their output was not inspected for this page.

// Part A: checks you run on ONE component.
const COMPONENT_CHECKS: Check[] = [
  {
    id: 'description',
    title: 'The component class has a JSDoc description',
    severity: 'Blocks the agent',
    what: 'The component class (or, for React and Vue, the component) carries a JSDoc comment whose text says what the component is, when to use it and what to know before using it. A short <code>Usage:</code> block with a fenced example is welcome.',
    why: 'This text becomes the component’s <code>description</code> in the manifest. <code>docs-show</code> prints it under the heading, and <code>docs-list</code> prints its first 90 characters next to the id (a <code>@summary</code> tag in the JSDoc, if you write one, is printed there in full instead). A component without one is listed as a bare name, and the agent picks it by how the name sounds. Atelier adds one step on top: its build prepends the purpose sentence it owns in a metadata module, so the description starts with that sentence and the JSDoc follows. Your Storybook does not do that on its own; it prints the JSDoc.',
    how: 'Call <code>docs-list</code>. A line with no text after the id has no description. In the manifest report <code>components.html</code> (check S3) the component card carries the info “No description found”.',
    fix: [
      'Write the JSDoc directly above the component class. Make the first sentence carry the purpose: the list cuts the description at 90 characters, unless you give it a <code>@summary</code> tag, which it prints untruncated.',
      'Add one fenced <code>html</code> (or <code>tsx</code>, <code>vue</code>) usage example. It is part of the description, so it reaches the agent verbatim.',
      'If you keep the purpose sentence outside the JSDoc, as Atelier does, your Storybook will not show it to the agent until you carry it into the manifest. Atelier’s way, one of several: a generated name-to-purpose map, read by an <code>experimental_manifests</code> hook (React) or an <code>experimental_docgenProvider</code> worker (Angular and Vue), with a gate that fails when a built description does not start with the purpose. Both hooks are experimental Storybook API.',
      'Do not rely on <code>parameters.docs.description.component</code> in the stories. The manifest reads the JSDoc above the <code>meta</code> object or on the component, not that parameter (see “What the agent does not read”).',
    ],
  },
  {
    id: 'inputs',
    title: 'Every input has a JSDoc line, and defaults are real initial values',
    severity: 'Blocks the agent',
    what: 'Each <code>input()</code> (Angular) or prop (React, Vue) carries a one-line JSDoc comment. The default is the initial value in code, not a sentence in the comment.',
    why: 'The <code>Inputs</code> block is the agent’s only list of what it may set. Each entry shows the type, the JSDoc text above it and a <code>@default</code> line. A prop with no comment is a name and a type: the agent has to guess what it does.',
    how: '<code>docs-show</code> on the component: read the Inputs block. A property with no <code>/** … */</code> above it has no description. Atelier’s <code>check:storybook-manifests</code> fails a build for exactly that (<code>[NO-DESCRIPTION]</code>) on the props, inputs and outputs of the main component entries, except for a short list of reasoned exemptions. It does not look at Vue events or slots. Yours can do the same over <code>components.json</code>.',
    fix: [
      'Add <code>/** One sentence. */</code> above the declaration. Say what the input does and what it does not, not its type.',
      "Leave <code>@default</code> out of the comment. The generator reads the initial value (<code>input(false)</code>, <code>input&lt;'sm' | 'md'&gt;('md')</code>) and prints <code>@default</code> itself. Atelier’s button shows <code>@default primary</code> with no such tag in its source.",
      'Re-run <code>docs-show</code> and read the block again.',
    ],
  },
  {
    id: 'closed-values',
    title: 'Closed value sets are visible in the Inputs block',
    severity: 'Blocks the agent',
    what: "A prop that takes one of a few values shows those values in <code>docs-show</code>. An inline union (<code>'sm' | 'md'</code>) is printed in full. A type alias (<code>AtlButtonSize</code>) is printed as its name only.",
    why: 'The agent copies values from the Inputs block. When it sees only <code>size?: AtlButtonSize</code>, the values are nowhere in the component’s entry except in the story snippets, and only the first three stories that have a snippet show code. It then writes <code>size="large"</code>.',
    how: "<code>docs-show</code> on a component whose input is typed with an alias, and on one typed with an inline union. Atelier had both. AtlButton used to print <code>size?: AtlButtonSize;</code> and now prints <code>size?: \"sm\" | \"md\" | \"lg\";</code>, because its input is typed <code>input&lt;'sm' | 'md' | 'lg'&gt;('md')</code> instead of <code>input&lt;AtlButtonSize&gt;('md')</code>. Atelier has since given the same treatment to AtlToast, AtlChat, AtlChatMessage, AtlIcon <code>size</code> and the table header, so no short value set prints as a bare alias any more. One alias remains on purpose: AtlIcon <code>name</code> has 25 values, so it prints <code>name: AtlIconName;</code> and its JSDoc line says where the full list is (the <code>AllIcons</code> story). Customers will find the same defect in their own libraries; check for it.",
    fix: [
      'Prefer the inline union in the input’s type, or list the values in the input’s JSDoc line (<code>/** Size of the button: sm, md or lg. */</code>). JSDoc text is printed as written.',
      'Keep a shared alias if several components use it, and still name the values in the comment.',
      'Do not count on <code>argTypes</code> with <code>options</code> in the stories: AtlIcon declares <code>options</code> for name and the Inputs block shows only <code>name: AtlIconName;</code>; the values reach the agent through the JSDoc line, not through <code>argTypes</code>.',
    ],
  },
  {
    id: 'outputs',
    title:
      'Outputs and two-way bindings are declared with the framework’s own API',
    severity: 'Degrading',
    what: 'In Angular, events are <code>output()</code> and two-way state is <code>model()</code>, each with a JSDoc line. In React the callback props are typed; in Vue the emits are typed.',
    why: 'Angular’s manifest prints an <code>Outputs</code> block with each event’s payload type, and marks a two-way input with a <code>// two-way: [(checked)]</code> comment. That is the only place the agent learns the binding shape. A hand-rolled <code>EventEmitter</code> or a plain callback input is not described that way.',
    how: '<code>docs-show</code> on a component that emits (AtlCheckbox in Atelier): look for the <code>## Outputs</code> block and the <code>two-way</code> comments. Only Angular was inspected for this page.',
    fix: [
      'Replace <code>@Output() foo = new EventEmitter()</code> with <code>foo = output&lt;T&gt;()</code>, and a getter/setter pair with <code>model()</code>.',
      'Describe the event: when it fires and what the payload is.',
      'For React and Vue, run the same <code>docs-show</code> and check that the callbacks or emits appear with their types. UNVERIFIED here.',
    ],
  },
  {
    id: 'stories-per-value',
    title: 'One story per variant value and state, driven by args',
    severity: 'Degrading',
    what: 'Every value of every variant prop and every state (disabled, loading, invalid) has its own story. A story sets the value through <code>args</code>, not through hand-written markup in a custom render.',
    why: "The manifest turns each story into a code snippet from its args: Atelier’s <code>Secondary</code> story (<code>args: { variant: 'secondary' }</code>) becomes <code>[variant]=\"'secondary'\"</code> in a ready-to-paste component. These snippets are what the agent copies. A value that no story sets never appears as an example.",
    how: '<code>docs-show</code>: the story names under “Other Stories” are the list of values and states the agent knows about. Compare it with your prop types.',
    fix: [
      'Add a story for each missing value, with <code>args: { prop: value }</code> and nothing else.',
      'Name the story after the value or state (<code>Danger</code>, <code>Disabled</code>). The name is all the agent sees for a story past the third.',
      'If a story needs custom markup, give it its own name and keep the per-value stories args-only.',
    ],
  },
  {
    id: 'story-order',
    title: 'The three stories that come first are the ones to copy',
    severity: 'Degrading',
    what: 'The first three stories in the file are a default usage and the two most typical variations.',
    why: '<code>docs-show</code> prints complete code for the first three stories that have a snippet (the formatter’s limit is three, as long as the component has props). Every other story appears as a name and id only. The agent can ask for them with <code>docs-show-story</code>, but it only does so if it knows it needs them.',
    how: '<code>docs-show</code>: the stories under <code>## Stories</code> are your first three exports that have a snippet, in file order. An early export that produces no snippet is skipped and appears under “Other Stories” (on Atelier’s Vue AtlTable, the three shown are Empty State, Sticky Header and Playground, not the first three exports).',
    fix: [
      'Put <code>Default</code> first, then the next two most common usages. Move edge cases (<code>Playground</code>, <code>AllVariants</code>) to the end of the file.',
      'If one variant changes the markup shape (an icon-only button), make it one of the three.',
    ],
  },
  {
    id: 'snippets',
    title: 'Every story produces a complete snippet',
    severity: 'Degrading',
    what: 'The manifest can turn each story into code without running it. The render function and the args have to be readable statically.',
    why: 'When a story cannot be resolved, its snippet is incomplete or missing, and the agent has no example for that state. In Atelier’s built manifest, the report lists causes such as “<code>open</code> could not be provided, since the story declares no such arg”, and templates built from string interpolation that “could not be resolved statically”. The <code>cookbook</code> entry has stories listed by name with no code at all.',
    how: 'Open <code>components.html</code> (check S3) and filter by “incomplete snippets”. Or <code>docs-show</code> a component and look for stories listed by name only.',
    fix: [
      'Declare in <code>args</code> every input that the story’s template reads. “Declares no such arg” means the template uses a value the story never sets.',
      'Build the template with the framework’s helper (<code>argsToTemplate(args)</code> in Angular) rather than assembling a string by hand.',
      'Accept that composed, multi-component demos may stay name-only. Put the example in the component’s JSDoc instead, as a fenced block.',
    ],
  },
  {
    id: 'story-descriptions',
    title: 'A story that needs explaining says so, in a JSDoc comment above it',
    severity: 'Cosmetic',
    what: 'A story whose point is not obvious from its name has a JSDoc comment on its export.',
    why: 'The formatter prints a story’s description above its snippet, and beside its name in “Other Stories” (cut at 90 characters, unless the story has a <code>@summary</code> tag, which is printed in full). Reading the source of Storybook 10.6.0, that description comes from the JSDoc comment above the story export.',
    how: '<code>docs-show</code>: a description line above a snippet. UNVERIFIED in practice: none of Atelier’s stories carries one, so no output here shows it. Try it on one story and re-run.',
    fix: [
      'Add <code>/** Shown while a request is in flight. */</code> above <code>export const Loading</code>.',
      'Keep it to one line. It is a label, not documentation.',
    ],
  },
];

// Part B: checks on the setup around the components.
const SYSTEM_CHECKS: Check[] = [
  {
    id: 'manifest-emitted',
    title: 'The build emits a manifest with a real docgen pass',
    severity: 'Blocks the agent',
    what: 'The Storybook build writes <code>manifests/components.json</code> and its <code>meta.docgen</code> names the generator that read your components: <code>react-docgen</code>, <code>angular-component-meta</code> or <code>vue-component-meta</code>.',
    why: 'The MCP answers from this file and from nothing else. If it is missing or half-filled, <code>docs-list</code> returns empty or bare entries, and the agent falls back to reading source. Atelier once built a manifest in which every component carried only an id and a name, and the build was green (the gate for it is named <code>[DECOY]</code>).',
    how: 'Build Storybook and open <code>&lt;output&gt;/manifests/components.json</code>. Check <code>meta.docgen</code>, and that components carry a <code>description</code> and a <code>docgen</code> reference. Atelier’s <code>npm run check:storybook-manifests</code> does this for all three frameworks.',
    fix: [
      'In <code>.storybook/main.ts</code> set <code>features.componentsManifest: true</code> and add <code>@storybook/addon-mcp</code> to <code>addons</code>. React gets the manifest from <code>react-docgen</code> by default.',
      'Angular and Vue also need <code>features.experimentalDocgenServer: true</code>. It is the default under <code>@storybook/angular-vite</code> and opt-in for <code>@storybook/vue3-vite</code>. Atelier sets it explicitly for both.',
      'Rebuild and read <code>meta.docgen</code> again.',
    ],
  },
  {
    id: 'reachable',
    title: 'An agent can reach it, without a browser',
    severity: 'Blocks the agent',
    what: 'The manifest is served over MCP (<code>docs-list</code>, <code>docs-show</code>, <code>docs-show-story</code>), or an agent without MCP can call the Storybook CLI.',
    why: 'An agent that cannot call the tools reads the source instead, and everything on this page is moot.',
    how: 'With an MCP client: add the endpoint and call <code>docs-list</code>. Without one, the CLI needs no running Storybook: <code>npx storybook tools --config-dir &lt;your .storybook dir&gt; --json docs list</code>, then <code>docs show --input \'{"id":"&lt;id&gt;"}\'</code>. The CLI prints the manifest entry as JSON; the MCP prints the same data as markdown.',
    fix: [
      'Local: <code>@storybook/addon-mcp</code> serves <code>/mcp</code> on the dev server. Hosted: serve the built <code>manifests</code> folder behind an MCP worker, as Atelier does (see the Storybook page).',
      "Pass CLI arguments as <code>--input '{…}'</code> or <code>--key value</code>. A bare id is rejected with “Tool arguments must be passed as --key value flags”.",
    ],
  },
  {
    id: 'debug-page',
    title: 'You have looked at the manifest report',
    severity: 'Degrading',
    what: 'Storybook renders a report of its own manifest: one card per component with its API, stories and the problems it found.',
    why: 'It lists, for the whole library at once, what the checks above find one component at a time: components with no description, components without an API description, incomplete snippets, errors. It is quicker than calling <code>docs-show</code> thirty times.',
    how: 'On a dev server open <code>/manifests/components.html</code>. A built Storybook also writes it next to <code>components.json</code> (Atelier’s build does; a plain <code>storybook build</code> was not tried). The report’s pills filter by problem kind. Expect an info on every component asking for an <code>@import</code> tag: for Angular the snippets already include their import line, so you can ignore it there (not checked for React or Vue).',
    fix: [
      'Read the pills first, then open a component with a problem.',
      'On the dev server with <code>experimentalDocgenServer</code>, <code>/manifests/components.json</code> answers 404 by design (Storybook’s own message says so). Use the report or the CLI there.',
    ],
  },
  {
    id: 'ids',
    title: 'Story titles are stable and carry the category',
    severity: 'Cosmetic',
    what: 'A component’s id is built from its story <code>title</code>: <code>Components/Inputs/AtlButton</code> becomes <code>components-inputs-atlbutton</code>.',
    why: 'The agent must only use ids <code>docs-list</code> returned. A title you rename changes the id, and every prompt, rule file or note that mentions the old id breaks quietly. Category segments in the title show up in the id, which helps the agent tell two components with similar names apart.',
    how: '<code>docs-list</code>: read the ids. Look for ids that repeat a name or carry no category.',
    fix: [
      'Give every component a title with a category path and keep it fixed.',
      'If you must rename one, search your prompts and rule files for the old id first.',
    ],
  },
  {
    id: 'docs-pages',
    title:
      'Guidance that is not about one component sits in a docs entry, written as Markdown',
    severity: 'Degrading',
    what: 'Rules that span components (token names, spacing scale, “use X, not Y”) live in an MDX docs entry that <code>docs-list</code> shows under “Docs”.',
    why: '<code>docs-show</code> on a docs entry returns the MDX source as text. Atelier’s spacing page comes back with its import line and its JSX markup intact, which the agent has to read through. Prose and Markdown tables come through cleanly; a table built from a JSX array comes through as code.',
    how: '<code>docs-list</code>: the “Docs” section. Then <code>docs-show</code> on one entry and read what the agent reads.',
    fix: [
      'Put the facts the agent needs in Markdown (prose, lists, tables). Keep JSX for the visual demo.',
      'Where a token table must be generated, also state the token names in a plain list.',
    ],
  },
];

// What teams write in Storybook that the docs tools do not print. Each row was
// checked against the AtlButton output above.
const NOT_READ: { source: string; where: string; consequence: string }[] = [
  {
    source: '<code>parameters.docs.description.component</code>',
    where: 'The docs page in the browser.',
    consequence:
      'Not in the manifest description. In Atelier it holds the purpose sentence from the metadata module. The agent gets that sentence only because Atelier’s build prepends it to the manifest description (before that hook, <code>docs-show</code> printed the class JSDoc and the purpose sentence did not appear). Atelier’s lint rule <code>story-description-source</code> keeps the parameter in sync for the browser docs page, not for the agent.',
  },
  {
    source:
      '<code>argTypes</code> (<code>control</code>, <code>options</code>)',
    where: 'The Controls panel.',
    consequence:
      'Not in the Inputs block. AtlIcon declares <code>options</code> for name in its meta; the block shows <code>AtlIconName</code>.',
  },
  {
    source: '<code>parameters.design</code> (Figma links)',
    where: 'The Designs addon panel.',
    consequence: 'Not in the output.',
  },
  {
    source: '<code>play</code> functions and a11y parameters',
    where: 'The test runner (<code>storybook-test</code>).',
    consequence:
      'Not in the output. A <code>play</code> proves behaviour to you; the agent gets only the snippet.',
  },
  {
    source: 'Metadata outside the component (when-to-use, anti-patterns)',
    where: 'Atelier keeps them in <code>libs/spec/src/metadata/</code>.',
    consequence:
      'Not in the manifest. If you want the agent to see “use X, not Y”, write it in the component’s JSDoc.',
  },
];

// How Atelier automates these checks: pointers only, no counts.
const GATES: { check: string; gate: string }[] = [
  {
    check: 'Manifest exists, has a docgen pass, no empty entries',
    gate: '<code>check:storybook-manifests</code> (builds the three Storybooks, then reads <code>components.json</code>)',
  },
  {
    check: 'Every input has a description',
    gate: '<code>check:storybook-manifests</code> (<code>[NO-DESCRIPTION]</code>: props, inputs and outputs, with an exemption list; not Vue events or slots)',
  },
  {
    check: 'One story per variant value; story args match the manifest',
    gate: '<code>check:contracts</code>',
  },
  {
    check: 'Every story renders, its <code>play</code> holds, axe is clean',
    gate: '<code>storybook-test</code>',
  },
  {
    check: 'Anything else on this page',
    gate: 'No gate: use the self-check below',
  },
];

const SELF_CHECK_PROMPT = `Storybook readiness check, read-only. Do not edit any file.

Use the Storybook MCP of my library (docs-list, docs-show, docs-show-story).
Never guess an id: use only ids docs-list returned.

1. Call docs-list once. Report: components with no description text after
   the id; entries under "Docs".
2. Call docs-show for each component (if there are more than 15, take the
   first 10 and say which you skipped). For each, record:
   a. description present, and whether its first sentence states the purpose
   b. inputs/props without a description line above them
   c. props typed as a named alias whose values are not printed in the
      block, and where those values appear instead (if anywhere)
   d. events or two-way bindings the component has but the block lacks
   e. which stories are listed by name only because they have no snippet
   f. which variant values or states have no story (compare with the types)
   g. whether the first three stories are default usage plus the two most
      typical variations
3. Report a table: component, finding, which check it breaks
   (description, inputs, closed-values, outputs, stories-per-value,
   story-order, snippets), and how likely it is to make you write wrong
   code (high, medium, low).
4. Rank the findings. Name the single one that would make you invent a
   prop or a value, and say why.
5. List what you could not check. Do not propose or apply fixes.`;

const EXCERPT = `# AtlButton

ID: components-inputs-atlbutton

Primary action trigger. Renders a labelled button users press to commit an
action — submit a form, open a dialog, advance a flow.

Accessible button component with visual variants and sizes. An attribute
component on a native \`<button>\`: focus, Tab order, Enter/Space activation and
form submission are the browser's own.

Usage:
\`\`\`html
<button atl-button variant="primary" size="md" (click)="save()">Save</button>
<button atl-button variant="outline" [disabled]="true">Cancel</button>
<button atl-button type="submit" [loading]="isSaving">Saving…</button>
\`\`\`

## Inputs

\`\`\`
export type AtlButtonInputs = {
  /**
   * Shows a loading spinner, announces \`aria-busy\` and ignores activation.
   * The button stays focusable (ADR-0171).
   *
   * @default false
   */
  loading?: boolean;
  /**
   * Size of the button.
   *
   * @default md
   */
  size?: "sm" | "md" | "lg";
  …
}
\`\`\`

## Stories

### Primary

Story ID: components-inputs-atlbutton--primary

\`\`\`
import { Component } from '@angular/core';
import { AtlButton } from './atl-button';

@Component({
  selector: 'app-demo',
  imports: [AtlButton],
  template: \`
    <button
        atl-button
        [variant]="'primary'"
        [size]="'md'"
        [disabled]="false"
        [loading]="false">
        Button
    </button>\`,
})
export class DemoComponent {}
\`\`\`

…

### Other Stories

- Outline (components-inputs-atlbutton--outline)
- Danger (components-inputs-atlbutton--danger)
- Small (components-inputs-atlbutton--small)
…`;

const EXCERPT_MAP: { part: string; source: string }[] = [
  {
    part: '<code>ID: components-inputs-atlbutton</code>',
    source:
      'The story <code>title</code> in <code>atl-button.stories.ts</code> (<code>Components/Inputs/AtlButton</code>), lower-cased and joined with hyphens.',
  },
  {
    part: 'The paragraph and the <code>Usage:</code> block',
    source:
      'First the purpose sentence from the metadata module (Atelier’s build prepends it, followed by a blank line), then the JSDoc above <code>export class AtlButton</code> in <code>atl-button.ts</code>, word for word. The story meta’s <code>docs.description.component</code> is not used.',
  },
  {
    part: 'Each comment line inside <code>Inputs</code>',
    source:
      'The JSDoc above each <code>input()</code> in the class (<code>/** Size of the button. */</code>).',
  },
  {
    part: '<code>@default md</code>',
    source:
      "Generated from the initial value <code>input('md')</code>. The source comment has no <code>@default</code> tag.",
  },
  {
    part: '<code>size?: "sm" | "md" | "lg";</code>',
    source:
      'The input’s declared type. The source types it as an inline union, so the values are printed in full (check 3). With a type alias this line would show only the alias name.',
  },
  {
    part: 'The <code>Primary</code> snippet',
    source:
      "Generated from the story: <code>args: { variant: 'primary' }</code> merged over the meta’s default <code>args</code>, rendered through the meta’s <code>render</code> template (<code>argsToTemplate(args)</code>). The import line and the wrapping component are added by Storybook.",
  },
  {
    part: 'Which stories get code',
    source:
      'The first three exports in file order that have a snippet (<code>Default</code>, <code>Primary</code>, <code>Secondary</code>); the formatter stops at three. An export without a snippet is skipped and listed under Other Stories.',
  },
  {
    part: '<code>Other Stories</code>',
    source:
      'The remaining story exports, by name and id. No description is shown because none of these stories has a JSDoc comment.',
  },
];
---

<BaseLayout
  title="Is your Storybook ready for an agent?"
  description="A checklist for an existing Storybook: what the component source and the stories must deliver so the Storybook MCP gives an agent a useful answer, and how to check it yourself."
  currentPath="/storybook-readiness"
  tocItems={[
    { id: 'how-to-use', label: 'How to use this page' },
    { id: 'excerpt', label: 'What docs-show returns' },
    { id: 'component-checks', label: 'Part A: the component' },
    { id: 'system-checks', label: 'Part B: the setup' },
    { id: 'not-read', label: 'What the agent does not read' },
    { id: 'self-check', label: 'Exercise: check your Storybook' },
    { id: 'automate', label: 'Automating it' },
  ]}
>
  <div class="docs-inline-page">
    <PageHero
