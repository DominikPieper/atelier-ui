---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Code } from 'astro-expressive-code/components';
import PageHero from '../components/PageHero.astro';
const SITE_URL = 'https://atelier.pieper.io';

const MCP_CONFIG = `{
  "mcpServers": {
    "storybook-react": {
      "type": "http",
      "url": "${SITE_URL}/storybook-react/mcp"
    },
    "storybook-angular": {
      "type": "http",
      "url": "${SITE_URL}/storybook-angular/mcp"
    },
    "storybook-vue": {
      "type": "http",
      "url": "${SITE_URL}/storybook-vue/mcp"
    }
  }
}`;

const STORYBOOK_LINKS = [
  // Text color comes from a per-framework CSS class that picks an AA-safe
  // shade per theme.
  {
    name: 'React',
    pkg: '@atelier-ui/react',
    href: `${SITE_URL}/storybook-react/`,
    textClass: 'storybook-card--react',
  },
  {
    name: 'Angular',
    pkg: '@atelier-ui/angular',
    href: `${SITE_URL}/storybook-angular/`,
    textClass: 'storybook-card--angular',
  },
  {
    name: 'Vue',
    pkg: '@atelier-ui/vue',
    href: `${SITE_URL}/storybook-vue/`,
    textClass: 'storybook-card--vue',
  },
];
---

<BaseLayout
  title="Storybook"
  description="How Atelier UI uses Storybook as a live component explorer — stories per framework, MCP-backed docs, and what a green story test does and does not prove."
  currentPath="/storybook"
>
  <div class="docs-inline-page">
    <PageHero
      title="Storybook"
      lede="Interactive component explorers for Angular, React, and Vue. Browse stories, inspect props, and test accessibility in isolation."
      ledeMax="520px"
    />

    <!-- Framework cards -->
    <div
      style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.85rem;
        margin-bottom: 3rem;
      "
    >
      {STORYBOOK_LINKS.map(({ name, pkg, href, textClass }) => <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        style={`display: flex; flex-direction: column; gap: 0.5rem; padding: 1.1rem 1.1rem 0.9rem; background: var(--ui-color-surface-raised); border-radius: var(--ui-radius-md); text-decoration: none; border: 1px solid var(--ui-color-border); transition: background var(--ui-transition-fast)`}
        class={`storybook-card ${textClass}`}
      >
        <div style="display: flex; align-items: center; gap: 0.5rem">
          <span class="storybook-card__name">{name}</span>
        </div>
        <span
          style="
            font-family: monospace;
            font-size: var(--ui-font-size-xs);
            color: var(--ui-color-text-muted);
          "
          >{pkg}</span
        >
        <span class="storybook-card__cta">Open</span>
      </a>)}
    </div>

    <!-- MCP section -->
    <div>
      <h2 class="docs-section-title">MCP server</h2>
      <p
        style="
          margin: 0 0 1.75rem;
          color: var(--ui-color-text-muted);
          line-height: 1.65;
        "
      >
        All three Storybook instances expose a hosted MCP endpoint so AI coding
        assistants can read component documentation directly — no local setup
        required.
      </p>

      <div class="docs-step-list">
        <!-- Step 01 -->
        <div class="docs-step-row">
          <span class="docs-step-badge">01</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">Add the MCP server to your project</h3>
            <p class="docs-step-desc">
              In your AI assistant's MCP configuration (e.g.
              <code>.mcp.json</code> at the project root for Claude Code) add
              one or more servers:
            </p>
            <Code code={MCP_CONFIG} lang="json" />
          </div>
        </div>

        <!-- Step 02 -->
        <div class="docs-step-row">
          <span class="docs-step-badge">02</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">Use it in your prompts</h3>
            <p class="docs-step-desc">
              Once connected, your AI assistant can look up component props,
              variants, and usage examples directly from Storybook:
            </p>
            <Code
              code={`Build a settings page using @atelier-ui/<your framework> components.\nUse the storybook-<your framework> MCP to check available props.`}
              lang="text"
            />
          </div>
        </div>

        <!-- Step 03 -->
        <div class="docs-step-row">
          <span class="docs-step-badge">03</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">Two MCP surfaces, three toolsets</h3>
            <p class="docs-step-desc">
              Storybook ships MCP in two layers — added in 10.4, with the tool
              surface renamed and the manifests made framework-native at 10.6.0,
              the version this repo pins. The <strong>hosted</strong> endpoint
              serves docs from a static manifest — works for any framework, no
              install. The <strong>local dev</strong> surface adds dev &amp;
              test tools while a local Storybook is running; under 10.6 it is no
              longer React-only in practice — a locally-run Angular or Vue
              Storybook answers the same eight-tool surface React does. Tools
              are grouped into three <strong>toolsets</strong> (<code>dev</code
              >, <code>docs</code>, <code>test</code>), each toggleable in the
              addon options.
            </p>
            <table class="docs-props-table">
              <thead>
                <tr>
                  <th>Toolset</th>
                  <th>Tool</th>
                  <th>Hosted (atelier.pieper.io)</th>
                  <th>Local dev (<code>nx storybook &lt;fw&gt;</code>)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td rowspan="3"><code>docs</code></td>
                  <td><code>docs-list</code></td>
                  <td>All three: components + docs</td>
                  <td>All frameworks</td>
                </tr>
                <tr>
                  <td><code>docs-show</code></td>
                  <td>All three: full, each framework-native</td>
                  <td>All frameworks</td>
                </tr>
                <tr>
                  <td><code>docs-show-story</code></td>
                  <td>All three: full, each framework-native</td>
                  <td>All frameworks</td>
                </tr>
                <tr>
                  <td rowspan="5"><code>dev</code></td>
                  <td><code>get-storybook-story-instructions</code></td>
                  <td>—</td>
                  <td>All three (10.6)</td>
                </tr>
                <tr>
                  <td><code>stories-preview</code></td>
                  <td>—</td>
                  <td>All three (10.6)</td>
                </tr>
                <tr>
                  <td><code>stories-changed</code> <em>(10.4)</em></td>
                  <td>—</td>
                  <td>Requires <code>features.changeDetection</code></td>
                </tr>
                <tr>
                  <td><code>stories-find-by-component</code></td>
                  <td>—</td>
                  <td>
                    Requires a builder that exposes the module-graph service
                  </td>
                </tr>
                <tr>
                  <td><code>review-create</code></td>
                  <td>—</td>
                  <td>
                    Requires <code>features.changeDetection</code> (and
                    <code>experimentalReview</code> not disabled)
                  </td>
                </tr>
                <tr>
                  <td><code>test</code></td>
                  <td><code>test-run</code></td>
                  <td>—</td>
                  <td>
                    Requires <code>@storybook/addon-vitest</code>; a11y via
                    <code>@storybook/addon-a11y</code>
                  </td>
                </tr>
              </tbody>
            </table>
            <p class="docs-step-desc" style="margin-top: 0.75rem">
              The hosted endpoint reads <code>manifests/components.json</code>,
              which the Storybook build writes once
              <code>@storybook/addon-mcp</code> is installed — the addon
              switches the <code>componentsManifest</code> feature on through
              its own preset. Since Storybook 10.6, all three framework packages
              fill that file for real: React via <code>react-docgen</code> (its
              default all along), Angular via
              <code>@storybook/angular-vite</code>'s
              <code>angular-component-meta</code>, and Vue via
              <code>@storybook/vue3-vite</code>'s
              <code>vue-component-meta</code> — both behind
              <code>experimentalDocgenServer</code>, which this repo sets
              explicitly (ADR-0097, superseding the React-manifest fallback
              ADR-0083 describes). An Angular or Vue lookup now returns real
              variants, defaults and state props already shaped for that
              framework: two-way <code>[(checked)]</code> bindings and split
              Inputs/Outputs for Angular, <code>v-model</code
              >/<code>update:*</code> events and typed slots for Vue — no more
              <code>children</code> or <code>onCheckedChange</code> outside the
              React endpoint. <code>check:storybook-manifests</code> gates all
              three builds so a regression back to a decoy or empty manifest
              fails offline before it reaches the hosted surface.
            </p>
            <p class="docs-step-desc" style="margin-top: 0.5rem">
              The dev / test toolsets require a running Node.js Storybook dev
              server, and under 10.6 that surface answers on all three
              frameworks — not the React-only preview scope of earlier versions.
              Their per-tool gates are capability checks rather than framework
              checks — <code>stories-find-by-component</code> wants a builder
              that exposes the module graph, <code>stories-changed</code> and
              <code>review-create</code> want
              <code>features.changeDetection</code>, <code>test-run</code> wants
              <code>@storybook/addon-vitest</code>. <code>docs</code> tools
              support a <code>storybookId</code> parameter to scope a request to
              one source in multi-source (composition) setups;
              <code>docs-list</code> accepts <code>withStoryIds: true</code>
              when downstream tools need story IDs.
            </p>
          </div>
        </div>

        <!-- Step 04: 10.4 highlights -->
        <div class="docs-step-row">
          <span class="docs-step-badge">04</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">What Storybook 10.4 added to MCP</h3>
            <p class="docs-step-desc">
              The 10.4 release — together with the <code>@storybook/mcp</code>
              versions that shipped alongside it — tightens the agentic loop on
              six fronts, all still in place at the pinned 10.6.0:
            </p>
            <table class="docs-props-table">
              <thead>
                <tr>
                  <th>Capability</th>
                  <th>What it does</th>
                  <th>How to enable</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>experimentalReactComponentMeta</code> (RCM)</td>
                  <td>
                    Volar + TypeScript Language Server docgen replaces
                    <code>react-docgen</code> /
                    <code>react-docgen-typescript</code> — faster, better
                    detection, faster dev-mode HMR for prop edits. When enabled
                    it is also the engine behind React&apos;s
                    <code>components.json</code>; Atelier leaves it off, so that
                    manifest is built by <code>react-docgen</code> — the
                    file&apos;s own <code>meta.docgen</code> field names
                    whichever engine ran.
                  </td>
                  <td>
                    <code>experimentalReactComponentMeta: true</code> in
                    <code>.storybook/main.ts</code> (React).
                    <code>@storybook/mcp@0.6.2+</code> reads the new
                    <code>reactComponentMeta</code> payload automatically.
                  </td>
                </tr>
                <tr>
                  <td>
                    Change Review sidebar &amp; <code>stories-changed</code>
                  </td>
                  <td>
                    Storybook tracks <em>new</em>, <em>modified</em>, and
                    <em>affected</em> stories. The MCP tool returns just that
                    subset so agents can scope review to recent edits.
                  </td>
                  <td>
                    Set <code>features.changeDetection: true</code> in
                    <code>.storybook/main.ts</code>. Tool registers
                    automatically.
                  </td>
                </tr>
                <tr>
                  <td>Multi-source composition + OAuth</td>
                  <td>
                    Compose several Storybooks behind one MCP endpoint via
                    Storybook refs. The addon serves
                    <code>/.well-known/oauth-protected-resource</code> and
                    accepts bearer tokens so agents can reach private composed
                    Storybooks.
                  </td>
                  <td>
                    Add <code>refs</code> to <code>.storybook/main.ts</code>;
                    pass <code>storybookId</code> to docs tools to disambiguate.
                  </td>
                </tr>
                <tr>
                  <td>MCP Apps preview resource</td>
                  <td>
                    <code>stories-preview</code> exposes a
                    <code>ui://stories-preview/preview.html</code> resource so
                    MCP-Apps-capable hosts render the story preview inline in
                    chat (Cursor, Claude Desktop with MCP Apps). Non-capable
                    hosts get the <code>previewUrl</code> per story instead.
                  </td>
                  <td>Automatic when the host advertises MCP Apps support.</td>
                </tr>
                <tr>
                  <td>Subcomponent docs</td>
                  <td>
                    <code>docs-show</code> surfaces subcomponent props for
                    compound components.
                  </td>
                  <td>
                    <code>@storybook/mcp@0.7.0+</code> &amp;
                    <code>@storybook/addon-mcp@0.6.0+</code>. No config.
                  </td>
                </tr>
                <tr>
                  <td>
                    Self-host API (<code>createStorybookMcpHandler</code>)
                  </td>
                  <td>
                    Reusable docs handler for serving manifests from any runtime
                    (Cloudflare Workers, Netlify Functions, Node). Hooks:
                    <code>manifestProvider</code>,
                    <code>onListAllDocumentation</code>,
                    <code>onGetDocumentation</code>,
                    <code>onSessionInitialize</code>. Tool-registration exports
                    (<code>addListAllDocumentationTool</code>, etc.) for custom
                    <code>tmcp</code> servers.
                  </td>
                  <td>
                    <code
                      >import &#123; createStorybookMcpHandler &#125; from
                      '@storybook/mcp'</code
                    >. See <code>worker/mcp.ts</code> in this repo.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Step 05: Toolset config -->
        <div class="docs-step-row">
          <span class="docs-step-badge">05</span>
          <div class="docs-step-body">
            <h3 class="docs-h3" id="toolset-configuration">
              Toolset configuration
            </h3>
            <p class="docs-step-desc">
              All three toolsets default to <code>true</code>. Disable a toolset
              when an agent should not see those tools — e.g. read-only agents:
            </p>
            <Code
              code={`// .storybook/main.ts
import type { StorybookConfig } from '@storybook/react-vite';

const config: StorybookConfig = {
  addons: [
    {
      name: '@storybook/addon-mcp',
      options: {
        toolsets: {
          dev: true,    // stories-preview, get-storybook-story-instructions, stories-changed
          docs: true,   // docs-list, docs-show, docs-show-story
          test: false,  // disable test-run for read-only agents
        },
      },
    },
  ],
  features: {
    componentsManifest: true,             // gates the manifest write + docs toolset
    changeDetection: true,                // gates stories-changed
  },
};

export default config;`}
              lang="ts"
            />
            <p class="docs-step-desc" style="margin-top: 0.5rem">
              Telemetry is on by default — disable with Storybook&apos;s
              <code>core.disableTelemetry</code>.
            </p>
          </div>
        </div>

        <!-- Step 06 -->
        <div class="docs-step-row">
          <span class="docs-step-badge">06</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">Endpoints</h3>
            <table class="docs-props-table" style="margin-top: 0.25rem">
              <thead>
                <tr>
                  <th>Library</th>
                  <th>Hosted URL</th>
                  <th>Local dev URL</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>@atelier-ui/react</code></td>
                  <td><code>{SITE_URL}/storybook-react/mcp</code></td>
                  <td><code>http://localhost:4401/mcp</code></td>
                </tr>
                <tr>
                  <td><code>@atelier-ui/angular</code></td>
                  <td><code>{SITE_URL}/storybook-angular/mcp</code></td>
                  <td><code>http://localhost:4400/mcp</code></td>
                </tr>
                <tr>
                  <td><code>@atelier-ui/vue</code></td>
                  <td><code>{SITE_URL}/storybook-vue/mcp</code></td>
                  <td><code>http://localhost:4402/mcp</code></td>
                </tr>
              </tbody>
            </table>
            <p class="docs-step-desc" style="margin-top: 0.5rem">
              In a clone of the atelier monorepo, each framework's Storybook
              binds its own port — angular 4400, react 4401, vue 4402 — so all
              three can run at once; read the exact port from the terminal that
              started it. A scaffolded workspace ships only one framework, and
              its Storybook binds the single port <code>6006</code>.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- CLI section -->
    <div>
      <h2 id="cli" class="docs-section-title">CLI</h2>
      <p
        style="
          margin: 0 0 1.75rem;
          color: var(--ui-color-text-muted);
          line-height: 1.65;
        "
      >
        Everything above is MCP. The <code>storybook</code> binary itself is
        bigger than that, and almost none of the rest is what this repo actually
        runs — Nx wraps <code>dev</code> and <code>build</code>, and Vitest
        replaces the test command entirely. What follows was read from the
        installed <code>storybook@10.6.0</code> package's own dispatcher and
        command registration (<code>node_modules/storybook/dist/bin/</code>,
        plus <code>@storybook/cli@10.6.0</code> fetched on demand), not from
        release notes, and exercised directly against this repo everywhere
        marked <strong>verified</strong>.
      </p>

      <div class="docs-step-list">
        <!-- Step 01 -->
        <div class="docs-step-row">
          <span class="docs-step-badge">01</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">One command, two packages</h3>
            <p class="docs-step-desc">
              <code>storybook</code>'s own <code>bin/dispatcher.js</code>
              inspects <code>argv[0]</code> before anything else:
              <code>dev</code>, <code>build</code>, <code>index</code>,
              <code>ai</code>, <code>tools</code> and <code>skills</code> import
              <code>storybook/dist/bin/core.js</code> directly — the exact
              10.6.0 already sitting in this repo's <code>node_modules</code>,
              nothing to fetch. Every other subcommand is handed to a
              <em>separate</em> package, <code>@storybook/cli</code>, pinned to
              the identical version but
              <strong>not a dependency of this repo</strong> — dispatcher.js
              tries to resolve it, fails, and falls back to running it through
              the package manager's remote-package path. Verified:
              <code>npx storybook doctor</code> here fetches
              <code>@storybook/cli@10.6.0</code> from the registry on first use,
              the same way <code>npx storybook@10.6.0 doctor</code> would in a
              project that had never installed Storybook at all. One footgun
              this split creates: plain <code>storybook --help</code> only ever
              shows the <code>@storybook/cli</code> command list
              (<code>init</code>, <code>add</code>, …) — <code>dev</code>,
              <code>build</code>, <code>index</code>, <code>ai</code>,
              <code>tools</code> and <code>skills</code> never appear there,
              because dispatcher.js only checks <code>argv[0]</code> against
              that fixed list and <code>--help</code> doesn't match it, so it
              falls through to the other package. Each of the six has its own
              working <code>--help</code>; the top-level one just doesn't list
              them.
            </p>
            <table class="docs-props-table">
              <thead>
                <tr>
                  <th>Command</th>
                  <th>Package</th>
                  <th>Needs</th>
                  <th>What it does</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>dev</code></td>
                  <td><code>storybook</code> (local)</td>
                  <td>nothing beyond <code>node_modules</code></td>
                  <td>
                    Dev server. This repo's <code>nx storybook &lt;fw&gt;</code>
                    target.
                  </td>
                </tr>
                <tr>
                  <td><code>build</code></td>
                  <td><code>storybook</code> (local)</td>
                  <td>nothing beyond <code>node_modules</code></td>
                  <td>
                    Static build; with <code>componentsManifest</code> on, also
                    writes <code>manifests/components.json</code>. This repo's
                    <code>nx build-storybook &lt;fw&gt;</code> target.
                  </td>
                </tr>
                <tr>
                  <td><code>index</code></td>
                  <td><code>storybook</code> (local)</td>
                  <td>nothing beyond <code>node_modules</code></td>
                  <td>
                    Writes a lightweight story index (titles, story IDs, tags,
                    import paths) via <code>StoryIndexGenerator</code> — no
                    docgen, no manager, no preview bundle, and no relation to
                    <code>manifests/components.json</code> despite the similar
                    name (Step 06).
                  </td>
                </tr>
                <tr>
                  <td><code>ai</code></td>
                  <td><code>storybook</code> (local)</td>
                  <td>nothing beyond <code>node_modules</code></td>
                  <td>
                    Deprecated — its own <code>--help</code> says "AI agent
                    helpers for Storybook (deprecated — see
                    <code>storybook skills</code>)".
                  </td>
                </tr>
                <tr>
                  <td><code>tools</code></td>
                  <td><code>storybook</code> (local)</td>
                  <td>
                    nothing beyond <code>node_modules</code>; some tools need a
                    running Storybook
                  </td>
                  <td>
                    CLI door into the same toolset
                    <code>@storybook/addon-mcp</code> serves over HTTP (Step
                    03).
                  </td>
                </tr>
                <tr>
                  <td><code>skills</code></td>
                  <td><code>storybook</code> (local)</td>
                  <td>nothing beyond <code>node_modules</code></td>
                  <td>
                    Prints agent instructions generated from the target
                    Storybook's own config. Not the tool ADR-0123 uses (Step
                    04).
                  </td>
                </tr>
                <tr>
                  <td><code>init</code></td>
                  <td><code>@storybook/cli</code> (network)</td>
                  <td>registry fetch, then a package install</td>
                  <td>
                    Scaffold Storybook into a project without it. Long-standing,
                    not used here.
                  </td>
                </tr>
                <tr>
                  <td>
                    <code>add &lt;addon&gt;</code> /
                    <code>remove &lt;addon&gt;</code>
                  </td>
                  <td><code>@storybook/cli</code> (network)</td>
                  <td>registry fetch + install</td>
                  <td>
                    Install or uninstall one addon and wire <code>main.ts</code
                    >. Long-standing, not used here.
                  </td>
                </tr>
                <tr>
                  <td><code>upgrade</code></td>
                  <td><code>@storybook/cli</code> (network)</td>
                  <td>
                    registry fetch + install —
                    <strong>even with <code>--dry-run</code></strong> (Step 05)
                  </td>
                  <td>
                    Bump every Storybook package to the CLI's own version, then
                    run automigrations and <code>doctor</code>. Long-standing,
                    not used here.
                  </td>
                </tr>
                <tr>
                  <td><code>automigrate [fixId]</code></td>
                  <td><code>@storybook/cli</code> (network)</td>
                  <td>
                    registry fetch; no install unless a fix actually succeeds
                  </td>
                  <td>
                    Detect and optionally apply known upgrade fixups.
                    Long-standing, not used here.
                  </td>
                </tr>
                <tr>
                  <td><code>doctor</code></td>
                  <td><code>@storybook/cli</code> (network)</td>
                  <td>registry fetch only — read-only otherwise (Step 05)</td>
                  <td>
                    Static dependency/config health check. Long-standing, not
                    used here.
                  </td>
                </tr>
                <tr>
                  <td>
                    <code>info</code> / <code>migrate</code> /
                    <code>sandbox</code>|<code>repro</code> / <code>link</code>
                  </td>
                  <td><code>@storybook/cli</code> (network)</td>
                  <td>registry fetch; varies</td>
                  <td>
                    Environment report; standalone codemods; template sandboxes;
                    contributor repro linking. Long-standing, not used here.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Step 02 -->
        <div class="docs-step-row">
          <span class="docs-step-badge">02</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">What's new for the CLI at 10.5 → 10.6</h3>
            <p class="docs-step-desc">
              Three changes, all confirmed against the installed dist rather
              than the changelog:
            </p>
            <table class="docs-props-table">
              <thead>
                <tr>
                  <th>Change</th>
                  <th>Evidence</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    <code>storybook ai</code> deprecated in favour of
                    <code>storybook skills</code>
                  </td>
                  <td>
                    Verified: the <code>ai</code> command's own
                    <code>--help</code> prints the deprecation notice;
                    <code>ai setup</code>'s says "deprecated: use
                    <code>storybook skills setup</code>".
                  </td>
                </tr>
                <tr>
                  <td><code>storybook tools</code> made public</td>
                  <td>
                    Storybook's own 10.6.0 release material describes it as
                    newly public (announced, not independently re-verified
                    beyond the command existing and working in this dist).
                    Structurally it is real: <code>bin/dispatcher.js</code>
                    routes <code>tools</code> the same way it routes
                    <code>dev</code>/<code>build</code>, and it answers with a
                    full tool surface (Step 03).
                  </td>
                </tr>
                <tr>
                  <td>
                    A new <code>automigrate</code> fix, <code>addon-mcp</code>,
                    fires whenever any AI coding agent is detected
                  </td>
                  <td>
                    Verified by reading the fix
                    (<code>src/automigrate/fixes/addon-mcp.ts</code>) and by
                    running it (Step 05): its <code>check()</code> calls
                    <code>detectAgent()</code> and returns non-null — meaning
                    "applicable" — whenever an agent is detected,
                    <em
                      >regardless of whether <code>@storybook/addon-mcp</code>
                      is already installed at the correct pinned version</em
                    >.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Step 03 -->
        <div class="docs-step-row">
          <span class="docs-step-badge">03</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">
              <code>storybook tools</code> — the CLI door into the MCP toolset
            </h3>
            <p class="docs-step-desc">
              <code>storybook tools</code> exposes almost the same functions as
              <code>@storybook/addon-mcp</code>, callable from a plain shell —
              useful for Codex or the Antigravity CLI, which have no MCP client
              wired to this repo's Storybooks (<code>.mcp.json</code> only
              speaks Claude Code's MCP protocol). Verified command and output,
              run against this repo without a dev server:
            </p>
            <Code
              code={`$ npx storybook tools --config-dir libs/react/.storybook --json docs list
{ "manifests": { "componentManifest": { "components": {
  "components-inputs-atlbutton": { "id": "…", "name": "AtlButton", "reactDocgen": { … }, … }
  # … one entry per component, real props inline
} } } }`}
              lang="text"
            />
            <p class="docs-step-desc" style="margin-top: 0.5rem">
              Note the option order: global flags (<code>--config-dir</code>,
              <code>--json</code>, <code>-o</code>) go <em>before</em> the
              toolset and tool name — <code>tools --config-dir … docs list</code
              >, not <code>tools docs list --config-dir …</code> (verified the
              hard way: the latter silently falls back to
              <code>./.storybook</code> and fails).
            </p>
            <table class="docs-props-table" style="margin-top: 0.75rem">
              <thead>
                <tr>
                  <th>CLI subcommand</th>
                  <th>MCP tool it matches</th>
                  <th>Needs</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    <code>docs list</code> / <code>docs show</code> /
                    <code>docs show-story</code>
                  </td>
                  <td>
                    <code>docs-list</code> / <code>docs-show</code> /
                    <code>docs-show-story</code>
                  </td>
                  <td>
                    local — config dir only (real docgen for React; not for
                    Angular/Vue without a running server, Step 06)
                  </td>
                </tr>
                <tr>
                  <td>
                    <code>stories changed</code> /
                    <code>stories find-by-component</code>
                  </td>
                  <td>
                    <code>stories-changed</code> /
                    <code>stories-find-by-component</code>
                  </td>
                  <td>local</td>
                </tr>
                <tr>
                  <td><code>stories preview</code></td>
                  <td><code>stories-preview</code></td>
                  <td>requires a running Storybook</td>
                </tr>
                <tr>
                  <td><code>review create</code></td>
                  <td>
                    <code>review-create</code> (hyphenated MCP id; two words as
                    a CLI subcommand)
                  </td>
                  <td>requires a running Storybook</td>
                </tr>
                <tr>
                  <td><code>test run</code></td>
                  <td><code>test-run</code></td>
                  <td>local, needs <code>@storybook/addon-vitest</code></td>
                </tr>
                <tr>
                  <td><em>(none)</em></td>
                  <td><code>get-storybook-story-instructions</code></td>
                  <td>
                    MCP-only — the CLI's equivalent is
                    <code>storybook skills stories</code
                    >/<code>write-story</code> instead (Step 04), a different
                    mechanism, not a <code>tools</code> subcommand
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Step 04 -->
        <div class="docs-step-row">
          <span class="docs-step-badge">04</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">
              Two tools, same word: <code>storybook skills</code> vs.
              <code>skills add</code>
            </h3>
            <p class="docs-step-desc">
              Easy to conflate, verified as genuinely different:
            </p>
            <table class="docs-props-table">
              <thead>
                <tr>
                  <th></th>
                  <th><code>npx storybook skills [id]</code></th>
                  <th><code>npx skills add storybookjs/mcp</code></th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Package</td>
                  <td>
                    <code>storybook</code> itself (10.6.0, already installed)
                  </td>
                  <td>
                    a third, unrelated npm package literally named
                    <code>skills</code> (pinned <code>1.5.25</code> per
                    ADR-0123)
                  </td>
                </tr>
                <tr>
                  <td>What it does</td>
                  <td>
                    Prints markdown instructions — <code>stories</code>,
                    <code>write-story</code>, <code>setup</code> — assembled
                    live from <em>this</em> target Storybook's own config
                    (framework, feature flags)
                  </td>
                  <td>
                    Clones the <code>storybookjs/mcp</code> GitHub repo and
                    installs its <code>SKILL.md</code> files into
                    <code>.claude/skills/</code> (or another agent's skill
                    directory)
                  </td>
                </tr>
                <tr>
                  <td>Writes files?</td>
                  <td>No — stdout, or <code>-o &lt;path&gt;</code> if asked</td>
                  <td>Yes — that is its entire job</td>
                </tr>
                <tr>
                  <td>Used in this repo?</td>
                  <td>No</td>
                  <td>
                    Yes — <code>libs/create-workspace</code>'s preset shells out
                    to exactly this command post-scaffold (ADR-0123)
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Step 05 -->
        <div class="docs-step-row">
          <span class="docs-step-badge">05</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">Candidates weighed for this repo</h3>
            <p class="docs-step-desc">
              <strong><code>doctor</code> — worth adding, cheap.</strong>
              Verified by running it
              (<code
                >npx storybook doctor --config-dir libs/react/.storybook</code
              >: "Your Storybook project looks good!"). It statically checks
              five things — missing Storybook dependency, incompatible packages,
              mismatched Storybook versions, duplicated dependencies, and
              config-load errors — reading <code>package.json</code
              >/<code>node_modules</code>/<code>main.ts</code>. No build, no dev
              server. The only cost is the same one every
              <code>@storybook/cli</code> command pays here: a registry fetch,
              since the package isn't vendored (Step 01) — a real cost for an
              offline gate chain, and the reason it isn't proposed as a
              <code>check:all</code> step without first vendoring
              <code>@storybook/cli</code> as a dependency.
            </p>
            <p class="docs-step-desc" style="margin-top: 0.75rem">
              <strong
                ><code>automigrate</code> / <code>upgrade</code> — not for this
                repo, and riskier than the flags suggest.</strong
              >
              Verified by running <code>automigrate --dry-run</code> against
              this repo (safe: every fix's <code>run()</code> gates its writes
              on <code>dryRun</code>, confirmed by reading every fix in
              <code>@storybook/cli</code>'s bundle). Even on an already-current,
              exact-pinned 10.6.0 setup it found two applicable fixes:
              <code>addon-mcp</code> — which would re-install
              <code>@storybook/addon-mcp</code> to "latest" purely because it
              detects an AI coding agent running, not because the pin is wrong —
              and <code>wrap-getAbsolutePath</code>, which would rewrite all
              three <code>.storybook/main.ts</code> files' addon/framework
              references into <code>getAbsolutePath(...)</code> call expressions
              because it detects an Nx monorepo. Neither is something this repo
              wants applied unattended. <code>upgrade</code> is worse: reading
              its source (not executed, by design) shows <code>--dry-run</code>
              only gates the package.json version bump and the automigration
              writes — <code>packageManager.installDependencies()</code> runs
              unconditionally in its control flow regardless of
              <code>--dry-run</code>, so even the "check-only" flag can touch
              <code>package-lock.json</code> and <code>node_modules</code>.
            </p>
          </div>
        </div>

        <!-- Step 06 -->
        <div class="docs-step-row">
          <span class="docs-step-badge">06</span>
          <div class="docs-step-body">
            <h3 class="docs-h3" id="manifest-shortcut">
              The question that matters most: is there a cheaper path to
              <code>components.json</code>?
            </h3>
            <p class="docs-step-desc">
              <code>check:storybook-manifests</code> runs a full
              <code>nx build-storybook</code> for all three frameworks before it
              checks anything, which is why it's one of the slower gates. Four
              candidate shortcuts, each tried directly against this repo — the
              answer is <strong>no</strong>, with evidence:
            </p>
            <table class="docs-props-table">
              <thead>
                <tr>
                  <th>Candidate</th>
                  <th>Result</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>storybook index</code></td>
                  <td>
                    Reads its implementation (<code>build-index.ts</code>):
                    calls
                    <code
                      >presets.apply('stories'/'docs'/'features'/'experimental_indexers')</code
                    >
                    and nothing that touches manifests. Produces
                    <code>index.json</code> — a story index, not component
                    docgen. Structurally cannot produce
                    <code>components.json</code>.
                  </td>
                </tr>
                <tr>
                  <td>
                    <code>storybook build --preview-only</code> (skips the
                    manager UI shell)
                  </td>
                  <td>
                    Produces a <code>manifests/components.json</code> of
                    identical size (255,350 bytes, both runs, same component
                    count) at a measured
                    <strong>~11.8s vs ~11.6s for Angular</strong> and ~6.9s vs
                    ~6.0s for React — noise-level, not a real win, because the
                    manager UI was never the expensive part; the docgen-heavy
                    preview compile still runs in full. (The flag's actual
                    documented purpose is an iframe-only preview for unsupported
                    browsers, not build speed — repurposing it bought nothing
                    here anyway.)
                  </td>
                </tr>
                <tr>
                  <td>
                    <code>storybook tools --config-dir … docs list</code> (no
                    build, no server)
                  </td>
                  <td>
                    For <strong>React</strong>: real inline
                    <code>reactDocgen</code> props per component, in ~seconds.
                    For <strong>Angular</strong>: every component comes back as
                    <code>id</code>/<code>name</code> only — no docgen, no
                    <code>$ref</code> — the exact "decoy" shape
                    <code>check-manifests.js</code>'s own <code>[DECOY]</code>
                    check exists to catch. <code>experimentalDocgenServer</code>
                    (Angular, Vue) needs the real build or a running dev server;
                    the static CLI path can't produce it.
                  </td>
                </tr>
                <tr>
                  <td>
                    Local dev server (<code>nx storybook &lt;fw&gt;</code>)
                    instead of a build
                  </td>
                  <td>
                    Doesn't write a static file either way:
                    <code>registerManifests()</code> explicitly 404s the
                    <code>components</code>/<code>docs</code> routes in dev when
                    docgen-server mode is on (Angular, Vue) — by design, per the
                    installed source. React's dev route would serve it live, but
                    not to a file <code>check-manifests.js</code> could read,
                    and the gate needs all three frameworks.
                  </td>
                </tr>
              </tbody>
            </table>
            <p class="docs-step-desc" style="margin-top: 0.75rem">
              Since the gate is uniform across all three frameworks and the two
              that matter most (Angular, Vue) have no shortcut, the existing
              mitigation — Nx caching <code>build-storybook</code>'s declared
              outputs, so a rerun with no source change is fast — stays the
              right answer. Fragmenting the gate to fast-path React alone would
              trade a real, if partial, speedup for a gate that no longer checks
              all three the same way.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Testing section -->
    <div>
      <h2 id="what-tests-prove" class="docs-section-title">
        What a green test proves
      </h2>
      <p
        style="
          margin: 0 0 1.75rem;
          color: var(--ui-color-text-muted);
          line-height: 1.65;
        "
      >
        Every story is a test: <code>check:stories</code> renders each one in
        Chromium, runs its <code>play</code> function, and runs axe. That is a
        floor, not a verdict. A course demo on the same problem (a tooltip
        trigger whose tests were "just structural", checking that props were
        present, until an agent wrote 24 behavioural ones) ended on the same
        warning this page ends on: go beyond green checkmarks, because they are
        not proof by themselves. What follows reads one Atelier component the
        way that demo read its own, and counts.
      </p>

      <div class="docs-step-list">
        <div class="docs-step-row">
          <span class="docs-step-badge">01</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">Structural versus behavioural</h3>
            <p class="docs-step-desc">
              A <strong>structural</strong> test asserts that something is
              there: it renders, it has the class, the role, the attribute. A
              <strong>behavioural</strong> test drives the component the way a
              user would (hover, Tab, Esc, click) and asserts what changed. The
              difference shows when someone breaks the component: a structural
              test keeps passing while the feature is gone. Axe is structural in
              this sense too. It audits the DOM that rendered; it never presses
              a key.
            </p>
          </div>
        </div>

        <div class="docs-step-row">
          <span class="docs-step-badge">02</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">Worked example: AtlTooltip</h3>
            <p class="docs-step-desc">
              Read from
              <code>libs/{'{angular,react,vue}'}/src/lib/tooltip/</code>. The
              unit specs (<code>atl-tooltip.spec.*</code>) hold 22 tests.
              Counted by what each one asserts:
            </p>
            <table class="docs-props-table">
              <thead>
                <tr>
                  <th>Framework</th>
                  <th>Structural (initial state, no interaction)</th>
                  <th>Interaction changes visibility</th>
                  <th>Attribute checked after hover</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Angular</td>
                  <td>3</td>
                  <td>4</td>
                  <td>2</td>
                  <td>9</td>
                </tr>
                <tr>
                  <td>React</td>
                  <td>1</td>
                  <td>3</td>
                  <td>2</td>
                  <td>6</td>
                </tr>
                <tr>
                  <td>Vue</td>
                  <td>1</td>
                  <td>4</td>
                  <td>2</td>
                  <td>7</td>
                </tr>
              </tbody>
            </table>
            <p class="docs-step-desc" style="margin-top: 0.75rem">
              The middle column is the behavioural core: show on hover, hide on
              leave, no show when disabled, plus Angular's empty-text case and
              Vue's keyboard-focus case. The last column is a role, a position
              class or an <code>aria-describedby</code> pointing at the tooltip
              id, checked once the tooltip is open. Those are structural
              assertions that happen to need an interaction to set up. Beside
              the specs, each framework has one a11y snapshot test that compares
              the closed and open accessibility trees against a committed JSON
              file in <code>tools/parity/a11y/</code>.
            </p>
            <p class="docs-step-desc">
              What is <strong>not</strong> tested is the part the course demo
              added. All three implementations handle Escape (Angular's host
              binds <code>keydown.escape</code>, React listens on
              <code>document</code>, Vue's wrapper has an <code>onKeydown</code
              >), and no spec presses it. Focus opening the tooltip is bound in
              all three (<code>focusin</code>, <code>onFocus</code>) but only
              Vue's spec tabs to the trigger. And the tooltip stories carry no
              <code>play</code> function at all (6 Angular, 4 React, 7 Vue
              stories), so for AtlTooltip the story test is render plus axe,
              nothing behavioural. Repo-wide the picture is similar: on
              2026-10-09 fewer than a third of the component story files in each
              framework contained a <code>play</code> function.
            </p>
            <p class="docs-step-desc">
              The gate that would catch this does not, by construction.
              <code>check:behavior</code> demands that every id in
              <code>libs/spec/src/behaviors.json</code> is bound with
              <code>covers('tooltip', '&lt;id&gt;')</code> in all three
              adapters. The tooltip has four ids: hidden initially, show on
              hover, hide on leave, no show when disabled. All four are covered
              everywhere; Escape and keyboard focus are not ids, so nothing asks
              for them. Green here means "the listed behaviours are covered",
              and the list is incomplete. Closing that gap is a spec change (add
              the ids, then the gate forces all three adapters to follow), not a
              stricter gate.
            </p>
          </div>
        </div>

        <div class="docs-step-row">
          <span class="docs-step-badge">03</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">Visual regression: what Atelier has</h3>
            <p class="docs-step-desc">
              <strong>No pixel-diff visual regression.</strong> A search of the
              repo for Chromatic, <code>toHaveScreenshot</code>,
              <code>toMatchImageSnapshot</code>, Percy and committed screenshot
              baselines finds no tooling and no baseline images. The Storybook
              review of 2026-09-14 recorded the choice: Chromatic is not
              installed, and <code>check:paint</code> plus
              <code>figma_check_design_parity</code> cover the ground
              differently. The course made the same call for its own system:
              Chromatic was in place but deliberately not a blocking check while
              the design language was still moving.
            </p>
            <p class="docs-step-desc">
              What covers part of that ground compares rendered CSS against a
              number, not a picture against a picture:
            </p>
            <table class="docs-props-table">
              <thead>
                <tr>
                  <th>Gate</th>
                  <th>What it does</th>
                  <th>What it is not</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>check:paint</code></td>
                  <td>
                    Renders every story of every component that has a contract
                    and a Figma snapshot master, in a real browser against the
                    built Storybooks, and compares computed background and
                    border colour (against the token's resolved value), height,
                    padding, gap, radius, border width, font size and line
                    height to the snapshot row for that variant. Hover and focus
                    rows are checked for fill and stroke only.
                  </td>
                  <td>
                    Not a screenshot diff. It reads computed styles of one probe
                    element per story, so layout between elements, icons,
                    shadows, text wrapping and anything the snapshot does not
                    record are invisible to it. Offline: it reads the committed
                    <code>tools/figma/snapshot.json</code>, not live Figma.
                  </td>
                </tr>
                <tr>
                  <td><code>check:geometry</code></td>
                  <td>
                    Renders every control that claims a
                    <code>--ui-control-height-*</code> token in all three
                    frameworks and asserts the box is the height it claims,
                    measured with the shipped font stack and again with a font
                    that cannot resolve.
                  </td>
                  <td>
                    One property of one family of controls (heights), not
                    general appearance.
                  </td>
                </tr>
                <tr>
                  <td><code>figma_check_design_parity</code></td>
                  <td>
                    The live Figma comparison from the design-to-code loop:
                    padding, colour and variant drift against the master.
                  </td>
                  <td>
                    A manual step in the workflow, not part of
                    <code>check:all</code>, and likewise not pixel-based.
                  </td>
                </tr>
              </tbody>
            </table>
            <p class="docs-step-desc" style="margin-top: 0.75rem">
              The gap this leaves is regressions against <em>itself</em>: a
              change that moves a component but still agrees with Figma's
              numbers, or touches a property neither gate reads, is not caught
              by any gate. Whether to add a per-story screenshot diff, and
              whether it should block, is an open decision, not a missing
              feature; <code>tasks/spec-rethink-2026-09-10.md</code> rates it
              flaky and baseline-heavy.
            </p>
          </div>
        </div>

        <div class="docs-step-row">
          <span class="docs-step-badge">04</span>
          <div class="docs-step-body">
            <h3 class="docs-h3">Using this in your own system</h3>
            <p class="docs-step-desc">
              Pick one interactive component and list what it does when a user
              presses keys, not what it renders. Check that each line has a test
              that would fail if the line were deleted. Then ask the agent to
              write the missing ones and read the new tests, not the green
              count: a test that never fails is the same structural check with
              more lines.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

