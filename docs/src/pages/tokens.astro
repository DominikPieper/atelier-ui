];

const typography = [
  {
    name: '--ui-font-size-xs',
    value: '0.75rem',
    px: '12px',
    label: 'xs',
    use: 'Labels, captions, eyebrows',
  },
  {
    name: '--ui-font-size-sm',
    value: '0.875rem',
    px: '14px',
    label: 'sm',
    use: 'Secondary text, table cells',
  },
