const radii = [
  {
    name: '--ui-radius-sm',
    value: '0.5rem',
    px: '8px',
    use: 'Inputs, kbd glyphs, small chips',
  },
  {
    name: '--ui-radius-md',
    value: '0.625rem',
    px: '10px',
    use: 'Default — buttons, badges, cards',
  },
  {
    name: '--ui-radius-lg',
    value: '0.875rem',
    px: '14px',
    use: 'Elevated cards, dialogs, panels',
  },
  {
    name: '--ui-radius-xl',
    value: '1.25rem',
    px: '20px',
    use: 'Hero / showcase surfaces',
