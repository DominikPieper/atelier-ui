const spacing = [
  {
    name: '--ui-spacing-1',
    rem: '0.25rem',
    px: '4px',
    use: 'Icon insets, hairline gaps',
  },
  {
    name: '--ui-spacing-2',
    rem: '0.5rem',
    px: '8px',
    use: 'Tight inline gaps, badge inset',
  },
  {
    name: '--ui-spacing-3',
    rem: '0.75rem',
    px: '12px',
    use: 'Chip padding, button content gap',
  },
  {
    name: '--ui-spacing-4',
    rem: '1rem',
    px: '16px',
    use: 'Default body gap, form-field spacing',
  },
  {
    name: '--ui-spacing-5',
    rem: '1.25rem',
