const motion = [
  {
    name: '--ui-duration-fast',
    value: '150ms',
    use: 'Micro-interactions — hover, focus, press',
  },
  {
    name: '--ui-duration-normal',
    value: '200ms',
    use: 'Standard UI transitions — toggle, expand',
