---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Code } from 'astro-expressive-code/components';
import PageHero from '../components/PageHero.astro';

type Issue = {
  id: string;
  title: string;
  symptom: string;
  cause: string;
  fix: string[];
  codeFix?: string;
  codeLang?: string;
};

const ISSUES: Issue[] = [
  {
    id: 'mcp-unreachable',
    title: 'Storybook MCP server is unreachable',
    symptom:
      'Claude Code says "storybook-angular" (or react/vue) is disconnected, or no component docs are returned.',
    cause:
      'Your network blocks outbound HTTPS to atelier.pieper.io, or the server is temporarily down.',
    fix: [
      'Run `npm run preflight` — it makes a real MCP call against each endpoint and reports what failed.',
      'Test manually with `curl -I https://atelier.pieper.io/storybook-angular/mcp`. You should see a 200 or 405.',
      'If behind a corporate proxy, set `HTTPS_PROXY=http://your-proxy:port` before starting Claude Code.',
    ],
  },
  {
    id: 'mcp-tools-error',
    title: 'MCP connects but every tool errors',
    symptom:
      'Claude Code lists `storybook-angular` (or react/vue) as connected, but every tool call — even `docs-list` — returns an error like "Failed to fetch manifest components.json: 522".',
    cause:
      'The endpoint answers HTTP, but the MCP server behind it is broken — "connected" only proves the URL responds, not that tools work. This is a server-side fault, not your setup.',
    fix: [
      "Run `npm run preflight` — its MCP check issues a real JSON-RPC `tools/list` plus one actual tool call per Storybook endpoint, so this failure shows up as a red `MCP:` row with the server's error text instead of a green check.",
      'Verify manually: `curl -X POST -H "content-type: application/json" -H "accept: application/json, text/event-stream" -d \'{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}\' https://atelier.pieper.io/storybook-react/mcp` — a healthy server answers with a tool list.',
      'If it persists, the server needs a redeploy — nothing to fix on your machine. The framework pages on this site document the same component API in the meantime.',
    ],
  },
  {
    id: 'mcp-not-loaded',
    title: 'Claude Code does not pick up the MCP config',
    symptom:
      'The MCP servers are not listed in Claude Code, even though `.mcp.json` exists.',
    cause:
      'Claude Code was started before `.mcp.json` existed, or the workspace is opened above the project root.',
    fix: [
      'Close and reopen the project in Claude Code from the directory containing `.mcp.json`.',
      'Check that `.mcp.json` is at the workspace root (not inside an app folder).',
      'In a terminal (outside a session), run `claude doctor` to check your install; inside a session, `/mcp` lists the servers Claude Code discovered.',
    ],
  },
  {
    id: 'figma-403',
    title: 'Figma REST returns 403 / invalid token',
    symptom:
      'REST-backed tools (file / variable / comment metadata reads) fail with "Forbidden" or "Invalid token". Interactive plugin tools still work.',
    cause:
      '`FIGMA_ACCESS_TOKEN` is missing, expired, or does not have access to the target file. Only REST calls use it — the Desktop Bridge plugin does not.',
    fix: [
      'Verify the env var: `echo $FIGMA_ACCESS_TOKEN` (macOS/Linux) or `$env:FIGMA_ACCESS_TOKEN` (PowerShell).',
      'Confirm `.mcp.json` passes the token through — either inline or via `"FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN:-}"`. A bare shell export is not enough.',
      'Regenerate at https://www.figma.com/developers/api#access-tokens — scope: File content read.',
      'Make sure you are a member of the Figma team that owns the file, or use the public workshop demo file.',
    ],
  },
  {
    id: 'figma-bridge-plugin-not-connected',
    title: 'figma-console tools fail with "bridge not connected"',
    symptom:
      '`figma_take_screenshot`, `figma_get_selection`, or `figma_execute` return "no active bridge" or time out. The MCP is loaded in Claude Code but has no Figma channel.',
    cause:
      'The Desktop Bridge plugin is either not imported into Figma Desktop, not running, or cannot find the MCP on ports 9223–9232.',
    fix: [
      'Open Figma Desktop and run **Plugins → Development → Figma Desktop Bridge**. Leave the panel open while you work.',
      'If the plugin is missing from Development: re-run `npx -y figma-console-mcp@1.40.0 --help` to seed `~/.figma-console-mcp/plugin/`, then **Plugins → Development → Import plugin from manifest…** and pick that `manifest.json`. Keep the version identical to the pin in the `.mcp.json` of your workspace — the plugin files are seeded by whichever version runs.',
      'Restart Claude Code so the MCP re-claims a WebSocket port — the plugin scans 9223–9232 on open.',
    ],
  },
  {
    id: 'plugin-update',
    title: 'Figma Desktop Bridge plugin is out of date',
    symptom:
      '`npm run preflight` warns that the plugin files are stale, or `figma_get_status` reports `pluginUpdateAvailable: true` for the connected file.',
    cause:
      '"The plugin" is two things and only one refreshes itself. Every time the figma-console MCP starts it copies `manifest.json`, `code.js` and `ui.html` into `~/.figma-console-mcp/plugin/`. But Figma Desktop only reads those files when you run the plugin, so an already-open panel keeps running whatever it loaded last.',
    fix: [
      'Refresh the files: `npx -y figma-console-mcp@<version in your .mcp.json> --help` (or simply start Claude Code once — every server start rewrites them).',
      'Code or UI changed, `manifest.json` did not: close the panel and re-run **Plugins → Development → Figma Desktop Bridge** (or restart Figma Desktop). No re-import needed.',
      '`manifest.json` itself changed (port range, permissions): re-import via **Plugins → Development → Import plugin from manifest…** and pick `~/.figma-console-mcp/plugin/manifest.json` again. Figma does not document whether a plain restart picks up manifest changes, so re-importing is the safe default.',
      'Verify: call `figma_get_status` — `pluginUpdateAvailable` absent or `false` means Figma now runs what is on disk. (`.version` and `bundledPluginVersion` are different counters by design; only the per-file `pluginVersion` shows what is loaded right now.)',
    ],
  },
  {
    id: 'stale-instances',
    title: 'Stale figma-console servers compete for the Bridge',
    symptom:
      'The figma-console tools disconnect mid-session, or `figma_get_status` lists `otherInstances` on ports in 9223–9232 while the Desktop Bridge panel is connected to none of the ones you expect.',
    cause:
      'Every launch of figma-console-mcp (a Claude Code session, a subagent, a background loop) starts its own server on a port in 9223–9232. Figma Desktop runs exactly one Bridge plugin and it connects to exactly one of them; the rest are orphaned but keep listening.',
    codeFix: `pkill -f figma-console-mcp`,
    codeLang: 'shell',
    fix: [
      'Run the command below. It matches by process name, so it also stops the server your current session uses — safe, since Claude Code starts a fresh one on the next tool call, but worth a beat if you are mid-task.',
      'Re-run the plugin in Figma Desktop if the panel still says "searching…" afterwards.',
      'Prevention: run bulk or background Figma work (eval loops, several headless sessions) alone, after every other Figma-dependent task in the session has finished.',
    ],
  },
  {
    id: 'figma-bridge-port-conflict',
    title: 'Every port 9223–9232 is already in use',
    symptom:
      'figma-console MCP starts, but the Desktop Bridge panel stays on "searching…" indefinitely.',
    cause:
      'The WebSocket port range 9223–9232 is fully occupied by unrelated processes, so the MCP cannot bind.',
    codeFix: `# macOS / Linux — see who is on 9223\nlsof -nP -iTCP:9223 -sTCP:LISTEN\n\n# Free up 9223–9232 — only after you have checked what those PIDs are\nfor p in 9223 9224 9225 9226 9227 9228 9229 9230 9231 9232; do\n  lsof -ti :$p | xargs -r kill\ndone`,
    codeLang: 'shell',
    fix: [
      '**Do not blindly kill what is listening** — the loop above terminates every process on those ports, including your editor or another MCP. Check the PIDs first.',
      'Find the offender with `lsof -nP -iTCP:9223 -sTCP:LISTEN` (repeat for each port).',
      'Close unrelated processes, or restart your machine if the range is wedged.',
      'Windows: `netstat -ano | findstr 9223` then `taskkill /PID <pid> /F`.',
    ],
  },
  {
    id: 'figma-mcp-apps-not-supported',
    title: 'Token Browser / Design System Dashboard missing',
    symptom:
      '`ENABLE_MCP_APPS=true` is set, but the interactive MCP Apps UI (Token Browser, Design System Dashboard) never appears.',
    cause:
      'Your MCP client does not implement the `ext-apps` protocol that those rich UIs require. Core tools still work.',
    fix: [
      'Use a client with `ext-apps` support (recent Claude Code builds qualify — run `claude --version` and upgrade if needed).',
      'Confirm the env var is actually reaching the child: add a `"LOG_LEVEL": "debug"` entry next to `ENABLE_MCP_APPS` and check the MCP startup line.',
      'If you only need the CLI tools (screenshots, selection, variable edits), you can safely drop `ENABLE_MCP_APPS`.',
    ],
  },
  {
    id: 'claude-cli-not-authenticated',
    title: 'Claude Code CLI installed but not authenticated',
    symptom:
      '`claude --version` prints a version number and `npm run preflight` shows a green "Claude Code CLI" line, but a real prompt fails — an interactive session asks you to sign in, or `claude -p "…"` exits with an authentication error instead of a response.',
    cause:
      '`preflight` only checks that the binary is on `PATH` and answers `--version` — it never sends a request to a model, so it cannot see whether you are logged in or your key is valid. Installed, connected (MCP), and authenticated (model access) are three separate things; a green preflight proves only the first.',
    codeFix: `# Set your own API key (see console setup at docs.claude.com/en/docs/claude-code/setup)\nexport ANTHROPIC_API_KEY=sk-ant-...\n\n# Prove model access — not just installation\nclaude -p "Reply with exactly: PREFLIGHT-OK"`,
    codeLang: 'shell',
    fix: [
      'Get a key from the Anthropic Console and set it: `export ANTHROPIC_API_KEY=sk-ant-...` — persist it in your shell rc file the same way as `FIGMA_ACCESS_TOKEN` (see that entry below).',
      'Have a Claude subscription instead of an API key? Run `claude auth login` and finish the browser sign-in (add `--console` to sign in with API-key billing specifically).',
      'Verify with a real request, not `--version`: `claude -p "Reply with exactly: PREFLIGHT-OK"`. An auth failure surfaces here even when `--version` and `preflight` both looked fine.',
    ],
  },
  {
    id: 'node-too-old',
    title: 'Node.js version too old',
    symptom:
      '`npx create-atelier-ui-workspace` exits with `engines` or `Unsupported engine` errors.',
    cause: 'Atelier requires Node 22.12+ for Angular 22 and Astro 6 support.',
    fix: [
      'Install `nvm` (https://github.com/nvm-sh/nvm) — then `nvm install 22 && nvm use 22`.',
      'Verify with `node --version`. Must report v22.12.0 or newer.',
      'Re-run `npm run preflight` to confirm.',
    ],
  },
  {
    id: 'npx-permission-denied',
    title: 'Permission denied running `npx create-atelier-ui-workspace`',
    symptom:
      '`EACCES` errors during install, or "command not found" for a freshly installed global.',
    cause:
      'npm is trying to write to a system-level directory that your user cannot access.',
    fix: [
      'Avoid `sudo npm install -g`. Instead, point npm at a user-owned prefix: see https://docs.npmjs.com/resolving-eacces-permissions-errors-when-installing-packages-globally.',
      'Or use nvm — it installs Node + npm into your home directory by default.',
      'On Windows, run the terminal as administrator for the first global install.',
    ],
  },
  {
    id: 'nx-project-not-found',
    title: "Cannot find project 'workshop-angular'",
    symptom:
      '`npx nx serve workshop-angular` (or -react / -vue) fails with "Cannot find project" — the target does not exist.',
    cause:
      'You are in a clone of the atelier monorepo, not in a scaffolded workspace. The `workshop-*` apps are written by `create-atelier-ui-workspace`; the monorepo ships the library, the docs site, and the Storybooks instead.',
    codeFix: `# in a clone of the atelier monorepo\nnpx nx serve docs                # the docs site you are reading\nnpx nx storybook angular         # or: react | vue\n\n# in a scaffolded workspace\nnpm start`,
    codeLang: 'shell',
    fix: [
      'Check which environment you are in: `npx nx show projects`. A `workshop-*` entry means scaffold; `angular / react / vue / docs` means clone.',
      'In the monorepo, mount your component under `libs/<fw>/src/lib/…` and view it with `npx nx storybook <fw>` — read the port from the terminal it prints (angular 4400, react 4401, vue 4402) — there is no app to serve it in.',
      'In a scaffolded workspace, the app is at the workspace root (no `apps/` prefix) and serves on port 4200.',
    ],
  },
  {
    id: 'figma-node-id-not-found',
    title: "The Figma node-id doesn't resolve",
    symptom:
      'A `figma_*` call returns null for the node, or the Figma link opens the file and focuses nothing — no error, no selection.',
    cause:
      'The node id is stale (ids are file-specific and change when a frame is recreated), or you are in a duplicate of the file where the copy carries different ids, or the Desktop Bridge is pointed at a different file than the one the id belongs to.',
    fix: [
      'Confirm which file is open: `figma_get_status` reports the connected file key. The workshop frames live in `QMnDD8uZQPldPrlCwZZ58T`.',
      'Re-resolve the node by name instead of by id — `figma_search_components` (masters) or select the frame in Figma and call `figma_get_selection`, which returns the id that is live in your session.',
      'Duplicated a file into your own drafts for Day 2? The ids in the copy are new. Read them from your own file; the ids printed in this documentation refer to the original.',
    ],
  },
  {
    id: 'port-in-use',
    title: 'Port 4200 / 4300 / 4400–4402 / 6006 already in use',
    symptom:
      '`EADDRINUSE` when running `nx serve`, `nx storybook <fw>`, or `storybook` (scaffold).',
    cause: 'A previous dev server process is still running.',
    fix: [
      '**Do not blindly kill what is listening** — `lsof -ti :<port> | xargs kill` terminates whatever process holds that port, which may not be the stale dev server you think (your editor, another MCP). Check the PID first with `lsof -nP -iTCP:<port> -sTCP:LISTEN`.',
      'macOS/Linux: `lsof -ti :<port> | xargs kill` — swap in the port that is stuck, once you have confirmed the PID.',
      'Windows: `netstat -ano | findstr :<port>` → then `taskkill /PID <pid> /F`.',
      'Scaffolded workspace: run the app on a different port with `npm start -- --port 4300` (the `--` forwards the flag through the npm script to the underlying `nx serve`). Its own Storybook is fixed to port 6006 in the generated `project.json` — kill the stuck process rather than reassign, the same as the clone entry below.',
      'Clone: each Storybook already has its own port (angular 4400, react 4401, vue 4402) and docs is 4300 — kill the stuck process rather than reassign, since `.mcp.json` and this documentation both assume those exact numbers.',
    ],
  },
  {
    id: 'figma-token-missing-after-restart',
    title: 'FIGMA_ACCESS_TOKEN vanishes after terminal restart',
    symptom:
      '`echo $FIGMA_ACCESS_TOKEN` is empty in a new shell even though you set it yesterday.',
    cause:
      '`export` only sets the variable for the current shell session — it does not persist. Also: Claude Code reads the env from `.mcp.json`, so even a persistent shell export has no effect unless `.mcp.json` references it via `${FIGMA_ACCESS_TOKEN}`.',
    codeFix: `# macOS (zsh)\necho 'export FIGMA_ACCESS_TOKEN=figd_...' >> ~/.zshrc\nsource ~/.zshrc\n\n# Linux (bash)\necho 'export FIGMA_ACCESS_TOKEN=figd_...' >> ~/.bashrc\nsource ~/.bashrc`,
    codeLang: 'shell',
    fix: [
      'Add the export line to your shell rc file (see snippet below).',
      'In `.mcp.json`, make sure `"FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN:-}"` is under the `figma-console` env block — otherwise the shell value never reaches the MCP.',
      'Windows: use `[Environment]::SetEnvironmentVariable("FIGMA_ACCESS_TOKEN","figd_...","User")` once.',
    ],
  },
  {
    id: 'windows-paths',
    title: 'Windows-specific path / symlink errors',
    symptom:
      '`EPERM`, symlink failures, or mysterious path-too-long errors during `npm install`.',
    cause:
      'Windows has stricter filesystem semantics than macOS/Linux — long paths and symlinks can fail.',
    fix: [
      'Enable long paths: `git config --system core.longpaths true` (admin PowerShell).',
      'Prefer WSL2 for Node.js work — run everything inside a WSL2 Ubuntu shell.',
      'If WSL is not an option, keep the workspace directory shallow (e.g. `C:\\dev\\my-workshop` instead of deeply nested).',
    ],
  },
];
---

<BaseLayout
  title="Troubleshooting"
  description="Fixes for common Atelier setup issues — MCP servers, Figma tokens, Storybook wiring, and AI-assisted workflow gotchas."
  currentPath="/troubleshooting"
>
  <div class="docs-inline-page">
    <PageHero title="Troubleshooting" ledeMax="640px">
      The most common issues when setting up the Atelier workshop — symptom,
      cause, and a fix in three steps or less. Start with
      <code>npm run preflight</code>; it flags most of these automatically.
    </PageHero>

    <div style="display: flex; flex-direction: column; gap: 1.5rem">
      {ISSUES.map((issue) => <section
        id={issue.id}
        style="
          padding: 1.25rem 1.4rem;
          background: var(--ui-color-surface-raised);
          border: 1px solid var(--ui-color-border);
          border-radius: var(--ui-radius-md);
        "
      >
        <h2
          style="
            margin: 0 0 0.75rem;
            font-size: 1rem;
            font-weight: 700;
            color: var(--ui-color-text);
          "
        >
          {issue.title}
        </h2>
        <div
          style="
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 0.5rem;
            font-size: var(--ui-font-size-md);
            line-height: 1.6;
            overflow-wrap: anywhere;
          "
        >
          <div>
            <span
              style="
                font-size: var(--ui-font-size-xs);
                font-weight: 700;
                color: var(--ui-color-text-muted);
                text-transform: uppercase;
                letter-spacing: 0.06em;
                margin-right: 0.4rem;
              "
              >Symptom</span
            >
            <span style="color: var(--ui-color-text)">{issue.symptom}</span>
          </div>
          <div>
            <span
              style="
                font-size: var(--ui-font-size-xs);
                font-weight: 700;
                color: var(--ui-color-text-muted);
                text-transform: uppercase;
                letter-spacing: 0.06em;
                margin-right: 0.4rem;
              "
              >Cause</span
            >
            <span style="color: var(--ui-color-text)">{issue.cause}</span>
          </div>
          <div>
            <div
              style="
                font-size: var(--ui-font-size-xs);
                font-weight: 700;
                color: var(--ui-color-text-muted);
                text-transform: uppercase;
                letter-spacing: 0.06em;
                margin-bottom: 0.4rem;
              "
            >
              Fix
            </div>
            <ol
              style="
                margin: 0;
                padding-left: 1.2rem;
                color: var(--ui-color-text);
              "
            >
              {issue.fix.map((step) => <li style="margin-bottom: 0.25rem">
                {step}
              </li>)}
            </ol>
          </div>
          {issue.codeFix && <div style="margin-top: 0.5rem">
            <Code code={issue.codeFix} lang={issue.codeLang ?? 'shell'} />
          </div>}
        </div>
      </section>)}
    </div>

    <div
      style="
        margin-top: 2rem;
        padding: 1rem 1.25rem;
        background: var(--ui-color-primary-light);
        border: 1px solid var(--ui-color-border);
        border-radius: var(--ui-radius-md);
      "
    >
      <p
        style="
          margin: 0;
          font-size: var(--ui-font-size-md);
          color: var(--ui-color-text);
          line-height: 1.6;
        "
      >
        Still stuck? Run <code>npm run preflight</code> and share its output —
        every line reports a specific fix.
      </p>
    </div>
  </div>
</BaseLayout>
