---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Code } from 'astro-expressive-code/components';
import DiagramFigure from '../components/DiagramFigure.astro';
import Callout from '../components/Callout.astro';
import Jargon from '../components/Jargon.astro';
import HelpFooter from '../components/HelpFooter.astro';
import PageHero from '../components/PageHero.astro';
import TrackNav from '../components/TrackNav.astro';
import Checkpoint from '../components/Checkpoint.astro';
import Icon from '../components/Icon.astro';
import FwSwitcher from '../components/FwSwitcher.astro';

const FRAMEWORKS = ['Angular', 'React', 'Vue'] as const;

// Rendered once per framework so the copied text names the participant's own
// `storybook-<fw>` server — a scaffolded workspace has exactly one storybook
// entry in its .mcp.json, so a hardcoded `storybook-react` is unrunnable for
// two thirds of the room. The panels ride the same [data-fw-panel] switcher as
// the generated output below.
const examplePrompt = (
  fw: string,
) => `I've selected the "Settings / Card" frame in Figma.

1. Use figma-console MCP (figma_get_component_for_development) to read
   the frame's spec — I need the boundVariables and the visual reference.
2. Use storybook-${fw.toLowerCase()} MCP to look up AtlCard, AtlInput, AtlToggle,
   and AtlButton props.
3. Generate the ${fw} component using:
   - The Atelier UI components matched from Storybook
   - The exact token names from boundVariables (they map 1-to-1 to CSS
     custom properties — no conversion needed)`;

const OUTPUT: Record<string, string> = {
  React: `import { AtlCard, AtlInput, AtlToggle, AtlButton } from '@atelier-ui/react';

export function SettingsCard() {
  return (
    <AtlCard
      variant="elevated"
      style={{ padding: 'var(--ui-spacing-6)', display: 'flex', flexDirection: 'column', gap: 'var(--ui-spacing-4)' }}
    >
      <h2 style={{ fontSize: 'var(--ui-font-size-lg)', fontWeight: 600, color: 'var(--ui-color-text)', margin: 0 }}>
        Settings
      </h2>
      <AtlInput label="Name" />
      <AtlInput label="Email" type="email" />
      <AtlToggle checked>Notifications</AtlToggle>
      <div style={{ display: 'flex', justifyContent: 'flex-end' }}>
        <AtlButton variant="primary">Save</AtlButton>
      </div>
    </AtlCard>
  );
}`,

  Angular: `import { Component } from '@angular/core';
import { AtlCard, AtlInput, AtlToggle, AtlButton } from '@atelier-ui/angular';

@Component({
  selector: 'app-settings-card',
  standalone: true,
  imports: [AtlCard, AtlInput, AtlToggle, AtlButton],
  template: \`
    <atl-card variant="elevated" style="padding: var(--ui-spacing-6); display: flex; flex-direction: column; gap: var(--ui-spacing-4)">
      <h2 style="font-size: var(--ui-font-size-lg); font-weight: 600; color: var(--ui-color-text); margin: 0">
        Settings
      </h2>
      <atl-input label="Name" />
      <atl-input label="Email" type="email" />
      <atl-toggle [checked]="true">Notifications</atl-toggle>
      <div style="display: flex; justify-content: flex-end">
        <button atl-button variant="primary">Save</button>
      </div>
    </atl-card>
  \`,
})
export class SettingsCardComponent {}`,

  Vue: `<script setup lang="ts">
import { AtlCard, AtlInput, AtlToggle, AtlButton } from '@atelier-ui/vue';
</script>

<template>
  <AtlCard
    variant="elevated"
    style="padding: var(--ui-spacing-6); display: flex; flex-direction: column; gap: var(--ui-spacing-4)"
  >
    <h2 style="font-size: var(--ui-font-size-lg); font-weight: 600; color: var(--ui-color-text); margin: 0">
      Settings
    </h2>
    <AtlInput label="Name" />
    <AtlInput label="Email" type="email" />
    <AtlToggle :checked="true">Notifications</AtlToggle>
    <div style="display: flex; justify-content: flex-end">
      <AtlButton variant="primary">Save</AtlButton>
    </div>
  </AtlCard>
</template>`,
};

const PARITY_PROMPT = `Run figma_check_design_parity on the settings card node
against the component I just generated. For each discrepancy, say whether the
code, the Figma master or the contract should change, and why. Fix only the
code ones.`;

// Paths, ports, and mount targets mirror the real scaffold: apps generate at
// the workspace root (no apps/ prefix), every framework serves on the default
// port 4200, and each app renders the NxWelcome placeholder until something
// imports the generated component.
const RUN_IT: Record<
  string,
  { path: string; mount: string; cmd: string; port: number; expected: string }
> = {
  React: {
    path: 'workshop-react/src/components/SettingsCard.tsx',
    mount:
      'Import SettingsCard in workshop-react/src/app/app.tsx and replace the <NxWelcome /> placeholder with it.',
    cmd: 'npm start',
    port: 4200,
    expected:
      'A card with two text inputs (Name, Email), a checked Notifications toggle, and a primary "Save" button — surface-raised background, padding from the Figma spacing token.',
  },
  Angular: {
    path: 'workshop-angular/src/app/components/settings-card.component.ts',
    mount:
      'Add SettingsCardComponent to the imports array in workshop-angular/src/app/app.ts and replace <app-nx-welcome> with <app-settings-card> in app.html.',
    cmd: 'npm start',
    port: 4200,
    expected:
      'A card with two text inputs (Name, Email), a checked Notifications toggle, and a primary "Save" button — same surface, padding, and radius as the Figma frame.',
  },
  Vue: {
    path: 'workshop-vue/src/components/SettingsCard.vue',
    mount:
      'Import SettingsCard in workshop-vue/src/views/HomeView.vue and replace the <NxWelcome /> placeholder with it.',
    cmd: 'npm start',
    port: 4200,
    expected:
      'A card with two text inputs (Name, Email), a checked Notifications toggle, and a primary "Save" button — surface-raised background, identical token-driven spacing.',
  },
};

const BOUND_VARS_EXAMPLE = `// What figma_get_component_for_development returns for a card frame:
{
  "name": "Settings / Card",
  "boundVariables": {
    "fills":         [{ "variable": "color/surface-raised" }],  // → --ui-color-surface-raised
    "paddingTop":    { "variable": "spacing/6" },               // → --ui-spacing-6
    "paddingLeft":   { "variable": "spacing/6" },               // → --ui-spacing-6
    "itemSpacing":   { "variable": "spacing/4" },               // → --ui-spacing-4
    "cornerRadius":  { "variable": "radius/xl" }                // → --ui-radius-xl
  },
  "image": "<2x rendered PNG — included automatically>"
}`;
---

<BaseLayout
  title="Figma to code tutorial"
  description="Step-by-step tutorial for turning a Figma component into framework-agnostic Atelier UI code with Claude, Storybook, and the MCP toolchain."
  currentPath="/tutorial"
>
  <div class="docs-inline-page">
    <PageHero time="~30 min" title="Tutorial" ledeMax="520px">
      Use <strong>figma-console MCP</strong> to read a Figma component spec
      directly — design tokens included — then <strong>Storybook MCP</strong> to
      match Atelier UI components, and let Claude Code write token-exact code.
      New to MCP?
      <a href="#what-is-mcp" class="docs-link-primary"
        >What's an MCP, in 30 seconds</a
      >
      is further down.
    </PageHero>
    <p
      style="
        font-size: var(--ui-font-size-sm);
        color: var(--ui-color-text-muted);
        margin: -1.5rem 0 1.5rem;
        max-width: 520px;
        line-height: 1.55;
      "
    >
      This is the guided walk-through, with the reasoning attached. Next you
      will do it again alone in the
      <a
        href="/first-component"
        class="docs-link-primary docs-link-primary--bold"
        >15-min kata</a
      >: the same Settings / Card frame, with no step-by-step guidance.
    </p>

    <!-- Page-pair: this is the MCP-driven path; /figma is the manual variant. -->
    <aside class="docs-pagepair" aria-label="Two ways to go from Figma to code">
      <div class="docs-pagepair-card docs-pagepair-card--here">
        <span class="docs-pagepair-eyebrow">You're here</span>
        <span class="docs-pagepair-title">/tutorial</span>
        <span class="docs-pagepair-desc"
          >MCP-driven — Claude reads
          <Jargon term="boundVariables">boundVariables</Jargon> and Storybook
          props directly. Needs the Workshop setup and the figma-console MCP
          configured first.</span
        >
      </div>
      <div class="docs-pagepair-arrow" aria-hidden="true">·</div>
      <a href="/figma" class="docs-pagepair-card docs-pagepair-card--prev">
        <span class="docs-pagepair-eyebrow">No-MCP variant</span>
        <span class="docs-pagepair-title">/figma →</span>
        <span class="docs-pagepair-desc"
          >Manual workflow — read the inspect panel, copy token names into your
          prompt. No plugin needed.</span
        >
      </a>
    </aside>

    <!-- Learning objectives & assumed knowledge -->
    <div class="objective-box">
      <div class="objective-col">
        <h2 class="objective-heading objective-heading--accent">
          What you'll learn
        </h2>
        <ul class="objective-list">
          <li>Read a Figma component's <code>boundVariables</code> via MCP</li>
          <li>
            Match the right Atelier UI component through the Storybook MCP
          </li>
          <li>Generate token-exact code in Angular, React or Vue</li>
          <li>Verify design parity automatically</li>
        </ul>
      </div>
      <div class="objective-col">
        <h2 class="objective-heading">Before you start</h2>
        <ul class="objective-list objective-list--muted">
          <li>
            Completed the
            <a href="/workshop" class="docs-link-primary">Workshop setup</a>
          </li>
          <li>
            Read the four-step loop on
            <a href="/design-to-code" class="docs-link-primary"
              >Design to code</a
            >
            — this page walks it in detail
          </li>
          <li>
            <code>figma-console</code> MCP configured — see
            <a href="/figma-token" class="docs-link-primary">Figma Setup</a>
          </li>
          <li>Read access to the Atelier UI Figma file (linked below)</li>
          <li>One framework picked — Angular, React or Vue</li>
        </ul>
      </div>
    </div>

    <!-- Why this is different — concrete cost of doing it the old way -->
    <div
      class="mcp-compare"
      aria-label="Cost of building a component with vs. without MCP"
    >
      <div class="mcp-compare-card mcp-compare-card--neg">
        <div class="mcp-compare-head">
          <span class="mcp-compare-label">Without MCP</span>
          <span class="mcp-compare-time">~12 min</span>
        </div>
        <ol class="mcp-compare-list">
          <li>Open Figma · click the frame</li>
          <li>Read the inspect panel by hand</li>
          <li>Note color tokens · copy by hand</li>
          <li>Note spacing &amp; radius tokens</li>
          <li>Switch to the Storybook tab</li>
          <li>Find the right component</li>
          <li>Read prop docs &amp; variants</li>
          <li>Type the code · risk drift</li>
          <li>Manually verify against the design</li>
        </ol>
        <p class="mcp-compare-foot">Drift risk at every step.</p>
      </div>
      <div class="mcp-compare-card mcp-compare-card--pos">
        <div class="mcp-compare-head">
          <span class="mcp-compare-label">With MCP</span>
          <span class="mcp-compare-time">~90 sec</span>
        </div>
        <ol class="mcp-compare-list">
          <li>Copy the node-id from the Figma URL</li>
          <li>Send one prompt to Claude Code</li>
        </ol>
        {FRAMEWORKS.map((fw, i) => <div data-fw-panel={fw} hidden={i !== 0}>
          <pre
            class="mcp-compare-prompt"
          >{`"build component for node-id 936-2954 using figma-console + storybook-${fw.toLowerCase()} MCP."`}</pre>
        </div>)}
        <ol class="mcp-compare-list" start="3">
          <li>Token-exact code lands</li>
          <li>Verify: <code>figma_check_design_parity</code></li>
        </ol>
        <p class="mcp-compare-foot">Single source of truth · no drift.</p>
      </div>
    </div>

    <!-- What's an MCP? — mental model before specifics -->
    <div class="docs-section">
      <h2 class="docs-section-title" id="what-is-mcp">
        What's an MCP, in 30 seconds?
      </h2>
      <p
        style="
          color: var(--ui-color-text-muted);
          line-height: 1.6;
          margin-bottom: 1.25rem;
        "
      >
        Claude Code can call functions exposed by an external
        <strong style="color: var(--ui-color-text)">MCP server</strong>. The
        server fetches structured data from a source (Figma, Storybook, Nx) and
        hands it back — no screenshots, no copy-paste, no prompt-stuffing. Each
        call is one of four hops:
      </p>

      <DiagramFigure
        caption="Each MCP call is a four-hop round trip. The dashed return arrows carry the data Claude needs — boundVariables for figma-console, prop tables for storybook-*."
      >
        <svg
          viewBox="0 0 880 226"
          role="img"
          aria-labelledby="mcp-title mcp-desc"
          preserveAspectRatio="xMidYMid meet"
        >
          <title id="mcp-title">MCP request and response flow</title>
          <desc id="mcp-desc">
            Four boxes left to right: User, Claude Code, MCP Server, Source.
            Solid arrows show the forward request flow (prompt, tool call,
            fetch). Dashed arrows show the return response flow (data, response,
            answer). Claude Code is highlighted as the active agent making the
            tool decision.
          </desc>

          <defs>
            <marker
              id="mcp-arr"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto"
            >
              <path d="M 0 0 L 10 5 L 0 10 z" class="diagram-arrow--accent" />
            </marker>
            <marker
              id="mcp-arr-back"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto"
            >
              <path
                d="M 0 0 L 10 5 L 0 10 z"
                class="diagram-arrow--muted-accent"
              />
            </marker>
          </defs>

          <!-- Nodes -->
          <rect
            x="8"
            y="60"
            width="144"
            height="100"
            rx="12"
            ry="12"
            class="diagram-node"
          />
          <text
            x="80"
            y="92"
            text-anchor="middle"
            font-size="16"
            font-weight="700"
            >User</text
          >
          <text
            x="80"
            y="116"
            text-anchor="middle"
            font-size="15.5"
            class="diagram-muted"
            >"build this card"</text
          >
          <rect
            x="248"
            y="60"
            width="144"
            height="100"
            rx="12"
            ry="12"
            class="diagram-node diagram-node--accent"
          />
          <text
            x="320"
            y="92"
            text-anchor="middle"
            font-size="16"
            font-weight="700"
            style="fill: var(--ui-color-primary)"
            >Claude Code</text
          >
          <text
            x="320"
            y="116"
            text-anchor="middle"
            font-size="15.5"
            class="diagram-muted"
            >decides which</text
          >
          <text
            x="320"
            y="138"
            text-anchor="middle"
            font-size="15.5"
            class="diagram-muted"
            >tool to call</text
          >
          <rect
            x="488"
            y="60"
            width="144"
            height="100"
            rx="12"
            ry="12"
            class="diagram-node"
          />
          <text
            x="560"
            y="92"
            text-anchor="middle"
            font-size="16"
            font-weight="700"
            >MCP Server</text
          >
          <text
            x="560"
            y="116"
            text-anchor="middle"
            font-size="15.5"
            class="diagram-mono diagram-muted"
            >figma-console</text
          >
          <text
            x="560"
            y="138"
            text-anchor="middle"
            font-size="15.5"
            class="diagram-mono diagram-muted"
            >· storybook-*</text
          >
          <rect
            x="728"
            y="60"
            width="144"
            height="100"
            rx="12"
            ry="12"
            class="diagram-node"
          />
          <text
            x="800"
            y="92"
            text-anchor="middle"
            font-size="16"
            font-weight="700"
            >Source</text
          >
          <text
            x="800"
            y="116"
            text-anchor="middle"
            font-size="15.5"
            class="diagram-muted"
            >Figma ·</text
          >
          <text
            x="800"
            y="138"
            text-anchor="middle"
            font-size="15.5"
            class="diagram-muted"
            >Storybook</text
          >

          <!-- Forward request arrows (top) -->
          <line
            x1="152"
            y1="88"
            x2="248"
            y2="88"
            class="diagram-connector diagram-connector--accent"
            marker-end="url(#mcp-arr)"
          />
          <line
            x1="392"
            y1="88"
            x2="488"
            y2="88"
            class="diagram-connector diagram-connector--accent"
            marker-end="url(#mcp-arr)"
          />
          <line
            x1="632"
            y1="88"
            x2="728"
            y2="88"
            class="diagram-connector diagram-connector--accent"
            marker-end="url(#mcp-arr)"
          />

          <!-- Backward response arrows (bottom, dashed) -->
          <line
            x1="248"
            y1="136"
            x2="152"
            y2="136"
            class="diagram-connector diagram-connector--dashed"
            marker-end="url(#mcp-arr-back)"
          />
          <line
            x1="488"
            y1="136"
            x2="392"
            y2="136"
            class="diagram-connector diagram-connector--dashed"
            marker-end="url(#mcp-arr-back)"
          />
          <line
            x1="728"
            y1="136"
            x2="632"
            y2="136"
            class="diagram-connector diagram-connector--dashed"
            marker-end="url(#mcp-arr-back)"
          />

          <!-- Connector labels -->
          <text
            x="200"
            y="78"
            text-anchor="middle"
            font-size="15.5"
            style="letter-spacing: 0; text-transform: none"
            class="diagram-eyebrow"
            >prompt</text
          >
          <text
            x="440"
            y="78"
            text-anchor="middle"
            font-size="15.5"
            style="letter-spacing: 0; text-transform: none"
            class="diagram-eyebrow"
            >tool call</text
          >
          <text
            x="680"
            y="78"
            text-anchor="middle"
            font-size="15.5"
            style="letter-spacing: 0; text-transform: none"
            class="diagram-eyebrow"
            >fetch</text
          >
          <text
            x="200"
            y="158"
            text-anchor="middle"
            font-size="15.5"
            style="letter-spacing: 0; text-transform: none"
            class="diagram-eyebrow diagram-muted"
            >answer</text
          >
          <text
            x="440"
            y="158"
            text-anchor="middle"
            font-size="15.5"
            style="letter-spacing: 0; text-transform: none"
            class="diagram-eyebrow diagram-muted"
            >response</text
          >
          <text
            x="680"
            y="158"
            text-anchor="middle"
            font-size="15.5"
            style="letter-spacing: 0; text-transform: none"
            class="diagram-eyebrow diagram-muted"
            >data</text
          >

          <!-- Footer banner -->
          <text
            x="440"
            y="206"
            text-anchor="middle"
            font-size="15.5"
            class="diagram-muted"
            >No screenshots · no copy-paste · structured data only</text
          >
        </svg>
      </DiagramFigure>

      <p
        style="
          color: var(--ui-color-text-muted);
          line-height: 1.6;
          margin-top: 1rem;
        "
      >
        This tutorial uses two MCP servers: <code>figma-console</code> (reads
        Figma component frames) and one of the <code>storybook-*</code> servers
        (returns Atelier UI component prop documentation). The next section
        walks the figma-console tools you'll use.
      </p>
    </div>

    <!-- What figma-console MCP provides -->
    <div class="docs-section">
      <h2 class="docs-section-title">What figma-console MCP provides</h2>
      <p
        style="
          color: var(--ui-color-text-muted);
          line-height: 1.6;
          margin-bottom: 1.25rem;
        "
      >
        The key tool is <code>figma_get_component_for_development</code>. Given
        a node-id it returns:
      </p>
      <div
        style="
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
          gap: 0.75rem;
          margin-bottom: 1.25rem;
        "
      >
        {[
          {
            title: 'boundVariables',
            body: 'Each CSS property mapped to its Figma variable name — identical to the CSS custom property name in Atelier UI. No conversion needed.',
          },
          {
            title: '2× rendered image',
            body: 'A screenshot of the component, included automatically. AI gets visual and structural context in a single call.',
          },
          {
            title: 'Component tree',
            body: 'Full layout structure: padding, gap, constraints, text behaviour, and interaction states (reactions).',
          },
        ].map(({ title, body }) => <div
          style="
            padding: 0.9rem 1rem;
            background: var(--ui-color-surface-raised);
            border-radius: var(--ui-radius-md);
            border: 1px solid var(--ui-color-border);
          "
        >
          <div
            style="
              font-family: monospace;
              font-size: 0.78rem;
              font-weight: 700;
              color: var(--ui-color-primary);
              margin-bottom: 0.35rem;
            "
          >
            {title}
          </div>
          <div
            style="
              font-size: var(--ui-font-size-md);
              color: var(--ui-color-text-muted);
              line-height: 1.6;
            "
          >
            {body}
          </div>
        </div>)}
      </div>
      <Code
        code={BOUND_VARS_EXAMPLE}
        lang="js"
        title="figma_get_component_for_development — response shape"
      />
    </div>

    <!-- The workflow -->
    <div class="docs-section">
      <h2 class="docs-section-title">The workflow</h2>

      <DiagramFigure
        caption="Each step passes concrete data to the next. The dashed arrow closes the loop when parity checks surface discrepancies."
      >
        <svg
          viewBox="0 0 960 272"
          role="img"
          aria-labelledby="tut-title tut-desc"
          preserveAspectRatio="xMidYMid meet"
        >
          <title id="tut-title">Figma-to-code sequence diagram</title>
          <desc id="tut-desc">
            Four stages from inspecting a frame in Figma to verifying design
            parity: Inspect, Contract, Generate, Verify. Data flows from left to
            right: node-id, boundVariables, generated code, parity score. A
            dashed loop returns discrepancies to Inspect.
          </desc>

          <defs>
            <marker
              id="tut-arrow"
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="6"
              markerHeight="6"
              orient="auto-start-reverse"
            >
              <path d="M 0 0 L 10 5 L 0 10 z" class="diagram-arrow" />
            </marker>
            <marker
              id="tut-arrow-loop"
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto-start-reverse"
            >
              <path
                d="M 0 0 L 10 5 L 0 10 z"
                class="diagram-arrow--muted-accent"
              />
            </marker>
          </defs>

          <!-- Connector line under the stage circles -->
          <line
            x1="98"
            y1="100"
            x2="228"
            y2="100"
            class="diagram-connector"
            marker-end="url(#tut-arrow)"
          />
          <line
            x1="288"
            y1="100"
            x2="418"
            y2="100"
            class="diagram-connector"
            marker-end="url(#tut-arrow)"
          />
          <line
            x1="478"
            y1="100"
            x2="608"
            y2="100"
            class="diagram-connector"
