import {
  ChangeDetectionStrategy,
  Component,
  input,
  model,
} from '@angular/core';

export interface SwitcherOption {
  value: string;
  label: string;
  /** Small secondary text after the label, such as a count. */
  hint?: string;
}

/**
 * A row of options of which exactly one is selected.
 *
 * ```html
 * <app-switcher [options]="options" [(value)]="view" />
 * ```
 */
@Component({
  selector: 'app-switcher',
  changeDetection: ChangeDetectionStrategy.OnPush,
  styleUrl: './switcher.component.css',
  template: `
    <div class="switcher" role="group" aria-label="View">
      @for (option of options(); track option.value) {
        <button
          type="button"
          class="switcher-option"
          [class.switcher-selected]="option.value === value()"
          [attr.aria-pressed]="option.value === value()"
          (click)="value.set(option.value)"
        >
          {{ option.label }}
          @if (option.hint) {
            <span class="switcher-hint">{{ option.hint }}</span>
          }
        </button>
      }
    </div>
  `,
})
export class SwitcherComponent {
  /** The options, in display order. */
  readonly options = input<SwitcherOption[]>([]);
  /** The `value` of the selected option. */
  readonly value = model('');
}
