{
  "name": "@atelier-ui/mcp",
  "version": "0.4.10",
  "description": "MCP server for consumers of @atelier-ui/angular: answers docs-list, docs-show and docs-show-story over stdio from a manifest snapshot built from the same commit, with no network access.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "atelier-mcp": "bin/atelier-mcp.mjs"
  },
  "files": [
    "bin",
    "src",
    "snapshot",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@storybook/mcp": "10.6.0",
    "@tmcp/adapter-valibot": "^0.1.5",
    "@tmcp/transport-stdio": "0.5.0",
    "tmcp": "^1.19.4",
    "valibot": "^1.4.0"
  },
  "scripts": {
    "build": "node scripts/build-snapshot.mjs",
    "prepack": "node scripts/prepack.mjs",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "design-system",
    "atelier-ui",
    "angular",
    "storybook"
  ]
}
